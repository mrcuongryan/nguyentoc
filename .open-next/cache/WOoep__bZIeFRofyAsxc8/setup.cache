{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/setup/layout,_N_T_/setup/page,_N_T_/setup"},"segmentPaths":["/_tree","/_full","/setup/__PAGE__","/setup","/_index","/_head"]},"html":"<!DOCTYPE html><html lang=\"vi\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/14e23f9b59180572-s.p.08.c8psu~gif9.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/2a65768255d6b625-s.p.14by5b4al-y~f.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/2bbe8d2671613f1f-s.p.067x_6k0k23tk.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/83afe278b6a6bb3c-s.p.0q-301v4kxxnr.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/0qa855wvp2uv9.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/0xc7eu11bieu_.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/0yb2wil16uz6h.js\"/><script src=\"/_next/static/chunks/10qd__0r7a~.l.js\" async=\"\"></script><script src=\"/_next/static/chunks/0ygn12t6isi31.js\" async=\"\"></script><script src=\"/_next/static/chunks/0h4bq73pogmtb.js\" async=\"\"></script><script src=\"/_next/static/chunks/0.wiw-_135pal.js\" async=\"\"></script><script src=\"/_next/static/chunks/0pqt~8bl3ukh4.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-05r0zw4wml2d7.js\" async=\"\"></script><script src=\"/_next/static/chunks/01xlw8hd842-c.js\" async=\"\"></script><script src=\"/_next/static/chunks/0d3shmwh5_nmn.js\" async=\"\"></script><script src=\"/_next/static/chunks/10gp4~2wc-iyp.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>Gia Phả OS</title><meta name=\"description\" content=\"Gia Phả OS\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.0cbu-oy3ga.gt.ico\" sizes=\"48x48\" type=\"image/x-icon\"/><script src=\"/_next/static/chunks/03~yq9q893hmn.js\" noModule=\"\"></script></head><body class=\"inter_f20e379b-module__TWS8mW__variable playfair_display_c88dccb7-module__wLnm0q__variable font-sans antialiased relative\"><div hidden=\"\"><!--$--><!--/$--></div><div class=\"min-h-screen flex flex-col bg-[#fafaf9] select-none selection:bg-amber-200 selection:text-amber-900 relative overflow-hidden\"><div class=\"absolute inset-0 bg-[linear-gradient(to_right,#80808008_1px,transparent_1px),linear-gradient(to_bottom,#80808008_1px,transparent_1px)] bg-size-[24px_24px] pointer-events-none\"></div><div class=\"absolute top-0 inset-x-0 h-screen overflow-hidden pointer-events-none flex justify-center\"><div class=\"absolute top-[-10%] right-[-5%] w-[50vw] h-[50vw] max-w-[600px] max-h-[600px] bg-indigo-300/20 rounded-full blur-[100px] mix-blend-multiply\"></div><div class=\"absolute bottom-[0%] left-[-10%] w-[60vw] h-[60vw] max-w-[800px] max-h-[800px] bg-teal-200/20 rounded-full blur-[120px] mix-blend-multiply\"></div></div><div class=\"flex-1 flex flex-col items-center px-4 py-12 relative z-10 w-full max-w-5xl mx-auto\"><div class=\"w-full bg-white p-8 sm:p-10 rounded-3xl shadow-xl border border-stone-200 relative overflow-hidden mb-8\"><div class=\"flex items-center gap-4 mb-6\"><div class=\"p-4 bg-indigo-50 text-indigo-600 rounded-2xl\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-database size-8\" aria-hidden=\"true\"><ellipse cx=\"12\" cy=\"5\" rx=\"9\" ry=\"3\"></ellipse><path d=\"M3 5V19A9 3 0 0 0 21 19V5\"></path><path d=\"M3 12A9 3 0 0 0 21 12\"></path></svg></div><div><h2 class=\"text-2xl sm:text-3xl font-bold text-stone-900 tracking-tight\">Khởi tạo Cơ sở dữ liệu</h2><p class=\"text-stone-500 font-medium\">Hệ thống phát hiện database của bạn chưa được thiết lập cấu trúc bảng (schema).</p></div></div><div class=\"grid grid-cols-1 md:grid-cols-2 gap-8\"><div class=\"space-y-6\"><div class=\"bg-stone-50 border border-stone-200 rounded-2xl p-6 h-full\"><h3 class=\"font-semibold text-stone-900 mb-4 flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-play size-5 text-stone-500\" aria-hidden=\"true\"><path d=\"M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z\"></path></svg>Hướng dẫn thực hiện:</h3><ol class=\"list-decimal list-inside space-y-4 text-stone-600\"><li class=\"leading-relaxed\">Bấm nút<!-- --> <strong class=\"text-indigo-600\">Copy Mã SQL</strong> ở bên dưới để sao chép toàn bộ cấu trúc cơ sở dữ liệu.</li><li class=\"leading-relaxed\">Mở<!-- --> <a href=\"https://supabase.com/dashboard/project/_/sql/new\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-amber-600 font-semibold hover:underline\">Supabase SQL Editor</a> <!-- -->trong dự án của bạn.</li><li class=\"leading-relaxed\"><strong>Dán (Paste)</strong> mã vừa copy vào khung soạn thảo của Supabase.</li><li class=\"leading-relaxed\">Bấm nút <strong>RUN</strong> (Chạy) ở góc phải dưới cùng màn hình Supabase.</li><li class=\"leading-relaxed\">Quay lại đây và <strong>Tải lại trang</strong> (hoặc bấm Đăng nhập lại).</li></ol><div class=\"mt-8\"><div class=\"w-full\"><button class=\"w-full flex items-center justify-center gap-2 py-3 px-6 rounded-xl font-bold transition-all duration-300 shadow-sm bg-indigo-600 hover:bg-indigo-700 text-white hover:shadow-md\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-clipboard-copy size-5\" aria-hidden=\"true\"><rect width=\"8\" height=\"4\" x=\"8\" y=\"2\" rx=\"1\" ry=\"1\"></rect><path d=\"M8 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2\"></path><path d=\"M16 4h2a2 2 0 0 1 2 2v4\"></path><path d=\"M21 14H11\"></path><path d=\"m15 10-4 4 4 4\"></path></svg>Copy Mã SQL</button></div></div></div></div><div class=\"col-span-1 border border-stone-200 rounded-2xl overflow-hidden bg-[#1e1e1e] flex flex-col h-[400px]\"><div class=\"bg-[#2d2d2d] px-4 py-2 flex items-center justify-between border-b border-stone-800\"><span class=\"text-stone-400 text-xs font-mono\">docs/schema.sql</span></div><div class=\"p-4 overflow-y-auto w-full flex-grow custom-scrollbar\"><pre class=\"text-xs sm:text-sm font-mono text-stone-300 leading-relaxed whitespace-pre\"><code>-- ==========================================\r\n-- GIAPHA-OS DATABASE SCHEMA\r\n-- ==========================================\r\n\r\n-- EXTENSIONS\r\nCREATE EXTENSION IF NOT EXISTS pgcrypto WITH SCHEMA extensions;\r\n\r\n-- ENUMS\r\n-- Gender types for family members\r\nDO $$ BEGIN\r\n    CREATE TYPE public.gender_enum AS ENUM (&#x27;male&#x27;, &#x27;female&#x27;, &#x27;other&#x27;);\r\nEXCEPTION\r\n    WHEN duplicate_object THEN null;\r\nEND $$;\r\n\r\n-- Relationship types between family members\r\nDO $$ BEGIN\r\n    CREATE TYPE public.relationship_type_enum AS ENUM (&#x27;marriage&#x27;, &#x27;biological_child&#x27;, &#x27;adopted_child&#x27;);\r\nEXCEPTION\r\n    WHEN duplicate_object THEN null;\r\nEND $$;\r\n\r\n-- System user roles\r\nDO $$ BEGIN\r\n    CREATE TYPE public.user_role_enum AS ENUM (&#x27;admin&#x27;, &#x27;editor&#x27;, &#x27;member&#x27;);\r\nEXCEPTION\r\n    WHEN duplicate_object THEN null;\r\nEND $$;\r\n\r\n-- ==========================================\r\n-- UTILITY FUNCTIONS\r\n-- ==========================================\r\n\r\n-- Function to automatically update &#x27;updated_at&#x27; timestamps\r\nCREATE OR REPLACE FUNCTION public.handle_updated_at()\r\nRETURNS TRIGGER AS $$\r\nBEGIN\r\n  NEW.updated_at = NOW();\r\n  RETURN NEW;\r\nEND;\r\n$$ LANGUAGE plpgsql;\r\n\r\n-- ==========================================\r\n-- TABLES (Data Preservation: No DROP TABLE commands)\r\n-- ==========================================\r\n\r\n-- PROFILES (Application users linked to Auth)\r\nCREATE TABLE IF NOT EXISTS public.profiles (\r\n  id UUID REFERENCES auth.users(id) ON DELETE CASCADE PRIMARY KEY,\r\n  role public.user_role_enum DEFAULT &#x27;member&#x27; NOT NULL,\r\n  is_active BOOLEAN NOT NULL DEFAULT false,\r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW()\r\n);\r\n\r\n-- PERSONS (Core entity for family tree)\r\nCREATE TABLE IF NOT EXISTS public.persons (\r\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\r\n  full_name TEXT NOT NULL,\r\n  gender public.gender_enum NOT NULL,\r\n  \r\n  -- Date components (allows for partial dates where only year is known)\r\n  birth_year INT,\r\n  birth_month INT,\r\n  birth_day INT,\r\n  death_year INT,\r\n  death_month INT,\r\n  death_day INT,\r\n  death_lunar_year INT,\r\n  death_lunar_month INT,\r\n  death_lunar_day INT,\r\n  \r\n  is_deceased BOOLEAN NOT NULL DEFAULT FALSE,\r\n  is_in_law BOOLEAN NOT NULL DEFAULT FALSE,\r\n  birth_order INT,\r\n  generation INT,\r\n  other_names TEXT,\r\n  avatar_url TEXT,\r\n  note TEXT,\r\n  \r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW()\r\n);\r\n\r\n-- PERSON_DETAILS_PRIVATE (Sensitive data with restricted RLS)\r\nCREATE TABLE IF NOT EXISTS public.person_details_private (\r\n  person_id UUID REFERENCES public.persons(id) ON DELETE CASCADE PRIMARY KEY,\r\n  phone_number TEXT,\r\n  occupation TEXT,\r\n  current_residence TEXT,\r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW()\r\n);\r\n\r\n-- RELATIONSHIPS (Links between persons)\r\nCREATE TABLE IF NOT EXISTS public.relationships (\r\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\r\n  type public.relationship_type_enum NOT NULL,\r\n  person_a UUID REFERENCES public.persons(id) ON DELETE CASCADE NOT NULL,\r\n  person_b UUID REFERENCES public.persons(id) ON DELETE CASCADE NOT NULL,\r\n  note TEXT,\r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW(),\r\n  \r\n  -- Prevent self-relationships\r\n  CONSTRAINT no_self_relationship CHECK (person_a != person_b),\r\n  \r\n  -- Ensure unique relationships between pairs for a specific type\r\n  UNIQUE(person_a, person_b, type)\r\n);\r\n\r\n-- CUSTOM_EVENTS (User-created events)\r\nCREATE TABLE IF NOT EXISTS public.custom_events (\r\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\r\n  name TEXT NOT NULL,\r\n  content TEXT,\r\n  event_date DATE NOT NULL,\r\n  location TEXT,\r\n  created_by UUID REFERENCES public.profiles(id) DEFAULT auth.uid(),\r\n  \r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW()\r\n);\r\n\r\n-- ==========================================\r\n-- INDEXES\r\n-- ==========================================\r\n\r\n-- Relationship lookups\r\nCREATE INDEX IF NOT EXISTS idx_relationships_person_a ON public.relationships(person_a);\r\nCREATE INDEX IF NOT EXISTS idx_relationships_person_b ON public.relationships(person_b);\r\nCREATE INDEX IF NOT EXISTS idx_relationships_type ON public.relationships(type);\r\n\r\n-- Person filtering and sorting\r\nCREATE INDEX IF NOT EXISTS idx_persons_full_name ON public.persons(full_name);\r\nCREATE INDEX IF NOT EXISTS idx_persons_generation ON public.persons(generation);\r\nCREATE INDEX IF NOT EXISTS idx_persons_gender ON public.persons(gender);\r\nCREATE INDEX IF NOT EXISTS idx_persons_is_deceased ON public.persons(is_deceased);\r\nCREATE INDEX IF NOT EXISTS idx_persons_birth_year ON public.persons(birth_year);\r\n\r\n-- Profile lookups\r\nCREATE INDEX IF NOT EXISTS idx_profiles_role ON public.profiles(role);\r\nCREATE INDEX IF NOT EXISTS idx_profiles_is_active ON public.profiles(is_active);\r\n\r\n-- Custom events lookups\r\nCREATE INDEX IF NOT EXISTS idx_custom_events_date ON public.custom_events(event_date);\r\nCREATE INDEX IF NOT EXISTS idx_custom_events_created_by ON public.custom_events(created_by);\r\n\r\n-- ==========================================\r\n-- RLS POLICIES\r\n-- ==========================================\r\n\r\nALTER TABLE public.profiles ENABLE ROW LEVEL SECURITY;\r\nALTER TABLE public.persons ENABLE ROW LEVEL SECURITY;\r\nALTER TABLE public.person_details_private ENABLE ROW LEVEL SECURITY;\r\nALTER TABLE public.relationships ENABLE ROW LEVEL SECURITY;\r\n\r\n-- Helper function to check if user is admin\r\nCREATE OR REPLACE FUNCTION public.is_admin()\r\nRETURNS BOOLEAN AS $$\r\nBEGIN\r\n  RETURN EXISTS (\r\n    SELECT 1 FROM public.profiles\r\n    WHERE id = auth.uid() AND role = &#x27;admin&#x27;\r\n  );\r\nEND;\r\n$$ LANGUAGE plpgsql SECURITY DEFINER;\r\n\r\n-- Helper function to check if user is editor\r\nCREATE OR REPLACE FUNCTION PUBLIC.IS_EDITOR()\r\nRETURNS BOOLEAN\r\nLANGUAGE PLPGSQL\r\nSECURITY DEFINER\r\nSET SEARCH_PATH = PUBLIC\r\nAS $$\r\nBEGIN\r\n  RETURN EXISTS (\r\n    SELECT 1 FROM public.profiles\r\n    WHERE id = auth.uid() AND role = &#x27;editor&#x27;\r\n  );\r\nEND;\r\n$$;\r\nrevoke all on function public.is_editor() from public;\r\ngrant execute on function public.is_editor() to authenticated;\r\n\r\n-- PROFILES POLICIES\r\nDROP POLICY IF EXISTS &quot;Users can view own profile&quot; ON public.profiles;\r\nCREATE POLICY &quot;Users can view own profile&quot; ON public.profiles FOR SELECT USING (auth.uid() = id);\r\n\r\nDROP POLICY IF EXISTS &quot;Admins can view all profiles&quot; ON public.profiles;\r\nCREATE POLICY &quot;Admins can view all profiles&quot; ON public.profiles FOR SELECT USING (public.is_admin());\r\n\r\n-- PERSONS POLICIES\r\nDROP POLICY IF EXISTS &quot;Enable read access for authenticated users&quot; ON public.persons;\r\nCREATE POLICY &quot;Enable read access for authenticated users&quot; ON public.persons FOR SELECT TO authenticated USING (true);\r\n\r\nDROP POLICY IF EXISTS &quot;Admins can manage persons&quot; ON public.persons;\r\nDROP POLICY IF EXISTS &quot;Admins can insert persons&quot; ON public.persons;\r\nDROP POLICY IF EXISTS &quot;Admins can update persons&quot; ON public.persons;\r\nDROP POLICY IF EXISTS &quot;Admins can delete persons&quot; ON public.persons;\r\n\r\nCREATE POLICY &quot;Admins and Editors can insert persons&quot; ON public.persons FOR INSERT TO authenticated WITH CHECK (public.is_admin() OR public.is_editor());\r\nCREATE POLICY &quot;Admins and Editors can update persons&quot; ON public.persons FOR UPDATE TO authenticated USING (public.is_admin() OR public.is_editor()) WITH CHECK (public.is_admin() OR public.is_editor());\r\nCREATE POLICY &quot;Admins and Editors can delete persons&quot; ON public.persons FOR DELETE TO authenticated USING (public.is_admin() OR public.is_editor());\r\n\r\n-- PERSON_DETAILS_PRIVATE POLICIES\r\nDROP POLICY IF EXISTS &quot;Admins can view private details&quot; ON public.person_details_private;\r\nCREATE POLICY &quot;Admins can view private details&quot; ON public.person_details_private FOR SELECT TO authenticated USING (public.is_admin());\r\n\r\nDROP POLICY IF EXISTS &quot;Admins can manage private details&quot; ON public.person_details_private;\r\nCREATE POLICY &quot;Admins can manage private details&quot; ON public.person_details_private FOR ALL TO authenticated USING (public.is_admin());\r\n\r\n-- RELATIONSHIPS POLICIES\r\nDROP POLICY IF EXISTS &quot;Enable read access for authenticated users&quot; ON public.relationships;\r\nCREATE POLICY &quot;Enable read access for authenticated users&quot; ON public.relationships FOR SELECT TO authenticated USING (true);\r\n\r\nDROP POLICY IF EXISTS &quot;Admins can manage relationships&quot; ON public.relationships;\r\nDROP POLICY IF EXISTS &quot;Admins can insert relationships&quot; ON public.relationships;\r\nDROP POLICY IF EXISTS &quot;Admins can update relationships&quot; ON public.relationships;\r\nDROP POLICY IF EXISTS &quot;Admins can delete relationships&quot; ON public.relationships;\r\n\r\nCREATE POLICY &quot;Admins and Editors can insert relationships&quot; ON public.relationships FOR INSERT TO authenticated WITH CHECK (public.is_admin() OR public.is_editor());\r\nCREATE POLICY &quot;Admins and Editors can update relationships&quot; ON public.relationships FOR UPDATE TO authenticated USING (public.is_admin() OR public.is_editor()) WITH CHECK (public.is_admin() OR public.is_editor());\r\nCREATE POLICY &quot;Admins and Editors can delete relationships&quot; ON public.relationships FOR DELETE TO authenticated USING (public.is_admin() OR public.is_editor());\r\n\r\n-- CUSTOM_EVENTS POLICIES\r\nALTER TABLE public.custom_events ENABLE ROW LEVEL SECURITY;\r\n\r\nDROP POLICY IF EXISTS &quot;Enable read access for authenticated users&quot; ON public.custom_events;\r\nCREATE POLICY &quot;Enable read access for authenticated users&quot; ON public.custom_events FOR SELECT TO authenticated USING (true);\r\n\r\nDROP POLICY IF EXISTS &quot;Authenticated users can insert custom events&quot; ON public.custom_events;\r\nCREATE POLICY &quot;Authenticated users can insert custom events&quot; ON public.custom_events FOR INSERT TO authenticated WITH CHECK (auth.uid() = created_by);\r\n\r\nDROP POLICY IF EXISTS &quot;Users can update own custom events&quot; ON public.custom_events;\r\nCREATE POLICY &quot;Users can update own custom events&quot; ON public.custom_events FOR UPDATE TO authenticated USING (auth.uid() = created_by OR public.is_admin());\r\n\r\nDROP POLICY IF EXISTS &quot;Users can delete own custom events&quot; ON public.custom_events;\r\nCREATE POLICY &quot;Users can delete own custom events&quot; ON public.custom_events FOR DELETE TO authenticated USING (auth.uid() = created_by OR public.is_admin());\r\n\r\n-- ==========================================\r\n-- TRIGGERS\r\n-- ==========================================\r\n\r\n-- 1. Updated At Triggers\r\nDROP TRIGGER IF EXISTS tr_profiles_updated_at ON public.profiles;\r\nCREATE TRIGGER tr_profiles_updated_at BEFORE UPDATE ON public.profiles FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\nDROP TRIGGER IF EXISTS tr_persons_updated_at ON public.persons;\r\nCREATE TRIGGER tr_persons_updated_at BEFORE UPDATE ON public.persons FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\nDROP TRIGGER IF EXISTS tr_person_details_private_updated_at ON public.person_details_private;\r\nCREATE TRIGGER tr_person_details_private_updated_at BEFORE UPDATE ON public.person_details_private FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\nDROP TRIGGER IF EXISTS tr_relationships_updated_at ON public.relationships;\r\nCREATE TRIGGER tr_relationships_updated_at BEFORE UPDATE ON public.relationships FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\nDROP TRIGGER IF EXISTS tr_custom_events_updated_at ON public.custom_events;\r\nCREATE TRIGGER tr_custom_events_updated_at BEFORE UPDATE ON public.custom_events FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\n-- 2. Handle new user signup (Profile creation)\r\nCREATE OR REPLACE FUNCTION public.handle_new_user()\r\nRETURNS trigger \r\nLANGUAGE plpgsql\r\nSECURITY DEFINER SET search_path = public, auth\r\nAS $$\r\nDECLARE\r\n  is_first_user boolean;\r\nBEGIN\r\n  -- Check if this is the first user (count will be 1 as this is AFTER INSERT)\r\n  SELECT count(*) = 1 FROM auth.users INTO is_first_user;\r\n\r\n  INSERT INTO public.profiles (id, role, is_active)\r\n  VALUES (\r\n    new.id, \r\n    CASE WHEN is_first_user THEN &#x27;admin&#x27;::public.user_role_enum ELSE &#x27;member&#x27;::public.user_role_enum END,\r\n    true\r\n  );\r\n\r\n  UPDATE public.profiles \r\n  SET is_active = true \r\n  WHERE id = new.id AND is_first_user = true;\r\n\r\n  RETURN new;\r\nEND;\r\n$$;\r\n\r\n-- 3. Auto-confirm first user (Email verification)\r\nCREATE OR REPLACE FUNCTION public.handle_first_user_confirmation()\r\nRETURNS trigger\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER SET search_path = auth\r\nAS $$\r\nBEGIN\r\n  -- If no users exist yet, auto-confirm this first one\r\n  IF NOT EXISTS (SELECT 1 FROM auth.users) THEN\r\n    NEW.email_confirmed_at := NOW();\r\n    NEW.last_sign_in_at := NOW();\r\n  END IF;\r\n  RETURN NEW;\r\nEND;\r\n$$;\r\n\r\n-- Trigger for profile creation\r\nDROP TRIGGER IF EXISTS on_auth_user_created ON auth.users;\r\nCREATE TRIGGER on_auth_user_created\r\n  AFTER INSERT ON auth.users\r\n  FOR EACH ROW EXECUTE PROCEDURE public.handle_new_user();\r\n\r\n-- Trigger for auto-confirmation\r\nDROP TRIGGER IF EXISTS on_auth_user_created_confirm ON auth.users;\r\nCREATE TRIGGER on_auth_user_created_confirm\r\n  BEFORE INSERT ON auth.users\r\n  FOR EACH ROW EXECUTE PROCEDURE public.handle_first_user_confirmation();\r\n\r\n-- ==========================================\r\n-- STORAGE POLICIES\r\n-- ==========================================\r\n\r\n-- Initialize &#x27;avatars&#x27; bucket\r\nINSERT INTO storage.buckets (id, name, public) \r\nVALUES (&#x27;avatars&#x27;, &#x27;avatars&#x27;, true) \r\nON CONFLICT (id) DO UPDATE SET public = true;\r\n\r\nDROP POLICY IF EXISTS &quot;Avatar images are publicly accessible.&quot; ON storage.objects;\r\nCREATE POLICY &quot;Avatar images are publicly accessible.&quot; ON storage.objects FOR SELECT USING ( bucket_id = &#x27;avatars&#x27; );\r\n\r\nDROP POLICY IF EXISTS &quot;Users can upload avatars.&quot; ON storage.objects;\r\nCREATE POLICY &quot;Users can upload avatars.&quot; ON storage.objects FOR INSERT WITH CHECK ( bucket_id = &#x27;avatars&#x27; AND auth.role() = &#x27;authenticated&#x27; );\r\n\r\nDROP POLICY IF EXISTS &quot;Users can update avatars.&quot; ON storage.objects;\r\nCREATE POLICY &quot;Users can update avatars.&quot; ON storage.objects FOR UPDATE USING ( bucket_id = &#x27;avatars&#x27; AND auth.role() = &#x27;authenticated&#x27; );\r\n\r\nDROP POLICY IF EXISTS &quot;Users can delete avatars.&quot; ON storage.objects;\r\nCREATE POLICY &quot;Users can delete avatars.&quot; ON storage.objects FOR DELETE USING ( bucket_id = &#x27;avatars&#x27; AND auth.role() = &#x27;authenticated&#x27; );\r\n\r\n-- ==========================================\r\n-- ADMIN RPC FUNCTIONS\r\n-- ==========================================\r\n\r\n-- Custom type for get_admin_users\r\nDROP TYPE IF EXISTS public.admin_user_data CASCADE;\r\nCREATE TYPE public.admin_user_data AS (\r\n    id uuid,\r\n    email text,\r\n    role public.user_role_enum,\r\n    created_at timestamptz,\r\n    is_active boolean\r\n);\r\n\r\n-- 1. Get List of Users for Admin\r\nCREATE OR REPLACE FUNCTION public.get_admin_users()\r\nRETURNS SETOF public.admin_user_data\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER\r\nSET search_path = public, auth\r\nAS $$\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = &#x27;admin&#x27;) THEN\r\n        RAISE EXCEPTION &#x27;Access denied.&#x27;;\r\n    END IF;\r\n\r\n    RETURN QUERY\r\n    SELECT au.id, au.email::text, p.role, au.created_at, p.is_active\r\n    FROM auth.users au\r\n    LEFT JOIN public.profiles p ON au.id = p.id\r\n    ORDER BY au.created_at DESC;\r\nEND;\r\n$$;\r\n\r\n-- 2. Update User Role\r\nCREATE OR REPLACE FUNCTION public.set_user_role(target_user_id uuid, new_role text)\r\nRETURNS void\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER\r\nSET search_path = public, auth\r\nAS $$\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = &#x27;admin&#x27;) THEN\r\n        RAISE EXCEPTION &#x27;Access denied.&#x27;;\r\n    END IF;\r\n\r\n    UPDATE public.profiles\r\n    SET role = new_role::public.user_role_enum\r\n    WHERE id = target_user_id;\r\nEND;\r\n$$;\r\n\r\n-- 3. Delete User Account\r\nCREATE OR REPLACE FUNCTION public.delete_user(target_user_id uuid)\r\nRETURNS void\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER\r\nSET search_path = public, auth\r\nAS $$\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = &#x27;admin&#x27;) THEN\r\n        RAISE EXCEPTION &#x27;Access denied.&#x27;;\r\n    END IF;\r\n    \r\n    IF auth.uid() = target_user_id THEN\r\n        RAISE EXCEPTION &#x27;Cannot delete yourself.&#x27;;\r\n    END IF;\r\n\r\n    DELETE FROM auth.users WHERE id = target_user_id;\r\nEND;\r\n$$;\r\n\r\n-- 4. Admin Create New User\r\n-- IMPORTANT: All token/string columns MUST be set to &#x27;&#x27; (empty string), NOT NULL.\r\n-- Supabase Auth&#x27;s Go scanner crashes with &quot;converting NULL to string is unsupported&quot;\r\n-- if any of these fields are NULL.\r\nCREATE OR REPLACE FUNCTION public.admin_create_user(\r\n  new_email text, \r\n  new_password text, \r\n  new_role text,\r\n  new_active boolean\r\n)\r\n RETURNS uuid\r\n LANGUAGE plpgsql\r\n SECURITY DEFINER\r\n SET search_path TO &#x27;public&#x27;, &#x27;auth&#x27;, &#x27;extensions&#x27;\r\nAS $function$\r\nDECLARE\r\n    new_id uuid;\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = &#x27;admin&#x27;) THEN\r\n        RAISE EXCEPTION &#x27;Access denied.&#x27;;\r\n    END IF;\r\n\r\n    new_id := gen_random_uuid();\r\n\r\n    INSERT INTO auth.users (\r\n        id, instance_id, aud, role, email, encrypted_password, \r\n        email_confirmed_at,         -- Auto-verify: skip email confirmation\r\n        confirmation_token,         -- Must be &#x27;&#x27; not NULL (Supabase Auth Go scanner)\r\n        recovery_token,             -- Must be &#x27;&#x27; not NULL\r\n        email_change_token_new,     -- Must be &#x27;&#x27; not NULL\r\n        email_change_token_current, -- Must be &#x27;&#x27; not NULL\r\n        reauthentication_token,     -- Must be &#x27;&#x27; not NULL\r\n        email_change,               -- Must be &#x27;&#x27; not NULL\r\n        phone_change,               -- Must be &#x27;&#x27; not NULL\r\n        phone_change_token,         -- Must be &#x27;&#x27; not NULL\r\n        raw_app_meta_data, raw_user_meta_data, created_at, updated_at\r\n    )\r\n    VALUES (\r\n        new_id, &#x27;00000000-0000-0000-0000-000000000000&#x27;, &#x27;authenticated&#x27;, &#x27;authenticated&#x27;,\r\n        new_email, extensions.crypt(new_password, extensions.gen_salt(&#x27;bf&#x27;)),\r\n        now(),\r\n        &#x27;&#x27;, &#x27;&#x27;, &#x27;&#x27;, &#x27;&#x27;, &#x27;&#x27;, &#x27;&#x27;, &#x27;&#x27;, &#x27;&#x27;,\r\n        &#x27;{&quot;provider&quot;:&quot;email&quot;,&quot;providers&quot;:[&quot;email&quot;]}&#x27;, &#x27;{}&#x27;, now(), now()\r\n    );\r\n\r\n    INSERT INTO public.profiles (id, role, is_active, created_at, updated_at)\r\n    VALUES (new_id, new_role::public.user_role_enum, new_active, now(), now())\r\n    ON CONFLICT (id) DO UPDATE SET role = EXCLUDED.role, is_active = EXCLUDED.is_active;\r\n    \r\n    RETURN new_id;\r\nEND;\r\n$function$;\r\n\r\n-- 5. Set User Active Status (Approve/Block)\r\nCREATE OR REPLACE FUNCTION public.set_user_active_status(target_user_id uuid, new_status boolean)\r\nRETURNS void\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER\r\nSET search_path = public, auth\r\nAS $$\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = &#x27;admin&#x27;) THEN\r\n        RAISE EXCEPTION &#x27;Access denied.&#x27;;\r\n    END IF;\r\n\r\n    UPDATE public.profiles\r\n    SET is_active = new_status\r\n    WHERE id = target_user_id;\r\nEND;\r\n$$;\r\n</code></pre></div></div></div></div></div><a class=\"absolute top-6 left-6 z-20 flex items-center gap-2 text-stone-500 hover:text-stone-900 font-semibold text-sm transition-all duration-300 bg-white/60 px-5 py-2.5 rounded-full shadow-sm border border-stone-200 hover:border-stone-300 hover:shadow-md\" href=\"/login\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-left size-4\" aria-hidden=\"true\"><path d=\"m12 19-7-7 7-7\"></path><path d=\"M19 12H5\"></path></svg>Quay lại Đăng nhập</a><footer class=\"py-8 text-center text-sm text-stone-500 bg-transparent border-none mt-auto relative z-10 backdrop-blur-sm\"><div class=\"max-w-7xl mx-auto px-4\"><p class=\"flex items-center justify-center gap-2 opacity-80 hover:opacity-100 transition-opacity\"><a href=\"https://github.com/homielab/giapha-os\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"font-semibold text-stone-600 hover:text-amber-700 transition-colors inline-flex items-center gap-1.5\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22\"></path></svg>Gia Phả OS</a>by<a href=\"https://homielab.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"font-semibold text-green-600 hover:text-amber-700 transition-colors inline-flex items-center gap-1.5\">HomieLab</a></p></div></footer></div><!--$--><!--/$--><script src=\"/_next/static/chunks/0yb2wil16uz6h.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[39756,[\\\"/_next/static/chunks/01xlw8hd842-c.js\\\",\\\"/_next/static/chunks/0d3shmwh5_nmn.js\\\"],\\\"default\\\"]\\n3:I[37457,[\\\"/_next/static/chunks/01xlw8hd842-c.js\\\",\\\"/_next/static/chunks/0d3shmwh5_nmn.js\\\"],\\\"default\\\"]\\n5:I[97367,[\\\"/_next/static/chunks/01xlw8hd842-c.js\\\",\\\"/_next/static/chunks/0d3shmwh5_nmn.js\\\"],\\\"OutletBoundary\\\"]\\n6:\\\"$Sreact.suspense\\\"\\n9:I[97367,[\\\"/_next/static/chunks/01xlw8hd842-c.js\\\",\\\"/_next/static/chunks/0d3shmwh5_nmn.js\\\"],\\\"ViewportBoundary\\\"]\\nb:I[97367,[\\\"/_next/static/chunks/01xlw8hd842-c.js\\\",\\\"/_next/static/chunks/0d3shmwh5_nmn.js\\\"],\\\"MetadataBoundary\\\"]\\nd:I[68027,[\\\"/_next/static/chunks/01xlw8hd842-c.js\\\",\\\"/_next/static/chunks/0d3shmwh5_nmn.js\\\"],\\\"default\\\",1]\\n:HL[\\\"/_next/static/chunks/0qa855wvp2uv9.css\\\",\\\"style\\\"]\\n:HL[\\\"/_next/static/chunks/0xc7eu11bieu_.css\\\",\\\"style\\\"]\\n:HL[\\\"/_next/static/media/14e23f9b59180572-s.p.08.c8psu~gif9.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/2a65768255d6b625-s.p.14by5b4al-y~f.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/2bbe8d2671613f1f-s.p.067x_6k0k23tk.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/83afe278b6a6bb3c-s.p.0q-301v4kxxnr.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n\"])</script><script>self.__next_f.push([1,\"0:{\\\"P\\\":null,\\\"c\\\":[\\\"\\\",\\\"setup\\\"],\\\"q\\\":\\\"\\\",\\\"i\\\":false,\\\"f\\\":[[[\\\"\\\",{\\\"children\\\":[\\\"setup\\\",{\\\"children\\\":[\\\"__PAGE__\\\",{}]}]},\\\"$undefined\\\",\\\"$undefined\\\",16],[[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[[[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/chunks/0qa855wvp2uv9.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}],[\\\"$\\\",\\\"link\\\",\\\"1\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/chunks/0xc7eu11bieu_.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}],[\\\"$\\\",\\\"script\\\",\\\"script-0\\\",{\\\"src\\\":\\\"/_next/static/chunks/01xlw8hd842-c.js\\\",\\\"async\\\":true,\\\"nonce\\\":\\\"$undefined\\\"}],[\\\"$\\\",\\\"script\\\",\\\"script-1\\\",{\\\"src\\\":\\\"/_next/static/chunks/0d3shmwh5_nmn.js\\\",\\\"async\\\":true,\\\"nonce\\\":\\\"$undefined\\\"}]],[\\\"$\\\",\\\"html\\\",null,{\\\"lang\\\":\\\"vi\\\",\\\"children\\\":[\\\"$\\\",\\\"body\\\",null,{\\\"className\\\":\\\"inter_f20e379b-module__TWS8mW__variable playfair_display_c88dccb7-module__wLnm0q__variable font-sans antialiased relative\\\",\\\"children\\\":[\\\"$\\\",\\\"$L2\\\",null,{\\\"parallelRouterKey\\\":\\\"children\\\",\\\"error\\\":\\\"$undefined\\\",\\\"errorStyles\\\":\\\"$undefined\\\",\\\"errorScripts\\\":\\\"$undefined\\\",\\\"template\\\":[\\\"$\\\",\\\"$L3\\\",null,{}],\\\"templateStyles\\\":\\\"$undefined\\\",\\\"templateScripts\\\":\\\"$undefined\\\",\\\"notFound\\\":[[[\\\"$\\\",\\\"title\\\",null,{\\\"children\\\":\\\"404: This page could not be found.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"fontFamily\\\":\\\"system-ui,\\\\\\\"Segoe UI\\\\\\\",Roboto,Helvetica,Arial,sans-serif,\\\\\\\"Apple Color Emoji\\\\\\\",\\\\\\\"Segoe UI Emoji\\\\\\\"\\\",\\\"height\\\":\\\"100vh\\\",\\\"textAlign\\\":\\\"center\\\",\\\"display\\\":\\\"flex\\\",\\\"flexDirection\\\":\\\"column\\\",\\\"alignItems\\\":\\\"center\\\",\\\"justifyContent\\\":\\\"center\\\"},\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"style\\\",null,{\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}\\\"}}],[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"next-error-h1\\\",\\\"style\\\":{\\\"display\\\":\\\"inline-block\\\",\\\"margin\\\":\\\"0 20px 0 0\\\",\\\"padding\\\":\\\"0 23px 0 0\\\",\\\"fontSize\\\":24,\\\"fontWeight\\\":500,\\\"verticalAlign\\\":\\\"top\\\",\\\"lineHeight\\\":\\\"49px\\\"},\\\"children\\\":404}],[\\\"$\\\",\\\"div\\\",null,{\\\"style\\\":{\\\"display\\\":\\\"inline-block\\\"},\\\"children\\\":[\\\"$\\\",\\\"h2\\\",null,{\\\"style\\\":{\\\"fontSize\\\":14,\\\"fontWeight\\\":400,\\\"lineHeight\\\":\\\"49px\\\",\\\"margin\\\":0},\\\"children\\\":\\\"This page could not be found.\\\"}]}]]}]}]],[]],\\\"forbidden\\\":\\\"$undefined\\\",\\\"unauthorized\\\":\\\"$undefined\\\"}]}]}]]}],{\\\"children\\\":[[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[null,[\\\"$\\\",\\\"$L2\\\",null,{\\\"parallelRouterKey\\\":\\\"children\\\",\\\"error\\\":\\\"$undefined\\\",\\\"errorStyles\\\":\\\"$undefined\\\",\\\"errorScripts\\\":\\\"$undefined\\\",\\\"template\\\":[\\\"$\\\",\\\"$L3\\\",null,{}],\\\"templateStyles\\\":\\\"$undefined\\\",\\\"templateScripts\\\":\\\"$undefined\\\",\\\"notFound\\\":\\\"$undefined\\\",\\\"forbidden\\\":\\\"$undefined\\\",\\\"unauthorized\\\":\\\"$undefined\\\"}]]}],{\\\"children\\\":[[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[\\\"$L4\\\",[[\\\"$\\\",\\\"script\\\",\\\"script-0\\\",{\\\"src\\\":\\\"/_next/static/chunks/10gp4~2wc-iyp.js\\\",\\\"async\\\":true,\\\"nonce\\\":\\\"$undefined\\\"}]],[\\\"$\\\",\\\"$L5\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"$6\\\",null,{\\\"name\\\":\\\"Next.MetadataOutlet\\\",\\\"children\\\":\\\"$@7\\\"}]}]]}],{},null,false,null]},null,false,\\\"$@8\\\"]},null,false,null],[\\\"$\\\",\\\"$1\\\",\\\"h\\\",{\\\"children\\\":[null,[\\\"$\\\",\\\"$L9\\\",null,{\\\"children\\\":\\\"$La\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"hidden\\\":true,\\\"children\\\":[\\\"$\\\",\\\"$Lb\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"$6\\\",null,{\\\"name\\\":\\\"Next.Metadata\\\",\\\"children\\\":\\\"$Lc\\\"}]}]}],[\\\"$\\\",\\\"meta\\\",null,{\\\"name\\\":\\\"next-size-adjust\\\",\\\"content\\\":\\\"\\\"}]]}],false]],\\\"m\\\":\\\"$undefined\\\",\\\"G\\\":[\\\"$d\\\",[[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/chunks/0qa855wvp2uv9.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}],[\\\"$\\\",\\\"link\\\",\\\"1\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/chunks/0xc7eu11bieu_.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}]]],\\\"S\\\":true,\\\"h\\\":null,\\\"s\\\":\\\"$undefined\\\",\\\"l\\\":\\\"$undefined\\\",\\\"p\\\":\\\"$undefined\\\",\\\"d\\\":\\\"$undefined\\\",\\\"b\\\":\\\"WOoep__bZIeFRofyAsxc8\\\"}\\n\"])</script><script>self.__next_f.push([1,\"e:[]\\n8:\\\"$We\\\"\\n\"])</script><script>self.__next_f.push([1,\"a:[[\\\"$\\\",\\\"meta\\\",\\\"0\\\",{\\\"charSet\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"viewport\\\",\\\"content\\\":\\\"width=device-width, initial-scale=1\\\"}]]\\n\"])</script><script>self.__next_f.push([1,\"f:I[27201,[\\\"/_next/static/chunks/01xlw8hd842-c.js\\\",\\\"/_next/static/chunks/0d3shmwh5_nmn.js\\\"],\\\"IconMark\\\"]\\n7:null\\nc:[[\\\"$\\\",\\\"title\\\",\\\"0\\\",{\\\"children\\\":\\\"Gia Phả OS\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"description\\\",\\\"content\\\":\\\"Gia Phả OS\\\"}],[\\\"$\\\",\\\"link\\\",\\\"2\\\",{\\\"rel\\\":\\\"icon\\\",\\\"href\\\":\\\"/favicon.ico?favicon.0cbu-oy3ga.gt.ico\\\",\\\"sizes\\\":\\\"48x48\\\",\\\"type\\\":\\\"image/x-icon\\\"}],[\\\"$\\\",\\\"$Lf\\\",\\\"3\\\",{}]]\\n\"])</script><script>self.__next_f.push([1,\"10:I[58541,[\\\"/_next/static/chunks/01xlw8hd842-c.js\\\",\\\"/_next/static/chunks/0d3shmwh5_nmn.js\\\",\\\"/_next/static/chunks/10gp4~2wc-iyp.js\\\"],\\\"default\\\"]\\n11:I[42593,[\\\"/_next/static/chunks/01xlw8hd842-c.js\\\",\\\"/_next/static/chunks/0d3shmwh5_nmn.js\\\",\\\"/_next/static/chunks/10gp4~2wc-iyp.js\\\"],\\\"default\\\"]\\n12:T48e5,\"])</script><script>self.__next_f.push([1,\"-- ==========================================\\r\\n-- GIAPHA-OS DATABASE SCHEMA\\r\\n-- ==========================================\\r\\n\\r\\n-- EXTENSIONS\\r\\nCREATE EXTENSION IF NOT EXISTS pgcrypto WITH SCHEMA extensions;\\r\\n\\r\\n-- ENUMS\\r\\n-- Gender types for family members\\r\\nDO $$ BEGIN\\r\\n    CREATE TYPE public.gender_enum AS ENUM ('male', 'female', 'other');\\r\\nEXCEPTION\\r\\n    WHEN duplicate_object THEN null;\\r\\nEND $$;\\r\\n\\r\\n-- Relationship types between family members\\r\\nDO $$ BEGIN\\r\\n    CREATE TYPE public.relationship_type_enum AS ENUM ('marriage', 'biological_child', 'adopted_child');\\r\\nEXCEPTION\\r\\n    WHEN duplicate_object THEN null;\\r\\nEND $$;\\r\\n\\r\\n-- System user roles\\r\\nDO $$ BEGIN\\r\\n    CREATE TYPE public.user_role_enum AS ENUM ('admin', 'editor', 'member');\\r\\nEXCEPTION\\r\\n    WHEN duplicate_object THEN null;\\r\\nEND $$;\\r\\n\\r\\n-- ==========================================\\r\\n-- UTILITY FUNCTIONS\\r\\n-- ==========================================\\r\\n\\r\\n-- Function to automatically update 'updated_at' timestamps\\r\\nCREATE OR REPLACE FUNCTION public.handle_updated_at()\\r\\nRETURNS TRIGGER AS $$\\r\\nBEGIN\\r\\n  NEW.updated_at = NOW();\\r\\n  RETURN NEW;\\r\\nEND;\\r\\n$$ LANGUAGE plpgsql;\\r\\n\\r\\n-- ==========================================\\r\\n-- TABLES (Data Preservation: No DROP TABLE commands)\\r\\n-- ==========================================\\r\\n\\r\\n-- PROFILES (Application users linked to Auth)\\r\\nCREATE TABLE IF NOT EXISTS public.profiles (\\r\\n  id UUID REFERENCES auth.users(id) ON DELETE CASCADE PRIMARY KEY,\\r\\n  role public.user_role_enum DEFAULT 'member' NOT NULL,\\r\\n  is_active BOOLEAN NOT NULL DEFAULT false,\\r\\n  created_at TIMESTAMPTZ DEFAULT NOW(),\\r\\n  updated_at TIMESTAMPTZ DEFAULT NOW()\\r\\n);\\r\\n\\r\\n-- PERSONS (Core entity for family tree)\\r\\nCREATE TABLE IF NOT EXISTS public.persons (\\r\\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\\r\\n  full_name TEXT NOT NULL,\\r\\n  gender public.gender_enum NOT NULL,\\r\\n  \\r\\n  -- Date components (allows for partial dates where only year is known)\\r\\n  birth_year INT,\\r\\n  birth_month INT,\\r\\n  birth_day INT,\\r\\n  death_year INT,\\r\\n  death_month INT,\\r\\n  death_day INT,\\r\\n  death_lunar_year INT,\\r\\n  death_lunar_month INT,\\r\\n  death_lunar_day INT,\\r\\n  \\r\\n  is_deceased BOOLEAN NOT NULL DEFAULT FALSE,\\r\\n  is_in_law BOOLEAN NOT NULL DEFAULT FALSE,\\r\\n  birth_order INT,\\r\\n  generation INT,\\r\\n  other_names TEXT,\\r\\n  avatar_url TEXT,\\r\\n  note TEXT,\\r\\n  \\r\\n  created_at TIMESTAMPTZ DEFAULT NOW(),\\r\\n  updated_at TIMESTAMPTZ DEFAULT NOW()\\r\\n);\\r\\n\\r\\n-- PERSON_DETAILS_PRIVATE (Sensitive data with restricted RLS)\\r\\nCREATE TABLE IF NOT EXISTS public.person_details_private (\\r\\n  person_id UUID REFERENCES public.persons(id) ON DELETE CASCADE PRIMARY KEY,\\r\\n  phone_number TEXT,\\r\\n  occupation TEXT,\\r\\n  current_residence TEXT,\\r\\n  created_at TIMESTAMPTZ DEFAULT NOW(),\\r\\n  updated_at TIMESTAMPTZ DEFAULT NOW()\\r\\n);\\r\\n\\r\\n-- RELATIONSHIPS (Links between persons)\\r\\nCREATE TABLE IF NOT EXISTS public.relationships (\\r\\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\\r\\n  type public.relationship_type_enum NOT NULL,\\r\\n  person_a UUID REFERENCES public.persons(id) ON DELETE CASCADE NOT NULL,\\r\\n  person_b UUID REFERENCES public.persons(id) ON DELETE CASCADE NOT NULL,\\r\\n  note TEXT,\\r\\n  created_at TIMESTAMPTZ DEFAULT NOW(),\\r\\n  updated_at TIMESTAMPTZ DEFAULT NOW(),\\r\\n  \\r\\n  -- Prevent self-relationships\\r\\n  CONSTRAINT no_self_relationship CHECK (person_a != person_b),\\r\\n  \\r\\n  -- Ensure unique relationships between pairs for a specific type\\r\\n  UNIQUE(person_a, person_b, type)\\r\\n);\\r\\n\\r\\n-- CUSTOM_EVENTS (User-created events)\\r\\nCREATE TABLE IF NOT EXISTS public.custom_events (\\r\\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\\r\\n  name TEXT NOT NULL,\\r\\n  content TEXT,\\r\\n  event_date DATE NOT NULL,\\r\\n  location TEXT,\\r\\n  created_by UUID REFERENCES public.profiles(id) DEFAULT auth.uid(),\\r\\n  \\r\\n  created_at TIMESTAMPTZ DEFAULT NOW(),\\r\\n  updated_at TIMESTAMPTZ DEFAULT NOW()\\r\\n);\\r\\n\\r\\n-- ==========================================\\r\\n-- INDEXES\\r\\n-- ==========================================\\r\\n\\r\\n-- Relationship lookups\\r\\nCREATE INDEX IF NOT EXISTS idx_relationships_person_a ON public.relationships(person_a);\\r\\nCREATE INDEX IF NOT EXISTS idx_relationships_person_b ON public.relationships(person_b);\\r\\nCREATE INDEX IF NOT EXISTS idx_relationships_type ON public.relationships(type);\\r\\n\\r\\n-- Person filtering and sorting\\r\\nCREATE INDEX IF NOT EXISTS idx_persons_full_name ON public.persons(full_name);\\r\\nCREATE INDEX IF NOT EXISTS idx_persons_generation ON public.persons(generation);\\r\\nCREATE INDEX IF NOT EXISTS idx_persons_gender ON public.persons(gender);\\r\\nCREATE INDEX IF NOT EXISTS idx_persons_is_deceased ON public.persons(is_deceased);\\r\\nCREATE INDEX IF NOT EXISTS idx_persons_birth_year ON public.persons(birth_year);\\r\\n\\r\\n-- Profile lookups\\r\\nCREATE INDEX IF NOT EXISTS idx_profiles_role ON public.profiles(role);\\r\\nCREATE INDEX IF NOT EXISTS idx_profiles_is_active ON public.profiles(is_active);\\r\\n\\r\\n-- Custom events lookups\\r\\nCREATE INDEX IF NOT EXISTS idx_custom_events_date ON public.custom_events(event_date);\\r\\nCREATE INDEX IF NOT EXISTS idx_custom_events_created_by ON public.custom_events(created_by);\\r\\n\\r\\n-- ==========================================\\r\\n-- RLS POLICIES\\r\\n-- ==========================================\\r\\n\\r\\nALTER TABLE public.profiles ENABLE ROW LEVEL SECURITY;\\r\\nALTER TABLE public.persons ENABLE ROW LEVEL SECURITY;\\r\\nALTER TABLE public.person_details_private ENABLE ROW LEVEL SECURITY;\\r\\nALTER TABLE public.relationships ENABLE ROW LEVEL SECURITY;\\r\\n\\r\\n-- Helper function to check if user is admin\\r\\nCREATE OR REPLACE FUNCTION public.is_admin()\\r\\nRETURNS BOOLEAN AS $$\\r\\nBEGIN\\r\\n  RETURN EXISTS (\\r\\n    SELECT 1 FROM public.profiles\\r\\n    WHERE id = auth.uid() AND role = 'admin'\\r\\n  );\\r\\nEND;\\r\\n$$ LANGUAGE plpgsql SECURITY DEFINER;\\r\\n\\r\\n-- Helper function to check if user is editor\\r\\nCREATE OR REPLACE FUNCTION PUBLIC.IS_EDITOR()\\r\\nRETURNS BOOLEAN\\r\\nLANGUAGE PLPGSQL\\r\\nSECURITY DEFINER\\r\\nSET SEARCH_PATH = PUBLIC\\r\\nAS $$\\r\\nBEGIN\\r\\n  RETURN EXISTS (\\r\\n    SELECT 1 FROM public.profiles\\r\\n    WHERE id = auth.uid() AND role = 'editor'\\r\\n  );\\r\\nEND;\\r\\n$$;\\r\\nrevoke all on function public.is_editor() from public;\\r\\ngrant execute on function public.is_editor() to authenticated;\\r\\n\\r\\n-- PROFILES POLICIES\\r\\nDROP POLICY IF EXISTS \\\"Users can view own profile\\\" ON public.profiles;\\r\\nCREATE POLICY \\\"Users can view own profile\\\" ON public.profiles FOR SELECT USING (auth.uid() = id);\\r\\n\\r\\nDROP POLICY IF EXISTS \\\"Admins can view all profiles\\\" ON public.profiles;\\r\\nCREATE POLICY \\\"Admins can view all profiles\\\" ON public.profiles FOR SELECT USING (public.is_admin());\\r\\n\\r\\n-- PERSONS POLICIES\\r\\nDROP POLICY IF EXISTS \\\"Enable read access for authenticated users\\\" ON public.persons;\\r\\nCREATE POLICY \\\"Enable read access for authenticated users\\\" ON public.persons FOR SELECT TO authenticated USING (true);\\r\\n\\r\\nDROP POLICY IF EXISTS \\\"Admins can manage persons\\\" ON public.persons;\\r\\nDROP POLICY IF EXISTS \\\"Admins can insert persons\\\" ON public.persons;\\r\\nDROP POLICY IF EXISTS \\\"Admins can update persons\\\" ON public.persons;\\r\\nDROP POLICY IF EXISTS \\\"Admins can delete persons\\\" ON public.persons;\\r\\n\\r\\nCREATE POLICY \\\"Admins and Editors can insert persons\\\" ON public.persons FOR INSERT TO authenticated WITH CHECK (public.is_admin() OR public.is_editor());\\r\\nCREATE POLICY \\\"Admins and Editors can update persons\\\" ON public.persons FOR UPDATE TO authenticated USING (public.is_admin() OR public.is_editor()) WITH CHECK (public.is_admin() OR public.is_editor());\\r\\nCREATE POLICY \\\"Admins and Editors can delete persons\\\" ON public.persons FOR DELETE TO authenticated USING (public.is_admin() OR public.is_editor());\\r\\n\\r\\n-- PERSON_DETAILS_PRIVATE POLICIES\\r\\nDROP POLICY IF EXISTS \\\"Admins can view private details\\\" ON public.person_details_private;\\r\\nCREATE POLICY \\\"Admins can view private details\\\" ON public.person_details_private FOR SELECT TO authenticated USING (public.is_admin());\\r\\n\\r\\nDROP POLICY IF EXISTS \\\"Admins can manage private details\\\" ON public.person_details_private;\\r\\nCREATE POLICY \\\"Admins can manage private details\\\" ON public.person_details_private FOR ALL TO authenticated USING (public.is_admin());\\r\\n\\r\\n-- RELATIONSHIPS POLICIES\\r\\nDROP POLICY IF EXISTS \\\"Enable read access for authenticated users\\\" ON public.relationships;\\r\\nCREATE POLICY \\\"Enable read access for authenticated users\\\" ON public.relationships FOR SELECT TO authenticated USING (true);\\r\\n\\r\\nDROP POLICY IF EXISTS \\\"Admins can manage relationships\\\" ON public.relationships;\\r\\nDROP POLICY IF EXISTS \\\"Admins can insert relationships\\\" ON public.relationships;\\r\\nDROP POLICY IF EXISTS \\\"Admins can update relationships\\\" ON public.relationships;\\r\\nDROP POLICY IF EXISTS \\\"Admins can delete relationships\\\" ON public.relationships;\\r\\n\\r\\nCREATE POLICY \\\"Admins and Editors can insert relationships\\\" ON public.relationships FOR INSERT TO authenticated WITH CHECK (public.is_admin() OR public.is_editor());\\r\\nCREATE POLICY \\\"Admins and Editors can update relationships\\\" ON public.relationships FOR UPDATE TO authenticated USING (public.is_admin() OR public.is_editor()) WITH CHECK (public.is_admin() OR public.is_editor());\\r\\nCREATE POLICY \\\"Admins and Editors can delete relationships\\\" ON public.relationships FOR DELETE TO authenticated USING (public.is_admin() OR public.is_editor());\\r\\n\\r\\n-- CUSTOM_EVENTS POLICIES\\r\\nALTER TABLE public.custom_events ENABLE ROW LEVEL SECURITY;\\r\\n\\r\\nDROP POLICY IF EXISTS \\\"Enable read access for authenticated users\\\" ON public.custom_events;\\r\\nCREATE POLICY \\\"Enable read access for authenticated users\\\" ON public.custom_events FOR SELECT TO authenticated USING (true);\\r\\n\\r\\nDROP POLICY IF EXISTS \\\"Authenticated users can insert custom events\\\" ON public.custom_events;\\r\\nCREATE POLICY \\\"Authenticated users can insert custom events\\\" ON public.custom_events FOR INSERT TO authenticated WITH CHECK (auth.uid() = created_by);\\r\\n\\r\\nDROP POLICY IF EXISTS \\\"Users can update own custom events\\\" ON public.custom_events;\\r\\nCREATE POLICY \\\"Users can update own custom events\\\" ON public.custom_events FOR UPDATE TO authenticated USING (auth.uid() = created_by OR public.is_admin());\\r\\n\\r\\nDROP POLICY IF EXISTS \\\"Users can delete own custom events\\\" ON public.custom_events;\\r\\nCREATE POLICY \\\"Users can delete own custom events\\\" ON public.custom_events FOR DELETE TO authenticated USING (auth.uid() = created_by OR public.is_admin());\\r\\n\\r\\n-- ==========================================\\r\\n-- TRIGGERS\\r\\n-- ==========================================\\r\\n\\r\\n-- 1. Updated At Triggers\\r\\nDROP TRIGGER IF EXISTS tr_profiles_updated_at ON public.profiles;\\r\\nCREATE TRIGGER tr_profiles_updated_at BEFORE UPDATE ON public.profiles FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\\r\\n\\r\\nDROP TRIGGER IF EXISTS tr_persons_updated_at ON public.persons;\\r\\nCREATE TRIGGER tr_persons_updated_at BEFORE UPDATE ON public.persons FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\\r\\n\\r\\nDROP TRIGGER IF EXISTS tr_person_details_private_updated_at ON public.person_details_private;\\r\\nCREATE TRIGGER tr_person_details_private_updated_at BEFORE UPDATE ON public.person_details_private FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\\r\\n\\r\\nDROP TRIGGER IF EXISTS tr_relationships_updated_at ON public.relationships;\\r\\nCREATE TRIGGER tr_relationships_updated_at BEFORE UPDATE ON public.relationships FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\\r\\n\\r\\nDROP TRIGGER IF EXISTS tr_custom_events_updated_at ON public.custom_events;\\r\\nCREATE TRIGGER tr_custom_events_updated_at BEFORE UPDATE ON public.custom_events FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\\r\\n\\r\\n-- 2. Handle new user signup (Profile creation)\\r\\nCREATE OR REPLACE FUNCTION public.handle_new_user()\\r\\nRETURNS trigger \\r\\nLANGUAGE plpgsql\\r\\nSECURITY DEFINER SET search_path = public, auth\\r\\nAS $$\\r\\nDECLARE\\r\\n  is_first_user boolean;\\r\\nBEGIN\\r\\n  -- Check if this is the first user (count will be 1 as this is AFTER INSERT)\\r\\n  SELECT count(*) = 1 FROM auth.users INTO is_first_user;\\r\\n\\r\\n  INSERT INTO public.profiles (id, role, is_active)\\r\\n  VALUES (\\r\\n    new.id, \\r\\n    CASE WHEN is_first_user THEN 'admin'::public.user_role_enum ELSE 'member'::public.user_role_enum END,\\r\\n    true\\r\\n  );\\r\\n\\r\\n  UPDATE public.profiles \\r\\n  SET is_active = true \\r\\n  WHERE id = new.id AND is_first_user = true;\\r\\n\\r\\n  RETURN new;\\r\\nEND;\\r\\n$$;\\r\\n\\r\\n-- 3. Auto-confirm first user (Email verification)\\r\\nCREATE OR REPLACE FUNCTION public.handle_first_user_confirmation()\\r\\nRETURNS trigger\\r\\nLANGUAGE plpgsql\\r\\nSECURITY DEFINER SET search_path = auth\\r\\nAS $$\\r\\nBEGIN\\r\\n  -- If no users exist yet, auto-confirm this first one\\r\\n  IF NOT EXISTS (SELECT 1 FROM auth.users) THEN\\r\\n    NEW.email_confirmed_at := NOW();\\r\\n    NEW.last_sign_in_at := NOW();\\r\\n  END IF;\\r\\n  RETURN NEW;\\r\\nEND;\\r\\n$$;\\r\\n\\r\\n-- Trigger for profile creation\\r\\nDROP TRIGGER IF EXISTS on_auth_user_created ON auth.users;\\r\\nCREATE TRIGGER on_auth_user_created\\r\\n  AFTER INSERT ON auth.users\\r\\n  FOR EACH ROW EXECUTE PROCEDURE public.handle_new_user();\\r\\n\\r\\n-- Trigger for auto-confirmation\\r\\nDROP TRIGGER IF EXISTS on_auth_user_created_confirm ON auth.users;\\r\\nCREATE TRIGGER on_auth_user_created_confirm\\r\\n  BEFORE INSERT ON auth.users\\r\\n  FOR EACH ROW EXECUTE PROCEDURE public.handle_first_user_confirmation();\\r\\n\\r\\n-- ==========================================\\r\\n-- STORAGE POLICIES\\r\\n-- ==========================================\\r\\n\\r\\n-- Initialize 'avatars' bucket\\r\\nINSERT INTO storage.buckets (id, name, public) \\r\\nVALUES ('avatars', 'avatars', true) \\r\\nON CONFLICT (id) DO UPDATE SET public = true;\\r\\n\\r\\nDROP POLICY IF EXISTS \\\"Avatar images are publicly accessible.\\\" ON storage.objects;\\r\\nCREATE POLICY \\\"Avatar images are publicly accessible.\\\" ON storage.objects FOR SELECT USING ( bucket_id = 'avatars' );\\r\\n\\r\\nDROP POLICY IF EXISTS \\\"Users can upload avatars.\\\" ON storage.objects;\\r\\nCREATE POLICY \\\"Users can upload avatars.\\\" ON storage.objects FOR INSERT WITH CHECK ( bucket_id = 'avatars' AND auth.role() = 'authenticated' );\\r\\n\\r\\nDROP POLICY IF EXISTS \\\"Users can update avatars.\\\" ON storage.objects;\\r\\nCREATE POLICY \\\"Users can update avatars.\\\" ON storage.objects FOR UPDATE USING ( bucket_id = 'avatars' AND auth.role() = 'authenticated' );\\r\\n\\r\\nDROP POLICY IF EXISTS \\\"Users can delete avatars.\\\" ON storage.objects;\\r\\nCREATE POLICY \\\"Users can delete avatars.\\\" ON storage.objects FOR DELETE USING ( bucket_id = 'avatars' AND auth.role() = 'authenticated' );\\r\\n\\r\\n-- ==========================================\\r\\n-- ADMIN RPC FUNCTIONS\\r\\n-- ==========================================\\r\\n\\r\\n-- Custom type for get_admin_users\\r\\nDROP TYPE IF EXISTS public.admin_user_data CASCADE;\\r\\nCREATE TYPE public.admin_user_data AS (\\r\\n    id uuid,\\r\\n    email text,\\r\\n    role public.user_role_enum,\\r\\n    created_at timestamptz,\\r\\n    is_active boolean\\r\\n);\\r\\n\\r\\n-- 1. Get List of Users for Admin\\r\\nCREATE OR REPLACE FUNCTION public.get_admin_users()\\r\\nRETURNS SETOF public.admin_user_data\\r\\nLANGUAGE plpgsql\\r\\nSECURITY DEFINER\\r\\nSET search_path = public, auth\\r\\nAS $$\\r\\nBEGIN\\r\\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\\r\\n        RAISE EXCEPTION 'Access denied.';\\r\\n    END IF;\\r\\n\\r\\n    RETURN QUERY\\r\\n    SELECT au.id, au.email::text, p.role, au.created_at, p.is_active\\r\\n    FROM auth.users au\\r\\n    LEFT JOIN public.profiles p ON au.id = p.id\\r\\n    ORDER BY au.created_at DESC;\\r\\nEND;\\r\\n$$;\\r\\n\\r\\n-- 2. Update User Role\\r\\nCREATE OR REPLACE FUNCTION public.set_user_role(target_user_id uuid, new_role text)\\r\\nRETURNS void\\r\\nLANGUAGE plpgsql\\r\\nSECURITY DEFINER\\r\\nSET search_path = public, auth\\r\\nAS $$\\r\\nBEGIN\\r\\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\\r\\n        RAISE EXCEPTION 'Access denied.';\\r\\n    END IF;\\r\\n\\r\\n    UPDATE public.profiles\\r\\n    SET role = new_role::public.user_role_enum\\r\\n    WHERE id = target_user_id;\\r\\nEND;\\r\\n$$;\\r\\n\\r\\n-- 3. Delete User Account\\r\\nCREATE OR REPLACE FUNCTION public.delete_user(target_user_id uuid)\\r\\nRETURNS void\\r\\nLANGUAGE plpgsql\\r\\nSECURITY DEFINER\\r\\nSET search_path = public, auth\\r\\nAS $$\\r\\nBEGIN\\r\\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\\r\\n        RAISE EXCEPTION 'Access denied.';\\r\\n    END IF;\\r\\n    \\r\\n    IF auth.uid() = target_user_id THEN\\r\\n        RAISE EXCEPTION 'Cannot delete yourself.';\\r\\n    END IF;\\r\\n\\r\\n    DELETE FROM auth.users WHERE id = target_user_id;\\r\\nEND;\\r\\n$$;\\r\\n\\r\\n-- 4. Admin Create New User\\r\\n-- IMPORTANT: All token/string columns MUST be set to '' (empty string), NOT NULL.\\r\\n-- Supabase Auth's Go scanner crashes with \\\"converting NULL to string is unsupported\\\"\\r\\n-- if any of these fields are NULL.\\r\\nCREATE OR REPLACE FUNCTION public.admin_create_user(\\r\\n  new_email text, \\r\\n  new_password text, \\r\\n  new_role text,\\r\\n  new_active boolean\\r\\n)\\r\\n RETURNS uuid\\r\\n LANGUAGE plpgsql\\r\\n SECURITY DEFINER\\r\\n SET search_path TO 'public', 'auth', 'extensions'\\r\\nAS $function$\\r\\nDECLARE\\r\\n    new_id uuid;\\r\\nBEGIN\\r\\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\\r\\n        RAISE EXCEPTION 'Access denied.';\\r\\n    END IF;\\r\\n\\r\\n    new_id := gen_random_uuid();\\r\\n\\r\\n    INSERT INTO auth.users (\\r\\n        id, instance_id, aud, role, email, encrypted_password, \\r\\n        email_confirmed_at,         -- Auto-verify: skip email confirmation\\r\\n        confirmation_token,         -- Must be '' not NULL (Supabase Auth Go scanner)\\r\\n        recovery_token,             -- Must be '' not NULL\\r\\n        email_change_token_new,     -- Must be '' not NULL\\r\\n        email_change_token_current, -- Must be '' not NULL\\r\\n        reauthentication_token,     -- Must be '' not NULL\\r\\n        email_change,               -- Must be '' not NULL\\r\\n        phone_change,               -- Must be '' not NULL\\r\\n        phone_change_token,         -- Must be '' not NULL\\r\\n        raw_app_meta_data, raw_user_meta_data, created_at, updated_at\\r\\n    )\\r\\n    VALUES (\\r\\n        new_id, '00000000-0000-0000-0000-000000000000', 'authenticated', 'authenticated',\\r\\n        new_email, extensions.crypt(new_password, extensions.gen_salt('bf')),\\r\\n        now(),\\r\\n        '', '', '', '', '', '', '', '',\\r\\n        '{\\\"provider\\\":\\\"email\\\",\\\"providers\\\":[\\\"email\\\"]}', '{}', now(), now()\\r\\n    );\\r\\n\\r\\n    INSERT INTO public.profiles (id, role, is_active, created_at, updated_at)\\r\\n    VALUES (new_id, new_role::public.user_role_enum, new_active, now(), now())\\r\\n    ON CONFLICT (id) DO UPDATE SET role = EXCLUDED.role, is_active = EXCLUDED.is_active;\\r\\n    \\r\\n    RETURN new_id;\\r\\nEND;\\r\\n$function$;\\r\\n\\r\\n-- 5. Set User Active Status (Approve/Block)\\r\\nCREATE OR REPLACE FUNCTION public.set_user_active_status(target_user_id uuid, new_status boolean)\\r\\nRETURNS void\\r\\nLANGUAGE plpgsql\\r\\nSECURITY DEFINER\\r\\nSET search_path = public, auth\\r\\nAS $$\\r\\nBEGIN\\r\\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\\r\\n        RAISE EXCEPTION 'Access denied.';\\r\\n    END IF;\\r\\n\\r\\n    UPDATE public.profiles\\r\\n    SET is_active = new_status\\r\\n    WHERE id = target_user_id;\\r\\nEND;\\r\\n$$;\\r\\n\"])</script><script>self.__next_f.push([1,\"4:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"min-h-screen flex flex-col bg-[#fafaf9] select-none selection:bg-amber-200 selection:text-amber-900 relative overflow-hidden\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"absolute inset-0 bg-[linear-gradient(to_right,#80808008_1px,transparent_1px),linear-gradient(to_bottom,#80808008_1px,transparent_1px)] bg-size-[24px_24px] pointer-events-none\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"absolute top-0 inset-x-0 h-screen overflow-hidden pointer-events-none flex justify-center\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"absolute top-[-10%] right-[-5%] w-[50vw] h-[50vw] max-w-[600px] max-h-[600px] bg-indigo-300/20 rounded-full blur-[100px] mix-blend-multiply\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"absolute bottom-[0%] left-[-10%] w-[60vw] h-[60vw] max-w-[800px] max-h-[800px] bg-teal-200/20 rounded-full blur-[120px] mix-blend-multiply\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex-1 flex flex-col items-center px-4 py-12 relative z-10 w-full max-w-5xl mx-auto\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"w-full bg-white p-8 sm:p-10 rounded-3xl shadow-xl border border-stone-200 relative overflow-hidden mb-8\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-4 mb-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"p-4 bg-indigo-50 text-indigo-600 rounded-2xl\\\",\\\"children\\\":[\\\"$\\\",\\\"$L10\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":[[\\\"ellipse\\\",{\\\"cx\\\":\\\"12\\\",\\\"cy\\\":\\\"5\\\",\\\"rx\\\":\\\"9\\\",\\\"ry\\\":\\\"3\\\",\\\"key\\\":\\\"msslwz\\\"}],[\\\"path\\\",{\\\"d\\\":\\\"M3 5V19A9 3 0 0 0 21 19V5\\\",\\\"key\\\":\\\"1wlel7\\\"}],[\\\"path\\\",{\\\"d\\\":\\\"M3 12A9 3 0 0 0 21 12\\\",\\\"key\\\":\\\"mv7ke4\\\"}]],\\\"className\\\":\\\"lucide-database size-8\\\"}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl sm:text-3xl font-bold text-stone-900 tracking-tight\\\",\\\"children\\\":\\\"Khởi tạo Cơ sở dữ liệu\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-stone-500 font-medium\\\",\\\"children\\\":\\\"Hệ thống phát hiện database của bạn chưa được thiết lập cấu trúc bảng (schema).\\\"}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid grid-cols-1 md:grid-cols-2 gap-8\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-6\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"bg-stone-50 border border-stone-200 rounded-2xl p-6 h-full\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-semibold text-stone-900 mb-4 flex items-center gap-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L10\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":[[\\\"path\\\",{\\\"d\\\":\\\"M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z\\\",\\\"key\\\":\\\"10ikf1\\\"}]],\\\"className\\\":\\\"lucide-play size-5 text-stone-500\\\"}],\\\"Hướng dẫn thực hiện:\\\"]}],[\\\"$\\\",\\\"ol\\\",null,{\\\"className\\\":\\\"list-decimal list-inside space-y-4 text-stone-600\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",null,{\\\"className\\\":\\\"leading-relaxed\\\",\\\"children\\\":[\\\"Bấm nút\\\",\\\" \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"className\\\":\\\"text-indigo-600\\\",\\\"children\\\":\\\"Copy Mã SQL\\\"}],\\\" ở bên dưới để sao chép toàn bộ cấu trúc cơ sở dữ liệu.\\\"]}],[\\\"$\\\",\\\"li\\\",null,{\\\"className\\\":\\\"leading-relaxed\\\",\\\"children\\\":[\\\"Mở\\\",\\\" \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://supabase.com/dashboard/project/_/sql/new\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noopener noreferrer\\\",\\\"className\\\":\\\"text-amber-600 font-semibold hover:underline\\\",\\\"children\\\":\\\"Supabase SQL Editor\\\"}],\\\" \\\",\\\"trong dự án của bạn.\\\"]}],[\\\"$\\\",\\\"li\\\",null,{\\\"className\\\":\\\"leading-relaxed\\\",\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Dán (Paste)\\\"}],\\\" mã vừa copy vào khung soạn thảo của Supabase.\\\"]}],[\\\"$\\\",\\\"li\\\",null,{\\\"className\\\":\\\"leading-relaxed\\\",\\\"children\\\":[\\\"Bấm nút \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"RUN\\\"}],\\\" (Chạy) ở góc phải dưới cùng màn hình Supabase.\\\"]}],[\\\"$\\\",\\\"li\\\",null,{\\\"className\\\":\\\"leading-relaxed\\\",\\\"children\\\":[\\\"Quay lại đây và \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Tải lại trang\\\"}],\\\" (hoặc bấm Đăng nhập lại).\\\"]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-8\\\",\\\"children\\\":[\\\"$\\\",\\\"$L11\\\",null,{\\\"content\\\":\\\"$12\\\"}]}]]}]}],\\\"$L13\\\"]}]]}]}],\\\"$L14\\\",\\\"$L15\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"17:I[22016,[\\\"/_next/static/chunks/01xlw8hd842-c.js\\\",\\\"/_next/static/chunks/0d3shmwh5_nmn.js\\\",\\\"/_next/static/chunks/10gp4~2wc-iyp.js\\\"],\\\"\\\"]\\n16:T48e5,\"])</script><script>self.__next_f.push([1,\"-- ==========================================\\r\\n-- GIAPHA-OS DATABASE SCHEMA\\r\\n-- ==========================================\\r\\n\\r\\n-- EXTENSIONS\\r\\nCREATE EXTENSION IF NOT EXISTS pgcrypto WITH SCHEMA extensions;\\r\\n\\r\\n-- ENUMS\\r\\n-- Gender types for family members\\r\\nDO $$ BEGIN\\r\\n    CREATE TYPE public.gender_enum AS ENUM ('male', 'female', 'other');\\r\\nEXCEPTION\\r\\n    WHEN duplicate_object THEN null;\\r\\nEND $$;\\r\\n\\r\\n-- Relationship types between family members\\r\\nDO $$ BEGIN\\r\\n    CREATE TYPE public.relationship_type_enum AS ENUM ('marriage', 'biological_child', 'adopted_child');\\r\\nEXCEPTION\\r\\n    WHEN duplicate_object THEN null;\\r\\nEND $$;\\r\\n\\r\\n-- System user roles\\r\\nDO $$ BEGIN\\r\\n    CREATE TYPE public.user_role_enum AS ENUM ('admin', 'editor', 'member');\\r\\nEXCEPTION\\r\\n    WHEN duplicate_object THEN null;\\r\\nEND $$;\\r\\n\\r\\n-- ==========================================\\r\\n-- UTILITY FUNCTIONS\\r\\n-- ==========================================\\r\\n\\r\\n-- Function to automatically update 'updated_at' timestamps\\r\\nCREATE OR REPLACE FUNCTION public.handle_updated_at()\\r\\nRETURNS TRIGGER AS $$\\r\\nBEGIN\\r\\n  NEW.updated_at = NOW();\\r\\n  RETURN NEW;\\r\\nEND;\\r\\n$$ LANGUAGE plpgsql;\\r\\n\\r\\n-- ==========================================\\r\\n-- TABLES (Data Preservation: No DROP TABLE commands)\\r\\n-- ==========================================\\r\\n\\r\\n-- PROFILES (Application users linked to Auth)\\r\\nCREATE TABLE IF NOT EXISTS public.profiles (\\r\\n  id UUID REFERENCES auth.users(id) ON DELETE CASCADE PRIMARY KEY,\\r\\n  role public.user_role_enum DEFAULT 'member' NOT NULL,\\r\\n  is_active BOOLEAN NOT NULL DEFAULT false,\\r\\n  created_at TIMESTAMPTZ DEFAULT NOW(),\\r\\n  updated_at TIMESTAMPTZ DEFAULT NOW()\\r\\n);\\r\\n\\r\\n-- PERSONS (Core entity for family tree)\\r\\nCREATE TABLE IF NOT EXISTS public.persons (\\r\\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\\r\\n  full_name TEXT NOT NULL,\\r\\n  gender public.gender_enum NOT NULL,\\r\\n  \\r\\n  -- Date components (allows for partial dates where only year is known)\\r\\n  birth_year INT,\\r\\n  birth_month INT,\\r\\n  birth_day INT,\\r\\n  death_year INT,\\r\\n  death_month INT,\\r\\n  death_day INT,\\r\\n  death_lunar_year INT,\\r\\n  death_lunar_month INT,\\r\\n  death_lunar_day INT,\\r\\n  \\r\\n  is_deceased BOOLEAN NOT NULL DEFAULT FALSE,\\r\\n  is_in_law BOOLEAN NOT NULL DEFAULT FALSE,\\r\\n  birth_order INT,\\r\\n  generation INT,\\r\\n  other_names TEXT,\\r\\n  avatar_url TEXT,\\r\\n  note TEXT,\\r\\n  \\r\\n  created_at TIMESTAMPTZ DEFAULT NOW(),\\r\\n  updated_at TIMESTAMPTZ DEFAULT NOW()\\r\\n);\\r\\n\\r\\n-- PERSON_DETAILS_PRIVATE (Sensitive data with restricted RLS)\\r\\nCREATE TABLE IF NOT EXISTS public.person_details_private (\\r\\n  person_id UUID REFERENCES public.persons(id) ON DELETE CASCADE PRIMARY KEY,\\r\\n  phone_number TEXT,\\r\\n  occupation TEXT,\\r\\n  current_residence TEXT,\\r\\n  created_at TIMESTAMPTZ DEFAULT NOW(),\\r\\n  updated_at TIMESTAMPTZ DEFAULT NOW()\\r\\n);\\r\\n\\r\\n-- RELATIONSHIPS (Links between persons)\\r\\nCREATE TABLE IF NOT EXISTS public.relationships (\\r\\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\\r\\n  type public.relationship_type_enum NOT NULL,\\r\\n  person_a UUID REFERENCES public.persons(id) ON DELETE CASCADE NOT NULL,\\r\\n  person_b UUID REFERENCES public.persons(id) ON DELETE CASCADE NOT NULL,\\r\\n  note TEXT,\\r\\n  created_at TIMESTAMPTZ DEFAULT NOW(),\\r\\n  updated_at TIMESTAMPTZ DEFAULT NOW(),\\r\\n  \\r\\n  -- Prevent self-relationships\\r\\n  CONSTRAINT no_self_relationship CHECK (person_a != person_b),\\r\\n  \\r\\n  -- Ensure unique relationships between pairs for a specific type\\r\\n  UNIQUE(person_a, person_b, type)\\r\\n);\\r\\n\\r\\n-- CUSTOM_EVENTS (User-created events)\\r\\nCREATE TABLE IF NOT EXISTS public.custom_events (\\r\\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\\r\\n  name TEXT NOT NULL,\\r\\n  content TEXT,\\r\\n  event_date DATE NOT NULL,\\r\\n  location TEXT,\\r\\n  created_by UUID REFERENCES public.profiles(id) DEFAULT auth.uid(),\\r\\n  \\r\\n  created_at TIMESTAMPTZ DEFAULT NOW(),\\r\\n  updated_at TIMESTAMPTZ DEFAULT NOW()\\r\\n);\\r\\n\\r\\n-- ==========================================\\r\\n-- INDEXES\\r\\n-- ==========================================\\r\\n\\r\\n-- Relationship lookups\\r\\nCREATE INDEX IF NOT EXISTS idx_relationships_person_a ON public.relationships(person_a);\\r\\nCREATE INDEX IF NOT EXISTS idx_relationships_person_b ON public.relationships(person_b);\\r\\nCREATE INDEX IF NOT EXISTS idx_relationships_type ON public.relationships(type);\\r\\n\\r\\n-- Person filtering and sorting\\r\\nCREATE INDEX IF NOT EXISTS idx_persons_full_name ON public.persons(full_name);\\r\\nCREATE INDEX IF NOT EXISTS idx_persons_generation ON public.persons(generation);\\r\\nCREATE INDEX IF NOT EXISTS idx_persons_gender ON public.persons(gender);\\r\\nCREATE INDEX IF NOT EXISTS idx_persons_is_deceased ON public.persons(is_deceased);\\r\\nCREATE INDEX IF NOT EXISTS idx_persons_birth_year ON public.persons(birth_year);\\r\\n\\r\\n-- Profile lookups\\r\\nCREATE INDEX IF NOT EXISTS idx_profiles_role ON public.profiles(role);\\r\\nCREATE INDEX IF NOT EXISTS idx_profiles_is_active ON public.profiles(is_active);\\r\\n\\r\\n-- Custom events lookups\\r\\nCREATE INDEX IF NOT EXISTS idx_custom_events_date ON public.custom_events(event_date);\\r\\nCREATE INDEX IF NOT EXISTS idx_custom_events_created_by ON public.custom_events(created_by);\\r\\n\\r\\n-- ==========================================\\r\\n-- RLS POLICIES\\r\\n-- ==========================================\\r\\n\\r\\nALTER TABLE public.profiles ENABLE ROW LEVEL SECURITY;\\r\\nALTER TABLE public.persons ENABLE ROW LEVEL SECURITY;\\r\\nALTER TABLE public.person_details_private ENABLE ROW LEVEL SECURITY;\\r\\nALTER TABLE public.relationships ENABLE ROW LEVEL SECURITY;\\r\\n\\r\\n-- Helper function to check if user is admin\\r\\nCREATE OR REPLACE FUNCTION public.is_admin()\\r\\nRETURNS BOOLEAN AS $$\\r\\nBEGIN\\r\\n  RETURN EXISTS (\\r\\n    SELECT 1 FROM public.profiles\\r\\n    WHERE id = auth.uid() AND role = 'admin'\\r\\n  );\\r\\nEND;\\r\\n$$ LANGUAGE plpgsql SECURITY DEFINER;\\r\\n\\r\\n-- Helper function to check if user is editor\\r\\nCREATE OR REPLACE FUNCTION PUBLIC.IS_EDITOR()\\r\\nRETURNS BOOLEAN\\r\\nLANGUAGE PLPGSQL\\r\\nSECURITY DEFINER\\r\\nSET SEARCH_PATH = PUBLIC\\r\\nAS $$\\r\\nBEGIN\\r\\n  RETURN EXISTS (\\r\\n    SELECT 1 FROM public.profiles\\r\\n    WHERE id = auth.uid() AND role = 'editor'\\r\\n  );\\r\\nEND;\\r\\n$$;\\r\\nrevoke all on function public.is_editor() from public;\\r\\ngrant execute on function public.is_editor() to authenticated;\\r\\n\\r\\n-- PROFILES POLICIES\\r\\nDROP POLICY IF EXISTS \\\"Users can view own profile\\\" ON public.profiles;\\r\\nCREATE POLICY \\\"Users can view own profile\\\" ON public.profiles FOR SELECT USING (auth.uid() = id);\\r\\n\\r\\nDROP POLICY IF EXISTS \\\"Admins can view all profiles\\\" ON public.profiles;\\r\\nCREATE POLICY \\\"Admins can view all profiles\\\" ON public.profiles FOR SELECT USING (public.is_admin());\\r\\n\\r\\n-- PERSONS POLICIES\\r\\nDROP POLICY IF EXISTS \\\"Enable read access for authenticated users\\\" ON public.persons;\\r\\nCREATE POLICY \\\"Enable read access for authenticated users\\\" ON public.persons FOR SELECT TO authenticated USING (true);\\r\\n\\r\\nDROP POLICY IF EXISTS \\\"Admins can manage persons\\\" ON public.persons;\\r\\nDROP POLICY IF EXISTS \\\"Admins can insert persons\\\" ON public.persons;\\r\\nDROP POLICY IF EXISTS \\\"Admins can update persons\\\" ON public.persons;\\r\\nDROP POLICY IF EXISTS \\\"Admins can delete persons\\\" ON public.persons;\\r\\n\\r\\nCREATE POLICY \\\"Admins and Editors can insert persons\\\" ON public.persons FOR INSERT TO authenticated WITH CHECK (public.is_admin() OR public.is_editor());\\r\\nCREATE POLICY \\\"Admins and Editors can update persons\\\" ON public.persons FOR UPDATE TO authenticated USING (public.is_admin() OR public.is_editor()) WITH CHECK (public.is_admin() OR public.is_editor());\\r\\nCREATE POLICY \\\"Admins and Editors can delete persons\\\" ON public.persons FOR DELETE TO authenticated USING (public.is_admin() OR public.is_editor());\\r\\n\\r\\n-- PERSON_DETAILS_PRIVATE POLICIES\\r\\nDROP POLICY IF EXISTS \\\"Admins can view private details\\\" ON public.person_details_private;\\r\\nCREATE POLICY \\\"Admins can view private details\\\" ON public.person_details_private FOR SELECT TO authenticated USING (public.is_admin());\\r\\n\\r\\nDROP POLICY IF EXISTS \\\"Admins can manage private details\\\" ON public.person_details_private;\\r\\nCREATE POLICY \\\"Admins can manage private details\\\" ON public.person_details_private FOR ALL TO authenticated USING (public.is_admin());\\r\\n\\r\\n-- RELATIONSHIPS POLICIES\\r\\nDROP POLICY IF EXISTS \\\"Enable read access for authenticated users\\\" ON public.relationships;\\r\\nCREATE POLICY \\\"Enable read access for authenticated users\\\" ON public.relationships FOR SELECT TO authenticated USING (true);\\r\\n\\r\\nDROP POLICY IF EXISTS \\\"Admins can manage relationships\\\" ON public.relationships;\\r\\nDROP POLICY IF EXISTS \\\"Admins can insert relationships\\\" ON public.relationships;\\r\\nDROP POLICY IF EXISTS \\\"Admins can update relationships\\\" ON public.relationships;\\r\\nDROP POLICY IF EXISTS \\\"Admins can delete relationships\\\" ON public.relationships;\\r\\n\\r\\nCREATE POLICY \\\"Admins and Editors can insert relationships\\\" ON public.relationships FOR INSERT TO authenticated WITH CHECK (public.is_admin() OR public.is_editor());\\r\\nCREATE POLICY \\\"Admins and Editors can update relationships\\\" ON public.relationships FOR UPDATE TO authenticated USING (public.is_admin() OR public.is_editor()) WITH CHECK (public.is_admin() OR public.is_editor());\\r\\nCREATE POLICY \\\"Admins and Editors can delete relationships\\\" ON public.relationships FOR DELETE TO authenticated USING (public.is_admin() OR public.is_editor());\\r\\n\\r\\n-- CUSTOM_EVENTS POLICIES\\r\\nALTER TABLE public.custom_events ENABLE ROW LEVEL SECURITY;\\r\\n\\r\\nDROP POLICY IF EXISTS \\\"Enable read access for authenticated users\\\" ON public.custom_events;\\r\\nCREATE POLICY \\\"Enable read access for authenticated users\\\" ON public.custom_events FOR SELECT TO authenticated USING (true);\\r\\n\\r\\nDROP POLICY IF EXISTS \\\"Authenticated users can insert custom events\\\" ON public.custom_events;\\r\\nCREATE POLICY \\\"Authenticated users can insert custom events\\\" ON public.custom_events FOR INSERT TO authenticated WITH CHECK (auth.uid() = created_by);\\r\\n\\r\\nDROP POLICY IF EXISTS \\\"Users can update own custom events\\\" ON public.custom_events;\\r\\nCREATE POLICY \\\"Users can update own custom events\\\" ON public.custom_events FOR UPDATE TO authenticated USING (auth.uid() = created_by OR public.is_admin());\\r\\n\\r\\nDROP POLICY IF EXISTS \\\"Users can delete own custom events\\\" ON public.custom_events;\\r\\nCREATE POLICY \\\"Users can delete own custom events\\\" ON public.custom_events FOR DELETE TO authenticated USING (auth.uid() = created_by OR public.is_admin());\\r\\n\\r\\n-- ==========================================\\r\\n-- TRIGGERS\\r\\n-- ==========================================\\r\\n\\r\\n-- 1. Updated At Triggers\\r\\nDROP TRIGGER IF EXISTS tr_profiles_updated_at ON public.profiles;\\r\\nCREATE TRIGGER tr_profiles_updated_at BEFORE UPDATE ON public.profiles FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\\r\\n\\r\\nDROP TRIGGER IF EXISTS tr_persons_updated_at ON public.persons;\\r\\nCREATE TRIGGER tr_persons_updated_at BEFORE UPDATE ON public.persons FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\\r\\n\\r\\nDROP TRIGGER IF EXISTS tr_person_details_private_updated_at ON public.person_details_private;\\r\\nCREATE TRIGGER tr_person_details_private_updated_at BEFORE UPDATE ON public.person_details_private FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\\r\\n\\r\\nDROP TRIGGER IF EXISTS tr_relationships_updated_at ON public.relationships;\\r\\nCREATE TRIGGER tr_relationships_updated_at BEFORE UPDATE ON public.relationships FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\\r\\n\\r\\nDROP TRIGGER IF EXISTS tr_custom_events_updated_at ON public.custom_events;\\r\\nCREATE TRIGGER tr_custom_events_updated_at BEFORE UPDATE ON public.custom_events FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\\r\\n\\r\\n-- 2. Handle new user signup (Profile creation)\\r\\nCREATE OR REPLACE FUNCTION public.handle_new_user()\\r\\nRETURNS trigger \\r\\nLANGUAGE plpgsql\\r\\nSECURITY DEFINER SET search_path = public, auth\\r\\nAS $$\\r\\nDECLARE\\r\\n  is_first_user boolean;\\r\\nBEGIN\\r\\n  -- Check if this is the first user (count will be 1 as this is AFTER INSERT)\\r\\n  SELECT count(*) = 1 FROM auth.users INTO is_first_user;\\r\\n\\r\\n  INSERT INTO public.profiles (id, role, is_active)\\r\\n  VALUES (\\r\\n    new.id, \\r\\n    CASE WHEN is_first_user THEN 'admin'::public.user_role_enum ELSE 'member'::public.user_role_enum END,\\r\\n    true\\r\\n  );\\r\\n\\r\\n  UPDATE public.profiles \\r\\n  SET is_active = true \\r\\n  WHERE id = new.id AND is_first_user = true;\\r\\n\\r\\n  RETURN new;\\r\\nEND;\\r\\n$$;\\r\\n\\r\\n-- 3. Auto-confirm first user (Email verification)\\r\\nCREATE OR REPLACE FUNCTION public.handle_first_user_confirmation()\\r\\nRETURNS trigger\\r\\nLANGUAGE plpgsql\\r\\nSECURITY DEFINER SET search_path = auth\\r\\nAS $$\\r\\nBEGIN\\r\\n  -- If no users exist yet, auto-confirm this first one\\r\\n  IF NOT EXISTS (SELECT 1 FROM auth.users) THEN\\r\\n    NEW.email_confirmed_at := NOW();\\r\\n    NEW.last_sign_in_at := NOW();\\r\\n  END IF;\\r\\n  RETURN NEW;\\r\\nEND;\\r\\n$$;\\r\\n\\r\\n-- Trigger for profile creation\\r\\nDROP TRIGGER IF EXISTS on_auth_user_created ON auth.users;\\r\\nCREATE TRIGGER on_auth_user_created\\r\\n  AFTER INSERT ON auth.users\\r\\n  FOR EACH ROW EXECUTE PROCEDURE public.handle_new_user();\\r\\n\\r\\n-- Trigger for auto-confirmation\\r\\nDROP TRIGGER IF EXISTS on_auth_user_created_confirm ON auth.users;\\r\\nCREATE TRIGGER on_auth_user_created_confirm\\r\\n  BEFORE INSERT ON auth.users\\r\\n  FOR EACH ROW EXECUTE PROCEDURE public.handle_first_user_confirmation();\\r\\n\\r\\n-- ==========================================\\r\\n-- STORAGE POLICIES\\r\\n-- ==========================================\\r\\n\\r\\n-- Initialize 'avatars' bucket\\r\\nINSERT INTO storage.buckets (id, name, public) \\r\\nVALUES ('avatars', 'avatars', true) \\r\\nON CONFLICT (id) DO UPDATE SET public = true;\\r\\n\\r\\nDROP POLICY IF EXISTS \\\"Avatar images are publicly accessible.\\\" ON storage.objects;\\r\\nCREATE POLICY \\\"Avatar images are publicly accessible.\\\" ON storage.objects FOR SELECT USING ( bucket_id = 'avatars' );\\r\\n\\r\\nDROP POLICY IF EXISTS \\\"Users can upload avatars.\\\" ON storage.objects;\\r\\nCREATE POLICY \\\"Users can upload avatars.\\\" ON storage.objects FOR INSERT WITH CHECK ( bucket_id = 'avatars' AND auth.role() = 'authenticated' );\\r\\n\\r\\nDROP POLICY IF EXISTS \\\"Users can update avatars.\\\" ON storage.objects;\\r\\nCREATE POLICY \\\"Users can update avatars.\\\" ON storage.objects FOR UPDATE USING ( bucket_id = 'avatars' AND auth.role() = 'authenticated' );\\r\\n\\r\\nDROP POLICY IF EXISTS \\\"Users can delete avatars.\\\" ON storage.objects;\\r\\nCREATE POLICY \\\"Users can delete avatars.\\\" ON storage.objects FOR DELETE USING ( bucket_id = 'avatars' AND auth.role() = 'authenticated' );\\r\\n\\r\\n-- ==========================================\\r\\n-- ADMIN RPC FUNCTIONS\\r\\n-- ==========================================\\r\\n\\r\\n-- Custom type for get_admin_users\\r\\nDROP TYPE IF EXISTS public.admin_user_data CASCADE;\\r\\nCREATE TYPE public.admin_user_data AS (\\r\\n    id uuid,\\r\\n    email text,\\r\\n    role public.user_role_enum,\\r\\n    created_at timestamptz,\\r\\n    is_active boolean\\r\\n);\\r\\n\\r\\n-- 1. Get List of Users for Admin\\r\\nCREATE OR REPLACE FUNCTION public.get_admin_users()\\r\\nRETURNS SETOF public.admin_user_data\\r\\nLANGUAGE plpgsql\\r\\nSECURITY DEFINER\\r\\nSET search_path = public, auth\\r\\nAS $$\\r\\nBEGIN\\r\\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\\r\\n        RAISE EXCEPTION 'Access denied.';\\r\\n    END IF;\\r\\n\\r\\n    RETURN QUERY\\r\\n    SELECT au.id, au.email::text, p.role, au.created_at, p.is_active\\r\\n    FROM auth.users au\\r\\n    LEFT JOIN public.profiles p ON au.id = p.id\\r\\n    ORDER BY au.created_at DESC;\\r\\nEND;\\r\\n$$;\\r\\n\\r\\n-- 2. Update User Role\\r\\nCREATE OR REPLACE FUNCTION public.set_user_role(target_user_id uuid, new_role text)\\r\\nRETURNS void\\r\\nLANGUAGE plpgsql\\r\\nSECURITY DEFINER\\r\\nSET search_path = public, auth\\r\\nAS $$\\r\\nBEGIN\\r\\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\\r\\n        RAISE EXCEPTION 'Access denied.';\\r\\n    END IF;\\r\\n\\r\\n    UPDATE public.profiles\\r\\n    SET role = new_role::public.user_role_enum\\r\\n    WHERE id = target_user_id;\\r\\nEND;\\r\\n$$;\\r\\n\\r\\n-- 3. Delete User Account\\r\\nCREATE OR REPLACE FUNCTION public.delete_user(target_user_id uuid)\\r\\nRETURNS void\\r\\nLANGUAGE plpgsql\\r\\nSECURITY DEFINER\\r\\nSET search_path = public, auth\\r\\nAS $$\\r\\nBEGIN\\r\\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\\r\\n        RAISE EXCEPTION 'Access denied.';\\r\\n    END IF;\\r\\n    \\r\\n    IF auth.uid() = target_user_id THEN\\r\\n        RAISE EXCEPTION 'Cannot delete yourself.';\\r\\n    END IF;\\r\\n\\r\\n    DELETE FROM auth.users WHERE id = target_user_id;\\r\\nEND;\\r\\n$$;\\r\\n\\r\\n-- 4. Admin Create New User\\r\\n-- IMPORTANT: All token/string columns MUST be set to '' (empty string), NOT NULL.\\r\\n-- Supabase Auth's Go scanner crashes with \\\"converting NULL to string is unsupported\\\"\\r\\n-- if any of these fields are NULL.\\r\\nCREATE OR REPLACE FUNCTION public.admin_create_user(\\r\\n  new_email text, \\r\\n  new_password text, \\r\\n  new_role text,\\r\\n  new_active boolean\\r\\n)\\r\\n RETURNS uuid\\r\\n LANGUAGE plpgsql\\r\\n SECURITY DEFINER\\r\\n SET search_path TO 'public', 'auth', 'extensions'\\r\\nAS $function$\\r\\nDECLARE\\r\\n    new_id uuid;\\r\\nBEGIN\\r\\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\\r\\n        RAISE EXCEPTION 'Access denied.';\\r\\n    END IF;\\r\\n\\r\\n    new_id := gen_random_uuid();\\r\\n\\r\\n    INSERT INTO auth.users (\\r\\n        id, instance_id, aud, role, email, encrypted_password, \\r\\n        email_confirmed_at,         -- Auto-verify: skip email confirmation\\r\\n        confirmation_token,         -- Must be '' not NULL (Supabase Auth Go scanner)\\r\\n        recovery_token,             -- Must be '' not NULL\\r\\n        email_change_token_new,     -- Must be '' not NULL\\r\\n        email_change_token_current, -- Must be '' not NULL\\r\\n        reauthentication_token,     -- Must be '' not NULL\\r\\n        email_change,               -- Must be '' not NULL\\r\\n        phone_change,               -- Must be '' not NULL\\r\\n        phone_change_token,         -- Must be '' not NULL\\r\\n        raw_app_meta_data, raw_user_meta_data, created_at, updated_at\\r\\n    )\\r\\n    VALUES (\\r\\n        new_id, '00000000-0000-0000-0000-000000000000', 'authenticated', 'authenticated',\\r\\n        new_email, extensions.crypt(new_password, extensions.gen_salt('bf')),\\r\\n        now(),\\r\\n        '', '', '', '', '', '', '', '',\\r\\n        '{\\\"provider\\\":\\\"email\\\",\\\"providers\\\":[\\\"email\\\"]}', '{}', now(), now()\\r\\n    );\\r\\n\\r\\n    INSERT INTO public.profiles (id, role, is_active, created_at, updated_at)\\r\\n    VALUES (new_id, new_role::public.user_role_enum, new_active, now(), now())\\r\\n    ON CONFLICT (id) DO UPDATE SET role = EXCLUDED.role, is_active = EXCLUDED.is_active;\\r\\n    \\r\\n    RETURN new_id;\\r\\nEND;\\r\\n$function$;\\r\\n\\r\\n-- 5. Set User Active Status (Approve/Block)\\r\\nCREATE OR REPLACE FUNCTION public.set_user_active_status(target_user_id uuid, new_status boolean)\\r\\nRETURNS void\\r\\nLANGUAGE plpgsql\\r\\nSECURITY DEFINER\\r\\nSET search_path = public, auth\\r\\nAS $$\\r\\nBEGIN\\r\\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\\r\\n        RAISE EXCEPTION 'Access denied.';\\r\\n    END IF;\\r\\n\\r\\n    UPDATE public.profiles\\r\\n    SET is_active = new_status\\r\\n    WHERE id = target_user_id;\\r\\nEND;\\r\\n$$;\\r\\n\"])</script><script>self.__next_f.push([1,\"13:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"col-span-1 border border-stone-200 rounded-2xl overflow-hidden bg-[#1e1e1e] flex flex-col h-[400px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"bg-[#2d2d2d] px-4 py-2 flex items-center justify-between border-b border-stone-800\\\",\\\"children\\\":[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-stone-400 text-xs font-mono\\\",\\\"children\\\":\\\"docs/schema.sql\\\"}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"p-4 overflow-y-auto w-full flex-grow custom-scrollbar\\\",\\\"children\\\":[\\\"$\\\",\\\"pre\\\",null,{\\\"className\\\":\\\"text-xs sm:text-sm font-mono text-stone-300 leading-relaxed whitespace-pre\\\",\\\"children\\\":[\\\"$\\\",\\\"code\\\",null,{\\\"children\\\":\\\"$16\\\"}]}]}]]}]\\n14:[\\\"$\\\",\\\"$L17\\\",null,{\\\"href\\\":\\\"/login\\\",\\\"className\\\":\\\"absolute top-6 left-6 z-20 flex items-center gap-2 text-stone-500 hover:text-stone-900 font-semibold text-sm transition-all duration-300 bg-white/60 px-5 py-2.5 rounded-full shadow-sm border border-stone-200 hover:border-stone-300 hover:shadow-md\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L10\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":[[\\\"path\\\",{\\\"d\\\":\\\"m12 19-7-7 7-7\\\",\\\"key\\\":\\\"1l729n\\\"}],[\\\"path\\\",{\\\"d\\\":\\\"M19 12H5\\\",\\\"key\\\":\\\"x3x0zl\\\"}]],\\\"className\\\":\\\"lucide-arrow-left size-4\\\"}],\\\"Quay lại Đăng nhập\\\"]}]\\n15:[\\\"$\\\",\\\"footer\\\",null,{\\\"className\\\":\\\"py-8 text-center text-sm text-stone-500 bg-transparent border-none mt-auto relative z-10 backdrop-blur-sm\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"max-w-7xl mx-auto px-4\\\",\\\"children\\\":[false,[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"flex items-center justify-center gap-2 opacity-80 hover:opacity-100 transition-opacity\\\",\\\"children\\\":[[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://github.com/homielab/giapha-os\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noopener noreferrer\\\",\\\"className\\\":\\\"font-semibold text-stone-600 hover:text-amber-700 transition-colors inline-flex items-center gap-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"width\\\":\\\"16\\\",\\\"height\\\":\\\"16\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":\\\"2\\\",\\\"fill\\\":\\\"none\\\",\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"children\\\":[\\\"$\\\",\\\"path\\\",null,{\\\"d\\\":\\\"M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22\\\"}]}],\\\"Gia Phả OS\\\"]}],\\\"by\\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://homielab.com\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noopener noreferrer\\\",\\\"className\\\":\\\"font-semibold text-green-600 hover:text-amber-700 transition-colors inline-flex items-center gap-1.5\\\",\\\"children\\\":\\\"HomieLab\\\"}]]}]]}]}]\\n\"])</script></body></html>","rsc":"1:\"$Sreact.fragment\"\n2:I[39756,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\"],\"default\"]\n3:I[37457,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\"],\"default\"]\n5:I[97367,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\"],\"OutletBoundary\"]\n6:\"$Sreact.suspense\"\n9:I[97367,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\"],\"ViewportBoundary\"]\nb:I[97367,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\"],\"MetadataBoundary\"]\nd:I[68027,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\"],\"default\",1]\n:HL[\"/_next/static/chunks/0qa855wvp2uv9.css\",\"style\"]\n:HL[\"/_next/static/chunks/0xc7eu11bieu_.css\",\"style\"]\n:HL[\"/_next/static/media/14e23f9b59180572-s.p.08.c8psu~gif9.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/2a65768255d6b625-s.p.14by5b4al-y~f.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/2bbe8d2671613f1f-s.p.067x_6k0k23tk.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/83afe278b6a6bb3c-s.p.0q-301v4kxxnr.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n0:{\"P\":null,\"c\":[\"\",\"setup\"],\"q\":\"\",\"i\":false,\"f\":[[[\"\",{\"children\":[\"setup\",{\"children\":[\"__PAGE__\",{}]}]},\"$undefined\",\"$undefined\",16],[[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/0qa855wvp2uv9.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}],[\"$\",\"link\",\"1\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/0xc7eu11bieu_.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/01xlw8hd842-c.js\",\"async\":true,\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/0d3shmwh5_nmn.js\",\"async\":true,\"nonce\":\"$undefined\"}]],[\"$\",\"html\",null,{\"lang\":\"vi\",\"children\":[\"$\",\"body\",null,{\"className\":\"inter_f20e379b-module__TWS8mW__variable playfair_display_c88dccb7-module__wLnm0q__variable font-sans antialiased relative\",\"children\":[\"$\",\"$L2\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L3\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":[[[\"$\",\"title\",null,{\"children\":\"404: This page could not be found.\"}],[\"$\",\"div\",null,{\"style\":{\"fontFamily\":\"system-ui,\\\"Segoe UI\\\",Roboto,Helvetica,Arial,sans-serif,\\\"Apple Color Emoji\\\",\\\"Segoe UI Emoji\\\"\",\"height\":\"100vh\",\"textAlign\":\"center\",\"display\":\"flex\",\"flexDirection\":\"column\",\"alignItems\":\"center\",\"justifyContent\":\"center\"},\"children\":[\"$\",\"div\",null,{\"children\":[[\"$\",\"style\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}\"}}],[\"$\",\"h1\",null,{\"className\":\"next-error-h1\",\"style\":{\"display\":\"inline-block\",\"margin\":\"0 20px 0 0\",\"padding\":\"0 23px 0 0\",\"fontSize\":24,\"fontWeight\":500,\"verticalAlign\":\"top\",\"lineHeight\":\"49px\"},\"children\":404}],[\"$\",\"div\",null,{\"style\":{\"display\":\"inline-block\"},\"children\":[\"$\",\"h2\",null,{\"style\":{\"fontSize\":14,\"fontWeight\":400,\"lineHeight\":\"49px\",\"margin\":0},\"children\":\"This page could not be found.\"}]}]]}]}]],[]],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]}]}]]}],{\"children\":[[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L2\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L3\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}],{\"children\":[[\"$\",\"$1\",\"c\",{\"children\":[\"$L4\",[[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/10gp4~2wc-iyp.js\",\"async\":true,\"nonce\":\"$undefined\"}]],[\"$\",\"$L5\",null,{\"children\":[\"$\",\"$6\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@7\"}]}]]}],{},null,false,null]},null,false,\"$@8\"]},null,false,null],[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L9\",null,{\"children\":\"$La\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$Lb\",null,{\"children\":[\"$\",\"$6\",null,{\"name\":\"Next.Metadata\",\"children\":\"$Lc\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}],false]],\"m\":\"$undefined\",\"G\":[\"$d\",[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/0qa855wvp2uv9.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}],[\"$\",\"link\",\"1\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/0xc7eu11bieu_.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]]],\"S\":true,\"h\":null,\"s\":\"$undefined\",\"l\":\"$undefined\",\"p\":\"$undefined\",\"d\":\"$undefined\",\"b\":\"WOoep__bZIeFRofyAsxc8\"}\ne:[]\n8:\"$We\"\na:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:I[27201,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\"],\"IconMark\"]\n7:null\nc:[[\"$\",\"title\",\"0\",{\"children\":\"Gia Phả OS\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Gia Phả OS\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico?favicon.0cbu-oy3ga.gt.ico\",\"sizes\":\"48x48\",\"type\":\"image/x-icon\"}],[\"$\",\"$Lf\",\"3\",{}]]\n10:I[58541,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\",\"/_next/static/chunks/10gp4~2wc-iyp.js\"],\"default\"]\n11:I[42593,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\",\"/_next/static/chunks/10gp4~2wc-iyp.js\"],\"default\"]\n12:T48e5,-- ==========================================\r\n-- GIAPHA-OS DATABASE SCHEMA\r\n-- ==========================================\r\n\r\n-- EXTENSIONS\r\nCREATE EXTENSION IF NOT EXISTS pgcrypto WITH SCHEMA extensions;\r\n\r\n-- ENUMS\r\n-- Gender types for family members\r\nDO $$ BEGIN\r\n    CREATE TYPE public.gender_enum AS ENUM ('male', 'female', 'other');\r\nEXCEPTION\r\n    WHEN duplicate_object THEN null;\r\nEND $$;\r\n\r\n-- Relationship types between family members\r\nDO $$ BEGIN\r\n    CREATE TYPE public.relationship_type_enum AS ENUM ('marriage', 'biological_child', 'adopted_child');\r\nEXCEPTION\r\n    WHEN duplicate_object THEN null;\r\nEND $$;\r\n\r\n-- System user roles\r\nDO $$ BEGIN\r\n    CREATE TYPE public.user_role_enum AS ENUM ('admin', 'editor', 'member');\r\nEXCEPTION\r\n    WHEN duplicate_object THEN null;\r\nEND $$;\r\n\r\n-- ==========================================\r\n-- UTILITY FUNCTIONS\r\n-- ==========================================\r\n\r\n-- Function to automatically update 'updated_at' timestamps\r\nCREATE OR REPLACE FUNCTION public.handle_updated_at()\r\nRETURNS TRIGGER AS $$\r\nBEGIN\r\n  NEW.updated_at = NOW();\r\n  RETURN NEW;\r\nEND;\r\n$$ LANGUAGE plpgsql;\r\n\r\n-- ==========================================\r\n-- TABLES (Data Preservation: No DROP TABLE commands)\r\n-- ==========================================\r\n\r\n-- PROFILES (Application users linked to Auth)\r\nCREATE TABLE IF NOT EXISTS public.profiles (\r\n  id UUID REFERENCES auth.users(id) ON DELETE CASCADE PRIMARY KEY,\r\n  role public.user_role_enum DEFAULT 'member' NOT NULL,\r\n  is_active BOOLEAN NOT NULL DEFAULT false,\r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW()\r\n);\r\n\r\n-- PERSONS (Core entity for family tree)\r\nCREATE TABLE IF NOT EXISTS public.persons (\r\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\r\n  full_name TEXT NOT NULL,\r\n  gender public.gender_enum NOT NULL,\r\n  \r\n  -- Date components (allows for partial dates where only year is known)\r\n  birth_year INT,\r\n  birth_month INT,\r\n  birth_day INT,\r\n  death_year INT,\r\n  death_month INT,\r\n  death_day INT,\r\n  death_lunar_year INT,\r\n  death_lunar_month INT,\r\n  death_lunar_day INT,\r\n  \r\n  is_deceased BOOLEAN NOT NULL DEFAULT FALSE,\r\n  is_in_law BOOLEAN NOT NULL DEFAULT FALSE,\r\n  birth_order INT,\r\n  generation INT,\r\n  other_names TEXT,\r\n  avatar_url TEXT,\r\n  note TEXT,\r\n  \r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW()\r\n);\r\n\r\n-- PERSON_DETAILS_PRIVATE (Sensitive data with restricted RLS)\r\nCREATE TABLE IF NOT EXISTS public.person_details_private (\r\n  person_id UUID REFERENCES public.persons(id) ON DELETE CASCADE PRIMARY KEY,\r\n  phone_number TEXT,\r\n  occupation TEXT,\r\n  current_residence TEXT,\r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW()\r\n);\r\n\r\n-- RELATIONSHIPS (Links between persons)\r\nCREATE TABLE IF NOT EXISTS public.relationships (\r\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\r\n  type public.relationship_type_enum NOT NULL,\r\n  person_a UUID REFERENCES public.persons(id) ON DELETE CASCADE NOT NULL,\r\n  person_b UUID REFERENCES public.persons(id) ON DELETE CASCADE NOT NULL,\r\n  note TEXT,\r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW(),\r\n  \r\n  -- Prevent self-relationships\r\n  CONSTRAINT no_self_relationship CHECK (person_a != person_b),\r\n  \r\n  -- Ensure unique relationships between pairs for a specific type\r\n  UNIQUE(person_a, person_b, type)\r\n);\r\n\r\n-- CUSTOM_EVENTS (User-created events)\r\nCREATE TABLE IF NOT EXISTS public.custom_events (\r\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\r\n  name TEXT NOT NULL,\r\n  content TEXT,\r\n  event_date DATE NOT NULL,\r\n  location TEXT,\r\n  created_by UUID REFERENCES public.profiles(id) DEFAULT auth.uid(),\r\n  \r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW()\r\n);\r\n\r\n-- ==========================================\r\n-- INDEXES\r\n-- ==========================================\r\n\r\n-- Relationship lookups\r\nCREATE INDEX IF NOT EXISTS idx_relationships_person_a ON public.relationships(person_a);\r\nCREATE INDEX IF NOT EXISTS idx_relationships_person_b ON public.relationships(person_b);\r\nCREATE INDEX IF NOT EXISTS idx_relationships_type ON public.relationships(type);\r\n\r\n-- Person filtering and sorting\r\nCREATE INDEX IF NOT EXISTS idx_persons_full_name ON public.persons(full_name);\r\nCREATE INDEX IF NOT EXISTS idx_persons_generation ON public.persons(generation);\r\nCREATE INDEX IF NOT EXISTS idx_persons_gender ON public.persons(gender);\r\nCREATE INDEX IF NOT EXISTS idx_persons_is_deceased ON public.persons(is_deceased);\r\nCREATE INDEX IF NOT EXISTS idx_persons_birth_year ON public.persons(birth_year);\r\n\r\n-- Profile lookups\r\nCREATE INDEX IF NOT EXISTS idx_profiles_role ON public.profiles(role);\r\nCREATE INDEX IF NOT EXISTS idx_profiles_is_active ON public.profiles(is_active);\r\n\r\n-- Custom events lookups\r\nCREATE INDEX IF NOT EXISTS idx_custom_events_date ON public.custom_events(event_date);\r\nCREATE INDEX IF NOT EXISTS idx_custom_events_created_by ON public.custom_events(created_by);\r\n\r\n-- ==========================================\r\n-- RLS POLICIES\r\n-- ==========================================\r\n\r\nALTER TABLE public.profiles ENABLE ROW LEVEL SECURITY;\r\nALTER TABLE public.persons ENABLE ROW LEVEL SECURITY;\r\nALTER TABLE public.person_details_private ENABLE ROW LEVEL SECURITY;\r\nALTER TABLE public.relationships ENABLE ROW LEVEL SECURITY;\r\n\r\n-- Helper function to check if user is admin\r\nCREATE OR REPLACE FUNCTION public.is_admin()\r\nRETURNS BOOLEAN AS $$\r\nBEGIN\r\n  RETURN EXISTS (\r\n    SELECT 1 FROM public.profiles\r\n    WHERE id = auth.uid() AND role = 'admin'\r\n  );\r\nEND;\r\n$$ LANGUAGE plpgsql SECURITY DEFINER;\r\n\r\n-- Helper function to check if user is editor\r\nCREATE OR REPLACE FUNCTION PUBLIC.IS_EDITOR()\r\nRETURNS BOOLEAN\r\nLANGUAGE PLPGSQL\r\nSECURITY DEFINER\r\nSET SEARCH_PATH = PUBLIC\r\nAS $$\r\nBEGIN\r\n  RETURN EXISTS (\r\n    SELECT 1 FROM public.profiles\r\n    WHERE id = auth.uid() AND role = 'editor'\r\n  );\r\nEND;\r\n$$;\r\nrevoke all on function public.is_editor() from public;\r\ngrant execute on function public.is_editor() to authenticated;\r\n\r\n-- PROFILES POLICIES\r\nDROP POLICY IF EXISTS \"Users can view own profile\" ON public.profiles;\r\nCREATE POLICY \"Users can view own profile\" ON public.profiles FOR SELECT USING (auth.uid() = id);\r\n\r\nDROP POLICY IF EXISTS \"Admins can view all profiles\" ON public.profiles;\r\nCREATE POLICY \"Admins can view all profiles\" ON public.profiles FOR SELECT USING (public.is_admin());\r\n\r\n-- PERSONS POLICIES\r\nDROP POLICY IF EXISTS \"Enable read access for authenticated users\" ON public.persons;\r\nCREATE POLICY \"Enable read access for authenticated users\" ON public.persons FOR SELECT TO authenticated USING (true);\r\n\r\nDROP POLICY IF EXISTS \"Admins can manage persons\" ON public.persons;\r\nDROP POLICY IF EXISTS \"Admins can insert persons\" ON public.persons;\r\nDROP POLICY IF EXISTS \"Admins can update persons\" ON public.persons;\r\nDROP POLICY IF EXISTS \"Admins can delete persons\" ON public.persons;\r\n\r\nCREATE POLICY \"Admins and Editors can insert persons\" ON public.persons FOR INSERT TO authenticated WITH CHECK (public.is_admin() OR public.is_editor());\r\nCREATE POLICY \"Admins and Editors can update persons\" ON public.persons FOR UPDATE TO authenticated USING (public.is_admin() OR public.is_editor()) WITH CHECK (public.is_admin() OR public.is_editor());\r\nCREATE POLICY \"Admins and Editors can delete persons\" ON public.persons FOR DELETE TO authenticated USING (public.is_admin() OR public.is_editor());\r\n\r\n-- PERSON_DETAILS_PRIVATE POLICIES\r\nDROP POLICY IF EXISTS \"Admins can view private details\" ON public.person_details_private;\r\nCREATE POLICY \"Admins can view private details\" ON public.person_details_private FOR SELECT TO authenticated USING (public.is_admin());\r\n\r\nDROP POLICY IF EXISTS \"Admins can manage private details\" ON public.person_details_private;\r\nCREATE POLICY \"Admins can manage private details\" ON public.person_details_private FOR ALL TO authenticated USING (public.is_admin());\r\n\r\n-- RELATIONSHIPS POLICIES\r\nDROP POLICY IF EXISTS \"Enable read access for authenticated users\" ON public.relationships;\r\nCREATE POLICY \"Enable read access for authenticated users\" ON public.relationships FOR SELECT TO authenticated USING (true);\r\n\r\nDROP POLICY IF EXISTS \"Admins can manage relationships\" ON public.relationships;\r\nDROP POLICY IF EXISTS \"Admins can insert relationships\" ON public.relationships;\r\nDROP POLICY IF EXISTS \"Admins can update relationships\" ON public.relationships;\r\nDROP POLICY IF EXISTS \"Admins can delete relationships\" ON public.relationships;\r\n\r\nCREATE POLICY \"Admins and Editors can insert relationships\" ON public.relationships FOR INSERT TO authenticated WITH CHECK (public.is_admin() OR public.is_editor());\r\nCREATE POLICY \"Admins and Editors can update relationships\" ON public.relationships FOR UPDATE TO authenticated USING (public.is_admin() OR public.is_editor()) WITH CHECK (public.is_admin() OR public.is_editor());\r\nCREATE POLICY \"Admins and Editors can delete relationships\" ON public.relationships FOR DELETE TO authenticated USING (public.is_admin() OR public.is_editor());\r\n\r\n-- CUSTOM_EVENTS POLICIES\r\nALTER TABLE public.custom_events ENABLE ROW LEVEL SECURITY;\r\n\r\nDROP POLICY IF EXISTS \"Enable read access for authenticated users\" ON public.custom_events;\r\nCREATE POLICY \"Enable read access for authenticated users\" ON public.custom_events FOR SELECT TO authenticated USING (true);\r\n\r\nDROP POLICY IF EXISTS \"Authenticated users can insert custom events\" ON public.custom_events;\r\nCREATE POLICY \"Authenticated users can insert custom events\" ON public.custom_events FOR INSERT TO authenticated WITH CHECK (auth.uid() = created_by);\r\n\r\nDROP POLICY IF EXISTS \"Users can update own custom events\" ON public.custom_events;\r\nCREATE POLICY \"Users can update own custom events\" ON public.custom_events FOR UPDATE TO authenticated USING (auth.uid() = created_by OR public.is_admin());\r\n\r\nDROP POLICY IF EXISTS \"Users can delete own custom events\" ON public.custom_events;\r\nCREATE POLICY \"Users can delete own custom events\" ON public.custom_events FOR DELETE TO authenticated USING (auth.uid() = created_by OR public.is_admin());\r\n\r\n-- ==========================================\r\n-- TRIGGERS\r\n-- ==========================================\r\n\r\n-- 1. Updated At Triggers\r\nDROP TRIGGER IF EXISTS tr_profiles_updated_at ON public.profiles;\r\nCREATE TRIGGER tr_profiles_updated_at BEFORE UPDATE ON public.profiles FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\nDROP TRIGGER IF EXISTS tr_persons_updated_at ON public.persons;\r\nCREATE TRIGGER tr_persons_updated_at BEFORE UPDATE ON public.persons FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\nDROP TRIGGER IF EXISTS tr_person_details_private_updated_at ON public.person_details_private;\r\nCREATE TRIGGER tr_person_details_private_updated_at BEFORE UPDATE ON public.person_details_private FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\nDROP TRIGGER IF EXISTS tr_relationships_updated_at ON public.relationships;\r\nCREATE TRIGGER tr_relationships_updated_at BEFORE UPDATE ON public.relationships FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\nDROP TRIGGER IF EXISTS tr_custom_events_updated_at ON public.custom_events;\r\nCREATE TRIGGER tr_custom_events_updated_at BEFORE UPDATE ON public.custom_events FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\n-- 2. Handle new user signup (Profile creation)\r\nCREATE OR REPLACE FUNCTION public.handle_new_user()\r\nRETURNS trigger \r\nLANGUAGE plpgsql\r\nSECURITY DEFINER SET search_path = public, auth\r\nAS $$\r\nDECLARE\r\n  is_first_user boolean;\r\nBEGIN\r\n  -- Check if this is the first user (count will be 1 as this is AFTER INSERT)\r\n  SELECT count(*) = 1 FROM auth.users INTO is_first_user;\r\n\r\n  INSERT INTO public.profiles (id, role, is_active)\r\n  VALUES (\r\n    new.id, \r\n    CASE WHEN is_first_user THEN 'admin'::public.user_role_enum ELSE 'member'::public.user_role_enum END,\r\n    true\r\n  );\r\n\r\n  UPDATE public.profiles \r\n  SET is_active = true \r\n  WHERE id = new.id AND is_first_user = true;\r\n\r\n  RETURN new;\r\nEND;\r\n$$;\r\n\r\n-- 3. Auto-confirm first user (Email verification)\r\nCREATE OR REPLACE FUNCTION public.handle_first_user_confirmation()\r\nRETURNS trigger\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER SET search_path = auth\r\nAS $$\r\nBEGIN\r\n  -- If no users exist yet, auto-confirm this first one\r\n  IF NOT EXISTS (SELECT 1 FROM auth.users) THEN\r\n    NEW.email_confirmed_at := NOW();\r\n    NEW.last_sign_in_at := NOW();\r\n  END IF;\r\n  RETURN NEW;\r\nEND;\r\n$$;\r\n\r\n-- Trigger for profile creation\r\nDROP TRIGGER IF EXISTS on_auth_user_created ON auth.users;\r\nCREATE TRIGGER on_auth_user_created\r\n  AFTER INSERT ON auth.users\r\n  FOR EACH ROW EXECUTE PROCEDURE public.handle_new_user();\r\n\r\n-- Trigger for auto-confirmation\r\nDROP TRIGGER IF EXISTS on_auth_user_created_confirm ON auth.users;\r\nCREATE TRIGGER on_auth_user_created_confirm\r\n  BEFORE INSERT ON auth.users\r\n  FOR EACH ROW EXECUTE PROCEDURE public.handle_first_user_confirmation();\r\n\r\n-- ==========================================\r\n-- STORAGE POLICIES\r\n-- ==========================================\r\n\r\n-- Initialize 'avatars' bucket\r\nINSERT INTO storage.buckets (id, name, public) \r\nVALUES ('avatars', 'avatars', true) \r\nON CONFLICT (id) DO UPDATE SET public = true;\r\n\r\nDROP POLICY IF EXISTS \"Avatar images are publicly accessible.\" ON storage.objects;\r\nCREATE POLICY \"Avatar images are publicly accessible.\" ON storage.objects FOR SELECT USING ( bucket_id = 'avatars' );\r\n\r\nDROP POLICY IF EXISTS \"Users can upload avatars.\" ON storage.objects;\r\nCREATE POLICY \"Users can upload avatars.\" ON storage.objects FOR INSERT WITH CHECK ( bucket_id = 'avatars' AND auth.role() = 'authenticated' );\r\n\r\nDROP POLICY IF EXISTS \"Users can update avatars.\" ON storage.objects;\r\nCREATE POLICY \"Users can update avatars.\" ON storage.objects FOR UPDATE USING ( bucket_id = 'avatars' AND auth.role() = 'authenticated' );\r\n\r\nDROP POLICY IF EXISTS \"Users can delete avatars.\" ON storage.objects;\r\nCREATE POLICY \"Users can delete avatars.\" ON storage.objects FOR DELETE USING ( bucket_id = 'avatars' AND auth.role() = 'authenticated' );\r\n\r\n-- ==========================================\r\n-- ADMIN RPC FUNCTIONS\r\n-- ==========================================\r\n\r\n-- Custom type for get_admin_users\r\nDROP TYPE IF EXISTS public.admin_user_data CASCADE;\r\nCREATE TYPE public.admin_user_data AS (\r\n    id uuid,\r\n    email text,\r\n    role public.user_role_enum,\r\n    created_at timestamptz,\r\n    is_active boolean\r\n);\r\n\r\n-- 1. Get List of Users for Admin\r\nCREATE OR REPLACE FUNCTION public.get_admin_users()\r\nRETURNS SETOF public.admin_user_data\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER\r\nSET search_path = public, auth\r\nAS $$\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\r\n        RAISE EXCEPTION 'Access denied.';\r\n    END IF;\r\n\r\n    RETURN QUERY\r\n    SELECT au.id, au.email::text, p.role, au.created_at, p.is_active\r\n    FROM auth.users au\r\n    LEFT JOIN public.profiles p ON au.id = p.id\r\n    ORDER BY au.created_at DESC;\r\nEND;\r\n$$;\r\n\r\n-- 2. Update User Role\r\nCREATE OR REPLACE FUNCTION public.set_user_role(target_user_id uuid, new_role text)\r\nRETURNS void\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER\r\nSET search_path = public, auth\r\nAS $$\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\r\n        RAISE EXCEPTION 'Access denied.';\r\n    END IF;\r\n\r\n    UPDATE public.profiles\r\n    SET role = new_role::public.user_role_enum\r\n    WHERE id = target_user_id;\r\nEND;\r\n$$;\r\n\r\n-- 3. Delete User Account\r\nCREATE OR REPLACE FUNCTION public.delete_user(target_user_id uuid)\r\nRETURNS void\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER\r\nSET search_path = public, auth\r\nAS $$\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\r\n        RAISE EXCEPTION 'Access denied.';\r\n    END IF;\r\n    \r\n    IF auth.uid() = target_user_id THEN\r\n        RAISE EXCEPTION 'Cannot delete yourself.';\r\n    END IF;\r\n\r\n    DELETE FROM auth.users WHERE id = target_user_id;\r\nEND;\r\n$$;\r\n\r\n-- 4. Admin Create New User\r\n-- IMPORTANT: All token/string columns MUST be set to '' (empty string), NOT NULL.\r\n-- Supabase Auth's Go scanner crashes with \"converting NULL to string is unsupported\"\r\n-- if any of these fields are NULL.\r\nCREATE OR REPLACE FUNCTION public.admin_create_user(\r\n  new_email text, \r\n  new_password text, \r\n  new_role text,\r\n  new_active boolean\r\n)\r\n RETURNS uuid\r\n LANGUAGE plpgsql\r\n SECURITY DEFINER\r\n SET search_path TO 'public', 'auth', 'extensions'\r\nAS $function$\r\nDECLARE\r\n    new_id uuid;\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\r\n        RAISE EXCEPTION 'Access denied.';\r\n    END IF;\r\n\r\n    new_id := gen_random_uuid();\r\n\r\n    INSERT INTO auth.users (\r\n        id, instance_id, aud, role, email, encrypted_password, \r\n        email_confirmed_at,         -- Auto-verify: skip email confirmation\r\n        confirmation_token,         -- Must be '' not NULL (Supabase Auth Go scanner)\r\n        recovery_token,             -- Must be '' not NULL\r\n        email_change_token_new,     -- Must be '' not NULL\r\n        email_change_token_current, -- Must be '' not NULL\r\n        reauthentication_token,     -- Must be '' not NULL\r\n        email_change,               -- Must be '' not NULL\r\n        phone_change,               -- Must be '' not NULL\r\n        phone_change_token,         -- Must be '' not NULL\r\n        raw_app_meta_data, raw_user_meta_data, created_at, updated_at\r\n    )\r\n    VALUES (\r\n        new_id, '00000000-0000-0000-0000-000000000000', 'authenticated', 'authenticated',\r\n        new_email, extensions.crypt(new_password, extensions.gen_salt('bf')),\r\n        now(),\r\n        '', '', '', '', '', '', '', '',\r\n        '{\"provider\":\"email\",\"providers\":[\"email\"]}', '{}', now(), now()\r\n    );\r\n\r\n    INSERT INTO public.profiles (id, role, is_active, created_at, updated_at)\r\n    VALUES (new_id, new_role::public.user_role_enum, new_active, now(), now())\r\n    ON CONFLICT (id) DO UPDATE SET role = EXCLUDED.role, is_active = EXCLUDED.is_active;\r\n    \r\n    RETURN new_id;\r\nEND;\r\n$function$;\r\n\r\n-- 5. Set User Active Status (Approve/Block)\r\nCREATE OR REPLACE FUNCTION public.set_user_active_status(target_user_id uuid, new_status boolean)\r\nRETURNS void\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER\r\nSET search_path = public, auth\r\nAS $$\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\r\n        RAISE EXCEPTION 'Access denied.';\r\n    END IF;\r\n\r\n    UPDATE public.profiles\r\n    SET is_active = new_status\r\n    WHERE id = target_user_id;\r\nEND;\r\n$$;\r\n4:[\"$\",\"div\",null,{\"className\":\"min-h-screen flex flex-col bg-[#fafaf9] select-none selection:bg-amber-200 selection:text-amber-900 relative overflow-hidden\",\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute inset-0 bg-[linear-gradient(to_right,#80808008_1px,transparent_1px),linear-gradient(to_bottom,#80808008_1px,transparent_1px)] bg-size-[24px_24px] pointer-events-none\"}],[\"$\",\"div\",null,{\"className\":\"absolute top-0 inset-x-0 h-screen overflow-hidden pointer-events-none flex justify-center\",\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute top-[-10%] right-[-5%] w-[50vw] h-[50vw] max-w-[600px] max-h-[600px] bg-indigo-300/20 rounded-full blur-[100px] mix-blend-multiply\"}],[\"$\",\"div\",null,{\"className\":\"absolute bottom-[0%] left-[-10%] w-[60vw] h-[60vw] max-w-[800px] max-h-[800px] bg-teal-200/20 rounded-full blur-[120px] mix-blend-multiply\"}]]}],[\"$\",\"div\",null,{\"className\":\"flex-1 flex flex-col items-center px-4 py-12 relative z-10 w-full max-w-5xl mx-auto\",\"children\":[\"$\",\"div\",null,{\"className\":\"w-full bg-white p-8 sm:p-10 rounded-3xl shadow-xl border border-stone-200 relative overflow-hidden mb-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-4 mb-6\",\"children\":[[\"$\",\"div\",null,{\"className\":\"p-4 bg-indigo-50 text-indigo-600 rounded-2xl\",\"children\":[\"$\",\"$L10\",null,{\"ref\":\"$undefined\",\"iconNode\":[[\"ellipse\",{\"cx\":\"12\",\"cy\":\"5\",\"rx\":\"9\",\"ry\":\"3\",\"key\":\"msslwz\"}],[\"path\",{\"d\":\"M3 5V19A9 3 0 0 0 21 19V5\",\"key\":\"1wlel7\"}],[\"path\",{\"d\":\"M3 12A9 3 0 0 0 21 12\",\"key\":\"mv7ke4\"}]],\"className\":\"lucide-database size-8\"}]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-bold text-stone-900 tracking-tight\",\"children\":\"Khởi tạo Cơ sở dữ liệu\"}],[\"$\",\"p\",null,{\"className\":\"text-stone-500 font-medium\",\"children\":\"Hệ thống phát hiện database của bạn chưa được thiết lập cấu trúc bảng (schema).\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 md:grid-cols-2 gap-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"space-y-6\",\"children\":[\"$\",\"div\",null,{\"className\":\"bg-stone-50 border border-stone-200 rounded-2xl p-6 h-full\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-stone-900 mb-4 flex items-center gap-2\",\"children\":[[\"$\",\"$L10\",null,{\"ref\":\"$undefined\",\"iconNode\":[[\"path\",{\"d\":\"M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z\",\"key\":\"10ikf1\"}]],\"className\":\"lucide-play size-5 text-stone-500\"}],\"Hướng dẫn thực hiện:\"]}],[\"$\",\"ol\",null,{\"className\":\"list-decimal list-inside space-y-4 text-stone-600\",\"children\":[[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[\"Bấm nút\",\" \",[\"$\",\"strong\",null,{\"className\":\"text-indigo-600\",\"children\":\"Copy Mã SQL\"}],\" ở bên dưới để sao chép toàn bộ cấu trúc cơ sở dữ liệu.\"]}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[\"Mở\",\" \",[\"$\",\"a\",null,{\"href\":\"https://supabase.com/dashboard/project/_/sql/new\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-amber-600 font-semibold hover:underline\",\"children\":\"Supabase SQL Editor\"}],\" \",\"trong dự án của bạn.\"]}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"Dán (Paste)\"}],\" mã vừa copy vào khung soạn thảo của Supabase.\"]}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[\"Bấm nút \",[\"$\",\"strong\",null,{\"children\":\"RUN\"}],\" (Chạy) ở góc phải dưới cùng màn hình Supabase.\"]}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[\"Quay lại đây và \",[\"$\",\"strong\",null,{\"children\":\"Tải lại trang\"}],\" (hoặc bấm Đăng nhập lại).\"]}]]}],[\"$\",\"div\",null,{\"className\":\"mt-8\",\"children\":[\"$\",\"$L11\",null,{\"content\":\"$12\"}]}]]}]}],\"$L13\"]}]]}]}],\"$L14\",\"$L15\"]}]\n17:I[22016,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\",\"/_next/static/chunks/10gp4~2wc-iyp.js\"],\"\"]\n16:T48e5,-- ==========================================\r\n-- GIAPHA-OS DATABASE SCHEMA\r\n-- ==========================================\r\n\r\n-- EXTENSIONS\r\nCREATE EXTENSION IF NOT EXISTS pgcrypto WITH SCHEMA extensions;\r\n\r\n-- ENUMS\r\n-- Gender types for family members\r\nDO $$ BEGIN\r\n    CREATE TYPE public.gender_enum AS ENUM ('male', 'female', 'other');\r\nEXCEPTION\r\n    WHEN duplicate_object THEN null;\r\nEND $$;\r\n\r\n-- Relationship types between family members\r\nDO $$ BEGIN\r\n    CREATE TYPE public.relationship_type_enum AS ENUM ('marriage', 'biological_child', 'adopted_child');\r\nEXCEPTION\r\n    WHEN duplicate_object THEN null;\r\nEND $$;\r\n\r\n-- System user roles\r\nDO $$ BEGIN\r\n    CREATE TYPE public.user_role_enum AS ENUM ('admin', 'editor', 'member');\r\nEXCEPTION\r\n    WHEN duplicate_object THEN null;\r\nEND $$;\r\n\r\n-- ==========================================\r\n-- UTILITY FUNCTIONS\r\n-- ==========================================\r\n\r\n-- Function to automatically update 'updated_at' timestamps\r\nCREATE OR REPLACE FUNCTION public.handle_updated_at()\r\nRETURNS TRIGGER AS $$\r\nBEGIN\r\n  NEW.updated_at = NOW();\r\n  RETURN NEW;\r\nEND;\r\n$$ LANGUAGE plpgsql;\r\n\r\n-- ==========================================\r\n-- TABLES (Data Preservation: No DROP TABLE commands)\r\n-- ==========================================\r\n\r\n-- PROFILES (Application users linked to Auth)\r\nCREATE TABLE IF NOT EXISTS public.profiles (\r\n  id UUID REFERENCES auth.users(id) ON DELETE CASCADE PRIMARY KEY,\r\n  role public.user_role_enum DEFAULT 'member' NOT NULL,\r\n  is_active BOOLEAN NOT NULL DEFAULT false,\r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW()\r\n);\r\n\r\n-- PERSONS (Core entity for family tree)\r\nCREATE TABLE IF NOT EXISTS public.persons (\r\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\r\n  full_name TEXT NOT NULL,\r\n  gender public.gender_enum NOT NULL,\r\n  \r\n  -- Date components (allows for partial dates where only year is known)\r\n  birth_year INT,\r\n  birth_month INT,\r\n  birth_day INT,\r\n  death_year INT,\r\n  death_month INT,\r\n  death_day INT,\r\n  death_lunar_year INT,\r\n  death_lunar_month INT,\r\n  death_lunar_day INT,\r\n  \r\n  is_deceased BOOLEAN NOT NULL DEFAULT FALSE,\r\n  is_in_law BOOLEAN NOT NULL DEFAULT FALSE,\r\n  birth_order INT,\r\n  generation INT,\r\n  other_names TEXT,\r\n  avatar_url TEXT,\r\n  note TEXT,\r\n  \r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW()\r\n);\r\n\r\n-- PERSON_DETAILS_PRIVATE (Sensitive data with restricted RLS)\r\nCREATE TABLE IF NOT EXISTS public.person_details_private (\r\n  person_id UUID REFERENCES public.persons(id) ON DELETE CASCADE PRIMARY KEY,\r\n  phone_number TEXT,\r\n  occupation TEXT,\r\n  current_residence TEXT,\r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW()\r\n);\r\n\r\n-- RELATIONSHIPS (Links between persons)\r\nCREATE TABLE IF NOT EXISTS public.relationships (\r\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\r\n  type public.relationship_type_enum NOT NULL,\r\n  person_a UUID REFERENCES public.persons(id) ON DELETE CASCADE NOT NULL,\r\n  person_b UUID REFERENCES public.persons(id) ON DELETE CASCADE NOT NULL,\r\n  note TEXT,\r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW(),\r\n  \r\n  -- Prevent self-relationships\r\n  CONSTRAINT no_self_relationship CHECK (person_a != person_b),\r\n  \r\n  -- Ensure unique relationships between pairs for a specific type\r\n  UNIQUE(person_a, person_b, type)\r\n);\r\n\r\n-- CUSTOM_EVENTS (User-created events)\r\nCREATE TABLE IF NOT EXISTS public.custom_events (\r\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\r\n  name TEXT NOT NULL,\r\n  content TEXT,\r\n  event_date DATE NOT NULL,\r\n  location TEXT,\r\n  created_by UUID REFERENCES public.profiles(id) DEFAULT auth.uid(),\r\n  \r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW()\r\n);\r\n\r\n-- ==========================================\r\n-- INDEXES\r\n-- ==========================================\r\n\r\n-- Relationship lookups\r\nCREATE INDEX IF NOT EXISTS idx_relationships_person_a ON public.relationships(person_a);\r\nCREATE INDEX IF NOT EXISTS idx_relationships_person_b ON public.relationships(person_b);\r\nCREATE INDEX IF NOT EXISTS idx_relationships_type ON public.relationships(type);\r\n\r\n-- Person filtering and sorting\r\nCREATE INDEX IF NOT EXISTS idx_persons_full_name ON public.persons(full_name);\r\nCREATE INDEX IF NOT EXISTS idx_persons_generation ON public.persons(generation);\r\nCREATE INDEX IF NOT EXISTS idx_persons_gender ON public.persons(gender);\r\nCREATE INDEX IF NOT EXISTS idx_persons_is_deceased ON public.persons(is_deceased);\r\nCREATE INDEX IF NOT EXISTS idx_persons_birth_year ON public.persons(birth_year);\r\n\r\n-- Profile lookups\r\nCREATE INDEX IF NOT EXISTS idx_profiles_role ON public.profiles(role);\r\nCREATE INDEX IF NOT EXISTS idx_profiles_is_active ON public.profiles(is_active);\r\n\r\n-- Custom events lookups\r\nCREATE INDEX IF NOT EXISTS idx_custom_events_date ON public.custom_events(event_date);\r\nCREATE INDEX IF NOT EXISTS idx_custom_events_created_by ON public.custom_events(created_by);\r\n\r\n-- ==========================================\r\n-- RLS POLICIES\r\n-- ==========================================\r\n\r\nALTER TABLE public.profiles ENABLE ROW LEVEL SECURITY;\r\nALTER TABLE public.persons ENABLE ROW LEVEL SECURITY;\r\nALTER TABLE public.person_details_private ENABLE ROW LEVEL SECURITY;\r\nALTER TABLE public.relationships ENABLE ROW LEVEL SECURITY;\r\n\r\n-- Helper function to check if user is admin\r\nCREATE OR REPLACE FUNCTION public.is_admin()\r\nRETURNS BOOLEAN AS $$\r\nBEGIN\r\n  RETURN EXISTS (\r\n    SELECT 1 FROM public.profiles\r\n    WHERE id = auth.uid() AND role = 'admin'\r\n  );\r\nEND;\r\n$$ LANGUAGE plpgsql SECURITY DEFINER;\r\n\r\n-- Helper function to check if user is editor\r\nCREATE OR REPLACE FUNCTION PUBLIC.IS_EDITOR()\r\nRETURNS BOOLEAN\r\nLANGUAGE PLPGSQL\r\nSECURITY DEFINER\r\nSET SEARCH_PATH = PUBLIC\r\nAS $$\r\nBEGIN\r\n  RETURN EXISTS (\r\n    SELECT 1 FROM public.profiles\r\n    WHERE id = auth.uid() AND role = 'editor'\r\n  );\r\nEND;\r\n$$;\r\nrevoke all on function public.is_editor() from public;\r\ngrant execute on function public.is_editor() to authenticated;\r\n\r\n-- PROFILES POLICIES\r\nDROP POLICY IF EXISTS \"Users can view own profile\" ON public.profiles;\r\nCREATE POLICY \"Users can view own profile\" ON public.profiles FOR SELECT USING (auth.uid() = id);\r\n\r\nDROP POLICY IF EXISTS \"Admins can view all profiles\" ON public.profiles;\r\nCREATE POLICY \"Admins can view all profiles\" ON public.profiles FOR SELECT USING (public.is_admin());\r\n\r\n-- PERSONS POLICIES\r\nDROP POLICY IF EXISTS \"Enable read access for authenticated users\" ON public.persons;\r\nCREATE POLICY \"Enable read access for authenticated users\" ON public.persons FOR SELECT TO authenticated USING (true);\r\n\r\nDROP POLICY IF EXISTS \"Admins can manage persons\" ON public.persons;\r\nDROP POLICY IF EXISTS \"Admins can insert persons\" ON public.persons;\r\nDROP POLICY IF EXISTS \"Admins can update persons\" ON public.persons;\r\nDROP POLICY IF EXISTS \"Admins can delete persons\" ON public.persons;\r\n\r\nCREATE POLICY \"Admins and Editors can insert persons\" ON public.persons FOR INSERT TO authenticated WITH CHECK (public.is_admin() OR public.is_editor());\r\nCREATE POLICY \"Admins and Editors can update persons\" ON public.persons FOR UPDATE TO authenticated USING (public.is_admin() OR public.is_editor()) WITH CHECK (public.is_admin() OR public.is_editor());\r\nCREATE POLICY \"Admins and Editors can delete persons\" ON public.persons FOR DELETE TO authenticated USING (public.is_admin() OR public.is_editor());\r\n\r\n-- PERSON_DETAILS_PRIVATE POLICIES\r\nDROP POLICY IF EXISTS \"Admins can view private details\" ON public.person_details_private;\r\nCREATE POLICY \"Admins can view private details\" ON public.person_details_private FOR SELECT TO authenticated USING (public.is_admin());\r\n\r\nDROP POLICY IF EXISTS \"Admins can manage private details\" ON public.person_details_private;\r\nCREATE POLICY \"Admins can manage private details\" ON public.person_details_private FOR ALL TO authenticated USING (public.is_admin());\r\n\r\n-- RELATIONSHIPS POLICIES\r\nDROP POLICY IF EXISTS \"Enable read access for authenticated users\" ON public.relationships;\r\nCREATE POLICY \"Enable read access for authenticated users\" ON public.relationships FOR SELECT TO authenticated USING (true);\r\n\r\nDROP POLICY IF EXISTS \"Admins can manage relationships\" ON public.relationships;\r\nDROP POLICY IF EXISTS \"Admins can insert relationships\" ON public.relationships;\r\nDROP POLICY IF EXISTS \"Admins can update relationships\" ON public.relationships;\r\nDROP POLICY IF EXISTS \"Admins can delete relationships\" ON public.relationships;\r\n\r\nCREATE POLICY \"Admins and Editors can insert relationships\" ON public.relationships FOR INSERT TO authenticated WITH CHECK (public.is_admin() OR public.is_editor());\r\nCREATE POLICY \"Admins and Editors can update relationships\" ON public.relationships FOR UPDATE TO authenticated USING (public.is_admin() OR public.is_editor()) WITH CHECK (public.is_admin() OR public.is_editor());\r\nCREATE POLICY \"Admins and Editors can delete relationships\" ON public.relationships FOR DELETE TO authenticated USING (public.is_admin() OR public.is_editor());\r\n\r\n-- CUSTOM_EVENTS POLICIES\r\nALTER TABLE public.custom_events ENABLE ROW LEVEL SECURITY;\r\n\r\nDROP POLICY IF EXISTS \"Enable read access for authenticated users\" ON public.custom_events;\r\nCREATE POLICY \"Enable read access for authenticated users\" ON public.custom_events FOR SELECT TO authenticated USING (true);\r\n\r\nDROP POLICY IF EXISTS \"Authenticated users can insert custom events\" ON public.custom_events;\r\nCREATE POLICY \"Authenticated users can insert custom events\" ON public.custom_events FOR INSERT TO authenticated WITH CHECK (auth.uid() = created_by);\r\n\r\nDROP POLICY IF EXISTS \"Users can update own custom events\" ON public.custom_events;\r\nCREATE POLICY \"Users can update own custom events\" ON public.custom_events FOR UPDATE TO authenticated USING (auth.uid() = created_by OR public.is_admin());\r\n\r\nDROP POLICY IF EXISTS \"Users can delete own custom events\" ON public.custom_events;\r\nCREATE POLICY \"Users can delete own custom events\" ON public.custom_events FOR DELETE TO authenticated USING (auth.uid() = created_by OR public.is_admin());\r\n\r\n-- ==========================================\r\n-- TRIGGERS\r\n-- ==========================================\r\n\r\n-- 1. Updated At Triggers\r\nDROP TRIGGER IF EXISTS tr_profiles_updated_at ON public.profiles;\r\nCREATE TRIGGER tr_profiles_updated_at BEFORE UPDATE ON public.profiles FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\nDROP TRIGGER IF EXISTS tr_persons_updated_at ON public.persons;\r\nCREATE TRIGGER tr_persons_updated_at BEFORE UPDATE ON public.persons FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\nDROP TRIGGER IF EXISTS tr_person_details_private_updated_at ON public.person_details_private;\r\nCREATE TRIGGER tr_person_details_private_updated_at BEFORE UPDATE ON public.person_details_private FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\nDROP TRIGGER IF EXISTS tr_relationships_updated_at ON public.relationships;\r\nCREATE TRIGGER tr_relationships_updated_at BEFORE UPDATE ON public.relationships FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\nDROP TRIGGER IF EXISTS tr_custom_events_updated_at ON public.custom_events;\r\nCREATE TRIGGER tr_custom_events_updated_at BEFORE UPDATE ON public.custom_events FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\n-- 2. Handle new user signup (Profile creation)\r\nCREATE OR REPLACE FUNCTION public.handle_new_user()\r\nRETURNS trigger \r\nLANGUAGE plpgsql\r\nSECURITY DEFINER SET search_path = public, auth\r\nAS $$\r\nDECLARE\r\n  is_first_user boolean;\r\nBEGIN\r\n  -- Check if this is the first user (count will be 1 as this is AFTER INSERT)\r\n  SELECT count(*) = 1 FROM auth.users INTO is_first_user;\r\n\r\n  INSERT INTO public.profiles (id, role, is_active)\r\n  VALUES (\r\n    new.id, \r\n    CASE WHEN is_first_user THEN 'admin'::public.user_role_enum ELSE 'member'::public.user_role_enum END,\r\n    true\r\n  );\r\n\r\n  UPDATE public.profiles \r\n  SET is_active = true \r\n  WHERE id = new.id AND is_first_user = true;\r\n\r\n  RETURN new;\r\nEND;\r\n$$;\r\n\r\n-- 3. Auto-confirm first user (Email verification)\r\nCREATE OR REPLACE FUNCTION public.handle_first_user_confirmation()\r\nRETURNS trigger\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER SET search_path = auth\r\nAS $$\r\nBEGIN\r\n  -- If no users exist yet, auto-confirm this first one\r\n  IF NOT EXISTS (SELECT 1 FROM auth.users) THEN\r\n    NEW.email_confirmed_at := NOW();\r\n    NEW.last_sign_in_at := NOW();\r\n  END IF;\r\n  RETURN NEW;\r\nEND;\r\n$$;\r\n\r\n-- Trigger for profile creation\r\nDROP TRIGGER IF EXISTS on_auth_user_created ON auth.users;\r\nCREATE TRIGGER on_auth_user_created\r\n  AFTER INSERT ON auth.users\r\n  FOR EACH ROW EXECUTE PROCEDURE public.handle_new_user();\r\n\r\n-- Trigger for auto-confirmation\r\nDROP TRIGGER IF EXISTS on_auth_user_created_confirm ON auth.users;\r\nCREATE TRIGGER on_auth_user_created_confirm\r\n  BEFORE INSERT ON auth.users\r\n  FOR EACH ROW EXECUTE PROCEDURE public.handle_first_user_confirmation();\r\n\r\n-- ==========================================\r\n-- STORAGE POLICIES\r\n-- ==========================================\r\n\r\n-- Initialize 'avatars' bucket\r\nINSERT INTO storage.buckets (id, name, public) \r\nVALUES ('avatars', 'avatars', true) \r\nON CONFLICT (id) DO UPDATE SET public = true;\r\n\r\nDROP POLICY IF EXISTS \"Avatar images are publicly accessible.\" ON storage.objects;\r\nCREATE POLICY \"Avatar images are publicly accessible.\" ON storage.objects FOR SELECT USING ( bucket_id = 'avatars' );\r\n\r\nDROP POLICY IF EXISTS \"Users can upload avatars.\" ON storage.objects;\r\nCREATE POLICY \"Users can upload avatars.\" ON storage.objects FOR INSERT WITH CHECK ( bucket_id = 'avatars' AND auth.role() = 'authenticated' );\r\n\r\nDROP POLICY IF EXISTS \"Users can update avatars.\" ON storage.objects;\r\nCREATE POLICY \"Users can update avatars.\" ON storage.objects FOR UPDATE USING ( bucket_id = 'avatars' AND auth.role() = 'authenticated' );\r\n\r\nDROP POLICY IF EXISTS \"Users can delete avatars.\" ON storage.objects;\r\nCREATE POLICY \"Users can delete avatars.\" ON storage.objects FOR DELETE USING ( bucket_id = 'avatars' AND auth.role() = 'authenticated' );\r\n\r\n-- ==========================================\r\n-- ADMIN RPC FUNCTIONS\r\n-- ==========================================\r\n\r\n-- Custom type for get_admin_users\r\nDROP TYPE IF EXISTS public.admin_user_data CASCADE;\r\nCREATE TYPE public.admin_user_data AS (\r\n    id uuid,\r\n    email text,\r\n    role public.user_role_enum,\r\n    created_at timestamptz,\r\n    is_active boolean\r\n);\r\n\r\n-- 1. Get List of Users for Admin\r\nCREATE OR REPLACE FUNCTION public.get_admin_users()\r\nRETURNS SETOF public.admin_user_data\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER\r\nSET search_path = public, auth\r\nAS $$\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\r\n        RAISE EXCEPTION 'Access denied.';\r\n    END IF;\r\n\r\n    RETURN QUERY\r\n    SELECT au.id, au.email::text, p.role, au.created_at, p.is_active\r\n    FROM auth.users au\r\n    LEFT JOIN public.profiles p ON au.id = p.id\r\n    ORDER BY au.created_at DESC;\r\nEND;\r\n$$;\r\n\r\n-- 2. Update User Role\r\nCREATE OR REPLACE FUNCTION public.set_user_role(target_user_id uuid, new_role text)\r\nRETURNS void\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER\r\nSET search_path = public, auth\r\nAS $$\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\r\n        RAISE EXCEPTION 'Access denied.';\r\n    END IF;\r\n\r\n    UPDATE public.profiles\r\n    SET role = new_role::public.user_role_enum\r\n    WHERE id = target_user_id;\r\nEND;\r\n$$;\r\n\r\n-- 3. Delete User Account\r\nCREATE OR REPLACE FUNCTION public.delete_user(target_user_id uuid)\r\nRETURNS void\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER\r\nSET search_path = public, auth\r\nAS $$\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\r\n        RAISE EXCEPTION 'Access denied.';\r\n    END IF;\r\n    \r\n    IF auth.uid() = target_user_id THEN\r\n        RAISE EXCEPTION 'Cannot delete yourself.';\r\n    END IF;\r\n\r\n    DELETE FROM auth.users WHERE id = target_user_id;\r\nEND;\r\n$$;\r\n\r\n-- 4. Admin Create New User\r\n-- IMPORTANT: All token/string columns MUST be set to '' (empty string), NOT NULL.\r\n-- Supabase Auth's Go scanner crashes with \"converting NULL to string is unsupported\"\r\n-- if any of these fields are NULL.\r\nCREATE OR REPLACE FUNCTION public.admin_create_user(\r\n  new_email text, \r\n  new_password text, \r\n  new_role text,\r\n  new_active boolean\r\n)\r\n RETURNS uuid\r\n LANGUAGE plpgsql\r\n SECURITY DEFINER\r\n SET search_path TO 'public', 'auth', 'extensions'\r\nAS $function$\r\nDECLARE\r\n    new_id uuid;\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\r\n        RAISE EXCEPTION 'Access denied.';\r\n    END IF;\r\n\r\n    new_id := gen_random_uuid();\r\n\r\n    INSERT INTO auth.users (\r\n        id, instance_id, aud, role, email, encrypted_password, \r\n        email_confirmed_at,         -- Auto-verify: skip email confirmation\r\n        confirmation_token,         -- Must be '' not NULL (Supabase Auth Go scanner)\r\n        recovery_token,             -- Must be '' not NULL\r\n        email_change_token_new,     -- Must be '' not NULL\r\n        email_change_token_current, -- Must be '' not NULL\r\n        reauthentication_token,     -- Must be '' not NULL\r\n        email_change,               -- Must be '' not NULL\r\n        phone_change,               -- Must be '' not NULL\r\n        phone_change_token,         -- Must be '' not NULL\r\n        raw_app_meta_data, raw_user_meta_data, created_at, updated_at\r\n    )\r\n    VALUES (\r\n        new_id, '00000000-0000-0000-0000-000000000000', 'authenticated', 'authenticated',\r\n        new_email, extensions.crypt(new_password, extensions.gen_salt('bf')),\r\n        now(),\r\n        '', '', '', '', '', '', '', '',\r\n        '{\"provider\":\"email\",\"providers\":[\"email\"]}', '{}', now(), now()\r\n    );\r\n\r\n    INSERT INTO public.profiles (id, role, is_active, created_at, updated_at)\r\n    VALUES (new_id, new_role::public.user_role_enum, new_active, now(), now())\r\n    ON CONFLICT (id) DO UPDATE SET role = EXCLUDED.role, is_active = EXCLUDED.is_active;\r\n    \r\n    RETURN new_id;\r\nEND;\r\n$function$;\r\n\r\n-- 5. Set User Active Status (Approve/Block)\r\nCREATE OR REPLACE FUNCTION public.set_user_active_status(target_user_id uuid, new_status boolean)\r\nRETURNS void\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER\r\nSET search_path = public, auth\r\nAS $$\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\r\n        RAISE EXCEPTION 'Access denied.';\r\n    END IF;\r\n\r\n    UPDATE public.profiles\r\n    SET is_active = new_status\r\n    WHERE id = target_user_id;\r\nEND;\r\n$$;\r\n13:[\"$\",\"div\",null,{\"className\":\"col-span-1 border border-stone-200 rounded-2xl overflow-hidden bg-[#1e1e1e] flex flex-col h-[400px]\",\"children\":[[\"$\",\"div\",null,{\"className\":\"bg-[#2d2d2d] px-4 py-2 flex items-center justify-between border-b border-stone-800\",\"children\":[\"$\",\"span\",null,{\"className\":\"text-stone-400 text-xs font-mono\",\"children\":\"docs/schema.sql\"}]}],[\"$\",\"div\",null,{\"className\":\"p-4 overflow-y-auto w-full flex-grow custom-scrollbar\",\"children\":[\"$\",\"pre\",null,{\"className\":\"text-xs sm:text-sm font-mono text-stone-300 leading-relaxed whitespace-pre\",\"children\":[\"$\",\"code\",null,{\"children\":\"$16\"}]}]}]]}]\n14:[\"$\",\"$L17\",null,{\"href\":\"/login\",\"className\":\"absolute top-6 left-6 z-20 flex items-center gap-2 text-stone-500 hover:text-stone-900 font-semibold text-sm transition-all duration-300 bg-white/60 px-5 py-2.5 rounded-full shadow-sm border border-stone-200 hover:border-stone-300 hover:shadow-md\",\"children\":[[\"$\",\"$L10\",null,{\"ref\":\"$undefined\",\"iconNode\":[[\"path\",{\"d\":\"m12 19-7-7 7-7\",\"key\":\"1l729n\"}],[\"path\",{\"d\":\"M19 12H5\",\"key\":\"x3x0zl\"}]],\"className\":\"lucide-arrow-left size-4\"}],\"Quay lại Đăng nhập\"]}]\n15:[\"$\",\"footer\",null,{\"className\":\"py-8 text-center text-sm text-stone-500 bg-transparent border-none mt-auto relative z-10 backdrop-blur-sm\",\"children\":[\"$\",\"div\",null,{\"className\":\"max-w-7xl mx-auto px-4\",\"children\":[false,[\"$\",\"p\",null,{\"className\":\"flex items-center justify-center gap-2 opacity-80 hover:opacity-100 transition-opacity\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://github.com/homielab/giapha-os\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"font-semibold text-stone-600 hover:text-amber-700 transition-colors inline-flex items-center gap-1.5\",\"children\":[[\"$\",\"svg\",null,{\"viewBox\":\"0 0 24 24\",\"width\":\"16\",\"height\":\"16\",\"stroke\":\"currentColor\",\"strokeWidth\":\"2\",\"fill\":\"none\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"children\":[\"$\",\"path\",null,{\"d\":\"M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22\"}]}],\"Gia Phả OS\"]}],\"by\",[\"$\",\"a\",null,{\"href\":\"https://homielab.com\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"font-semibold text-green-600 hover:text-amber-700 transition-colors inline-flex items-center gap-1.5\",\"children\":\"HomieLab\"}]]}]]}]}]\n","segmentData":{"/_tree":":HL[\"/_next/static/chunks/0qa855wvp2uv9.css\",\"style\"]\n:HL[\"/_next/static/chunks/0xc7eu11bieu_.css\",\"style\"]\n:HL[\"/_next/static/media/14e23f9b59180572-s.p.08.c8psu~gif9.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/2a65768255d6b625-s.p.14by5b4al-y~f.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/2bbe8d2671613f1f-s.p.067x_6k0k23tk.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/83afe278b6a6bb3c-s.p.0q-301v4kxxnr.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n0:{\"tree\":{\"name\":\"\",\"param\":null,\"prefetchHints\":16,\"slots\":{\"children\":{\"name\":\"setup\",\"param\":null,\"prefetchHints\":0,\"slots\":{\"children\":{\"name\":\"__PAGE__\",\"param\":null,\"prefetchHints\":0,\"slots\":null}}}}},\"staleTime\":300,\"buildId\":\"WOoep__bZIeFRofyAsxc8\"}\n","/_full":"1:\"$Sreact.fragment\"\n2:I[39756,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\"],\"default\"]\n3:I[37457,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\"],\"default\"]\n5:I[97367,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\"],\"OutletBoundary\"]\n6:\"$Sreact.suspense\"\n9:I[97367,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\"],\"ViewportBoundary\"]\nb:I[97367,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\"],\"MetadataBoundary\"]\nd:I[68027,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\"],\"default\",1]\n:HL[\"/_next/static/chunks/0qa855wvp2uv9.css\",\"style\"]\n:HL[\"/_next/static/chunks/0xc7eu11bieu_.css\",\"style\"]\n:HL[\"/_next/static/media/14e23f9b59180572-s.p.08.c8psu~gif9.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/2a65768255d6b625-s.p.14by5b4al-y~f.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/2bbe8d2671613f1f-s.p.067x_6k0k23tk.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/83afe278b6a6bb3c-s.p.0q-301v4kxxnr.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n0:{\"P\":null,\"c\":[\"\",\"setup\"],\"q\":\"\",\"i\":false,\"f\":[[[\"\",{\"children\":[\"setup\",{\"children\":[\"__PAGE__\",{}]}]},\"$undefined\",\"$undefined\",16],[[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/0qa855wvp2uv9.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}],[\"$\",\"link\",\"1\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/0xc7eu11bieu_.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/01xlw8hd842-c.js\",\"async\":true,\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/0d3shmwh5_nmn.js\",\"async\":true,\"nonce\":\"$undefined\"}]],[\"$\",\"html\",null,{\"lang\":\"vi\",\"children\":[\"$\",\"body\",null,{\"className\":\"inter_f20e379b-module__TWS8mW__variable playfair_display_c88dccb7-module__wLnm0q__variable font-sans antialiased relative\",\"children\":[\"$\",\"$L2\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L3\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":[[[\"$\",\"title\",null,{\"children\":\"404: This page could not be found.\"}],[\"$\",\"div\",null,{\"style\":{\"fontFamily\":\"system-ui,\\\"Segoe UI\\\",Roboto,Helvetica,Arial,sans-serif,\\\"Apple Color Emoji\\\",\\\"Segoe UI Emoji\\\"\",\"height\":\"100vh\",\"textAlign\":\"center\",\"display\":\"flex\",\"flexDirection\":\"column\",\"alignItems\":\"center\",\"justifyContent\":\"center\"},\"children\":[\"$\",\"div\",null,{\"children\":[[\"$\",\"style\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}\"}}],[\"$\",\"h1\",null,{\"className\":\"next-error-h1\",\"style\":{\"display\":\"inline-block\",\"margin\":\"0 20px 0 0\",\"padding\":\"0 23px 0 0\",\"fontSize\":24,\"fontWeight\":500,\"verticalAlign\":\"top\",\"lineHeight\":\"49px\"},\"children\":404}],[\"$\",\"div\",null,{\"style\":{\"display\":\"inline-block\"},\"children\":[\"$\",\"h2\",null,{\"style\":{\"fontSize\":14,\"fontWeight\":400,\"lineHeight\":\"49px\",\"margin\":0},\"children\":\"This page could not be found.\"}]}]]}]}]],[]],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]}]}]]}],{\"children\":[[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L2\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L3\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}],{\"children\":[[\"$\",\"$1\",\"c\",{\"children\":[\"$L4\",[[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/10gp4~2wc-iyp.js\",\"async\":true,\"nonce\":\"$undefined\"}]],[\"$\",\"$L5\",null,{\"children\":[\"$\",\"$6\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@7\"}]}]]}],{},null,false,null]},null,false,\"$@8\"]},null,false,null],[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L9\",null,{\"children\":\"$La\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$Lb\",null,{\"children\":[\"$\",\"$6\",null,{\"name\":\"Next.Metadata\",\"children\":\"$Lc\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}],false]],\"m\":\"$undefined\",\"G\":[\"$d\",[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/0qa855wvp2uv9.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}],[\"$\",\"link\",\"1\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/0xc7eu11bieu_.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]]],\"S\":true,\"h\":null,\"s\":\"$undefined\",\"l\":\"$undefined\",\"p\":\"$undefined\",\"d\":\"$undefined\",\"b\":\"WOoep__bZIeFRofyAsxc8\"}\ne:[]\n8:\"$We\"\na:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:I[27201,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\"],\"IconMark\"]\n7:null\nc:[[\"$\",\"title\",\"0\",{\"children\":\"Gia Phả OS\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Gia Phả OS\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico?favicon.0cbu-oy3ga.gt.ico\",\"sizes\":\"48x48\",\"type\":\"image/x-icon\"}],[\"$\",\"$Lf\",\"3\",{}]]\n10:I[58541,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\",\"/_next/static/chunks/10gp4~2wc-iyp.js\"],\"default\"]\n11:I[42593,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\",\"/_next/static/chunks/10gp4~2wc-iyp.js\"],\"default\"]\n12:T48e5,-- ==========================================\r\n-- GIAPHA-OS DATABASE SCHEMA\r\n-- ==========================================\r\n\r\n-- EXTENSIONS\r\nCREATE EXTENSION IF NOT EXISTS pgcrypto WITH SCHEMA extensions;\r\n\r\n-- ENUMS\r\n-- Gender types for family members\r\nDO $$ BEGIN\r\n    CREATE TYPE public.gender_enum AS ENUM ('male', 'female', 'other');\r\nEXCEPTION\r\n    WHEN duplicate_object THEN null;\r\nEND $$;\r\n\r\n-- Relationship types between family members\r\nDO $$ BEGIN\r\n    CREATE TYPE public.relationship_type_enum AS ENUM ('marriage', 'biological_child', 'adopted_child');\r\nEXCEPTION\r\n    WHEN duplicate_object THEN null;\r\nEND $$;\r\n\r\n-- System user roles\r\nDO $$ BEGIN\r\n    CREATE TYPE public.user_role_enum AS ENUM ('admin', 'editor', 'member');\r\nEXCEPTION\r\n    WHEN duplicate_object THEN null;\r\nEND $$;\r\n\r\n-- ==========================================\r\n-- UTILITY FUNCTIONS\r\n-- ==========================================\r\n\r\n-- Function to automatically update 'updated_at' timestamps\r\nCREATE OR REPLACE FUNCTION public.handle_updated_at()\r\nRETURNS TRIGGER AS $$\r\nBEGIN\r\n  NEW.updated_at = NOW();\r\n  RETURN NEW;\r\nEND;\r\n$$ LANGUAGE plpgsql;\r\n\r\n-- ==========================================\r\n-- TABLES (Data Preservation: No DROP TABLE commands)\r\n-- ==========================================\r\n\r\n-- PROFILES (Application users linked to Auth)\r\nCREATE TABLE IF NOT EXISTS public.profiles (\r\n  id UUID REFERENCES auth.users(id) ON DELETE CASCADE PRIMARY KEY,\r\n  role public.user_role_enum DEFAULT 'member' NOT NULL,\r\n  is_active BOOLEAN NOT NULL DEFAULT false,\r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW()\r\n);\r\n\r\n-- PERSONS (Core entity for family tree)\r\nCREATE TABLE IF NOT EXISTS public.persons (\r\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\r\n  full_name TEXT NOT NULL,\r\n  gender public.gender_enum NOT NULL,\r\n  \r\n  -- Date components (allows for partial dates where only year is known)\r\n  birth_year INT,\r\n  birth_month INT,\r\n  birth_day INT,\r\n  death_year INT,\r\n  death_month INT,\r\n  death_day INT,\r\n  death_lunar_year INT,\r\n  death_lunar_month INT,\r\n  death_lunar_day INT,\r\n  \r\n  is_deceased BOOLEAN NOT NULL DEFAULT FALSE,\r\n  is_in_law BOOLEAN NOT NULL DEFAULT FALSE,\r\n  birth_order INT,\r\n  generation INT,\r\n  other_names TEXT,\r\n  avatar_url TEXT,\r\n  note TEXT,\r\n  \r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW()\r\n);\r\n\r\n-- PERSON_DETAILS_PRIVATE (Sensitive data with restricted RLS)\r\nCREATE TABLE IF NOT EXISTS public.person_details_private (\r\n  person_id UUID REFERENCES public.persons(id) ON DELETE CASCADE PRIMARY KEY,\r\n  phone_number TEXT,\r\n  occupation TEXT,\r\n  current_residence TEXT,\r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW()\r\n);\r\n\r\n-- RELATIONSHIPS (Links between persons)\r\nCREATE TABLE IF NOT EXISTS public.relationships (\r\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\r\n  type public.relationship_type_enum NOT NULL,\r\n  person_a UUID REFERENCES public.persons(id) ON DELETE CASCADE NOT NULL,\r\n  person_b UUID REFERENCES public.persons(id) ON DELETE CASCADE NOT NULL,\r\n  note TEXT,\r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW(),\r\n  \r\n  -- Prevent self-relationships\r\n  CONSTRAINT no_self_relationship CHECK (person_a != person_b),\r\n  \r\n  -- Ensure unique relationships between pairs for a specific type\r\n  UNIQUE(person_a, person_b, type)\r\n);\r\n\r\n-- CUSTOM_EVENTS (User-created events)\r\nCREATE TABLE IF NOT EXISTS public.custom_events (\r\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\r\n  name TEXT NOT NULL,\r\n  content TEXT,\r\n  event_date DATE NOT NULL,\r\n  location TEXT,\r\n  created_by UUID REFERENCES public.profiles(id) DEFAULT auth.uid(),\r\n  \r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW()\r\n);\r\n\r\n-- ==========================================\r\n-- INDEXES\r\n-- ==========================================\r\n\r\n-- Relationship lookups\r\nCREATE INDEX IF NOT EXISTS idx_relationships_person_a ON public.relationships(person_a);\r\nCREATE INDEX IF NOT EXISTS idx_relationships_person_b ON public.relationships(person_b);\r\nCREATE INDEX IF NOT EXISTS idx_relationships_type ON public.relationships(type);\r\n\r\n-- Person filtering and sorting\r\nCREATE INDEX IF NOT EXISTS idx_persons_full_name ON public.persons(full_name);\r\nCREATE INDEX IF NOT EXISTS idx_persons_generation ON public.persons(generation);\r\nCREATE INDEX IF NOT EXISTS idx_persons_gender ON public.persons(gender);\r\nCREATE INDEX IF NOT EXISTS idx_persons_is_deceased ON public.persons(is_deceased);\r\nCREATE INDEX IF NOT EXISTS idx_persons_birth_year ON public.persons(birth_year);\r\n\r\n-- Profile lookups\r\nCREATE INDEX IF NOT EXISTS idx_profiles_role ON public.profiles(role);\r\nCREATE INDEX IF NOT EXISTS idx_profiles_is_active ON public.profiles(is_active);\r\n\r\n-- Custom events lookups\r\nCREATE INDEX IF NOT EXISTS idx_custom_events_date ON public.custom_events(event_date);\r\nCREATE INDEX IF NOT EXISTS idx_custom_events_created_by ON public.custom_events(created_by);\r\n\r\n-- ==========================================\r\n-- RLS POLICIES\r\n-- ==========================================\r\n\r\nALTER TABLE public.profiles ENABLE ROW LEVEL SECURITY;\r\nALTER TABLE public.persons ENABLE ROW LEVEL SECURITY;\r\nALTER TABLE public.person_details_private ENABLE ROW LEVEL SECURITY;\r\nALTER TABLE public.relationships ENABLE ROW LEVEL SECURITY;\r\n\r\n-- Helper function to check if user is admin\r\nCREATE OR REPLACE FUNCTION public.is_admin()\r\nRETURNS BOOLEAN AS $$\r\nBEGIN\r\n  RETURN EXISTS (\r\n    SELECT 1 FROM public.profiles\r\n    WHERE id = auth.uid() AND role = 'admin'\r\n  );\r\nEND;\r\n$$ LANGUAGE plpgsql SECURITY DEFINER;\r\n\r\n-- Helper function to check if user is editor\r\nCREATE OR REPLACE FUNCTION PUBLIC.IS_EDITOR()\r\nRETURNS BOOLEAN\r\nLANGUAGE PLPGSQL\r\nSECURITY DEFINER\r\nSET SEARCH_PATH = PUBLIC\r\nAS $$\r\nBEGIN\r\n  RETURN EXISTS (\r\n    SELECT 1 FROM public.profiles\r\n    WHERE id = auth.uid() AND role = 'editor'\r\n  );\r\nEND;\r\n$$;\r\nrevoke all on function public.is_editor() from public;\r\ngrant execute on function public.is_editor() to authenticated;\r\n\r\n-- PROFILES POLICIES\r\nDROP POLICY IF EXISTS \"Users can view own profile\" ON public.profiles;\r\nCREATE POLICY \"Users can view own profile\" ON public.profiles FOR SELECT USING (auth.uid() = id);\r\n\r\nDROP POLICY IF EXISTS \"Admins can view all profiles\" ON public.profiles;\r\nCREATE POLICY \"Admins can view all profiles\" ON public.profiles FOR SELECT USING (public.is_admin());\r\n\r\n-- PERSONS POLICIES\r\nDROP POLICY IF EXISTS \"Enable read access for authenticated users\" ON public.persons;\r\nCREATE POLICY \"Enable read access for authenticated users\" ON public.persons FOR SELECT TO authenticated USING (true);\r\n\r\nDROP POLICY IF EXISTS \"Admins can manage persons\" ON public.persons;\r\nDROP POLICY IF EXISTS \"Admins can insert persons\" ON public.persons;\r\nDROP POLICY IF EXISTS \"Admins can update persons\" ON public.persons;\r\nDROP POLICY IF EXISTS \"Admins can delete persons\" ON public.persons;\r\n\r\nCREATE POLICY \"Admins and Editors can insert persons\" ON public.persons FOR INSERT TO authenticated WITH CHECK (public.is_admin() OR public.is_editor());\r\nCREATE POLICY \"Admins and Editors can update persons\" ON public.persons FOR UPDATE TO authenticated USING (public.is_admin() OR public.is_editor()) WITH CHECK (public.is_admin() OR public.is_editor());\r\nCREATE POLICY \"Admins and Editors can delete persons\" ON public.persons FOR DELETE TO authenticated USING (public.is_admin() OR public.is_editor());\r\n\r\n-- PERSON_DETAILS_PRIVATE POLICIES\r\nDROP POLICY IF EXISTS \"Admins can view private details\" ON public.person_details_private;\r\nCREATE POLICY \"Admins can view private details\" ON public.person_details_private FOR SELECT TO authenticated USING (public.is_admin());\r\n\r\nDROP POLICY IF EXISTS \"Admins can manage private details\" ON public.person_details_private;\r\nCREATE POLICY \"Admins can manage private details\" ON public.person_details_private FOR ALL TO authenticated USING (public.is_admin());\r\n\r\n-- RELATIONSHIPS POLICIES\r\nDROP POLICY IF EXISTS \"Enable read access for authenticated users\" ON public.relationships;\r\nCREATE POLICY \"Enable read access for authenticated users\" ON public.relationships FOR SELECT TO authenticated USING (true);\r\n\r\nDROP POLICY IF EXISTS \"Admins can manage relationships\" ON public.relationships;\r\nDROP POLICY IF EXISTS \"Admins can insert relationships\" ON public.relationships;\r\nDROP POLICY IF EXISTS \"Admins can update relationships\" ON public.relationships;\r\nDROP POLICY IF EXISTS \"Admins can delete relationships\" ON public.relationships;\r\n\r\nCREATE POLICY \"Admins and Editors can insert relationships\" ON public.relationships FOR INSERT TO authenticated WITH CHECK (public.is_admin() OR public.is_editor());\r\nCREATE POLICY \"Admins and Editors can update relationships\" ON public.relationships FOR UPDATE TO authenticated USING (public.is_admin() OR public.is_editor()) WITH CHECK (public.is_admin() OR public.is_editor());\r\nCREATE POLICY \"Admins and Editors can delete relationships\" ON public.relationships FOR DELETE TO authenticated USING (public.is_admin() OR public.is_editor());\r\n\r\n-- CUSTOM_EVENTS POLICIES\r\nALTER TABLE public.custom_events ENABLE ROW LEVEL SECURITY;\r\n\r\nDROP POLICY IF EXISTS \"Enable read access for authenticated users\" ON public.custom_events;\r\nCREATE POLICY \"Enable read access for authenticated users\" ON public.custom_events FOR SELECT TO authenticated USING (true);\r\n\r\nDROP POLICY IF EXISTS \"Authenticated users can insert custom events\" ON public.custom_events;\r\nCREATE POLICY \"Authenticated users can insert custom events\" ON public.custom_events FOR INSERT TO authenticated WITH CHECK (auth.uid() = created_by);\r\n\r\nDROP POLICY IF EXISTS \"Users can update own custom events\" ON public.custom_events;\r\nCREATE POLICY \"Users can update own custom events\" ON public.custom_events FOR UPDATE TO authenticated USING (auth.uid() = created_by OR public.is_admin());\r\n\r\nDROP POLICY IF EXISTS \"Users can delete own custom events\" ON public.custom_events;\r\nCREATE POLICY \"Users can delete own custom events\" ON public.custom_events FOR DELETE TO authenticated USING (auth.uid() = created_by OR public.is_admin());\r\n\r\n-- ==========================================\r\n-- TRIGGERS\r\n-- ==========================================\r\n\r\n-- 1. Updated At Triggers\r\nDROP TRIGGER IF EXISTS tr_profiles_updated_at ON public.profiles;\r\nCREATE TRIGGER tr_profiles_updated_at BEFORE UPDATE ON public.profiles FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\nDROP TRIGGER IF EXISTS tr_persons_updated_at ON public.persons;\r\nCREATE TRIGGER tr_persons_updated_at BEFORE UPDATE ON public.persons FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\nDROP TRIGGER IF EXISTS tr_person_details_private_updated_at ON public.person_details_private;\r\nCREATE TRIGGER tr_person_details_private_updated_at BEFORE UPDATE ON public.person_details_private FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\nDROP TRIGGER IF EXISTS tr_relationships_updated_at ON public.relationships;\r\nCREATE TRIGGER tr_relationships_updated_at BEFORE UPDATE ON public.relationships FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\nDROP TRIGGER IF EXISTS tr_custom_events_updated_at ON public.custom_events;\r\nCREATE TRIGGER tr_custom_events_updated_at BEFORE UPDATE ON public.custom_events FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\n-- 2. Handle new user signup (Profile creation)\r\nCREATE OR REPLACE FUNCTION public.handle_new_user()\r\nRETURNS trigger \r\nLANGUAGE plpgsql\r\nSECURITY DEFINER SET search_path = public, auth\r\nAS $$\r\nDECLARE\r\n  is_first_user boolean;\r\nBEGIN\r\n  -- Check if this is the first user (count will be 1 as this is AFTER INSERT)\r\n  SELECT count(*) = 1 FROM auth.users INTO is_first_user;\r\n\r\n  INSERT INTO public.profiles (id, role, is_active)\r\n  VALUES (\r\n    new.id, \r\n    CASE WHEN is_first_user THEN 'admin'::public.user_role_enum ELSE 'member'::public.user_role_enum END,\r\n    true\r\n  );\r\n\r\n  UPDATE public.profiles \r\n  SET is_active = true \r\n  WHERE id = new.id AND is_first_user = true;\r\n\r\n  RETURN new;\r\nEND;\r\n$$;\r\n\r\n-- 3. Auto-confirm first user (Email verification)\r\nCREATE OR REPLACE FUNCTION public.handle_first_user_confirmation()\r\nRETURNS trigger\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER SET search_path = auth\r\nAS $$\r\nBEGIN\r\n  -- If no users exist yet, auto-confirm this first one\r\n  IF NOT EXISTS (SELECT 1 FROM auth.users) THEN\r\n    NEW.email_confirmed_at := NOW();\r\n    NEW.last_sign_in_at := NOW();\r\n  END IF;\r\n  RETURN NEW;\r\nEND;\r\n$$;\r\n\r\n-- Trigger for profile creation\r\nDROP TRIGGER IF EXISTS on_auth_user_created ON auth.users;\r\nCREATE TRIGGER on_auth_user_created\r\n  AFTER INSERT ON auth.users\r\n  FOR EACH ROW EXECUTE PROCEDURE public.handle_new_user();\r\n\r\n-- Trigger for auto-confirmation\r\nDROP TRIGGER IF EXISTS on_auth_user_created_confirm ON auth.users;\r\nCREATE TRIGGER on_auth_user_created_confirm\r\n  BEFORE INSERT ON auth.users\r\n  FOR EACH ROW EXECUTE PROCEDURE public.handle_first_user_confirmation();\r\n\r\n-- ==========================================\r\n-- STORAGE POLICIES\r\n-- ==========================================\r\n\r\n-- Initialize 'avatars' bucket\r\nINSERT INTO storage.buckets (id, name, public) \r\nVALUES ('avatars', 'avatars', true) \r\nON CONFLICT (id) DO UPDATE SET public = true;\r\n\r\nDROP POLICY IF EXISTS \"Avatar images are publicly accessible.\" ON storage.objects;\r\nCREATE POLICY \"Avatar images are publicly accessible.\" ON storage.objects FOR SELECT USING ( bucket_id = 'avatars' );\r\n\r\nDROP POLICY IF EXISTS \"Users can upload avatars.\" ON storage.objects;\r\nCREATE POLICY \"Users can upload avatars.\" ON storage.objects FOR INSERT WITH CHECK ( bucket_id = 'avatars' AND auth.role() = 'authenticated' );\r\n\r\nDROP POLICY IF EXISTS \"Users can update avatars.\" ON storage.objects;\r\nCREATE POLICY \"Users can update avatars.\" ON storage.objects FOR UPDATE USING ( bucket_id = 'avatars' AND auth.role() = 'authenticated' );\r\n\r\nDROP POLICY IF EXISTS \"Users can delete avatars.\" ON storage.objects;\r\nCREATE POLICY \"Users can delete avatars.\" ON storage.objects FOR DELETE USING ( bucket_id = 'avatars' AND auth.role() = 'authenticated' );\r\n\r\n-- ==========================================\r\n-- ADMIN RPC FUNCTIONS\r\n-- ==========================================\r\n\r\n-- Custom type for get_admin_users\r\nDROP TYPE IF EXISTS public.admin_user_data CASCADE;\r\nCREATE TYPE public.admin_user_data AS (\r\n    id uuid,\r\n    email text,\r\n    role public.user_role_enum,\r\n    created_at timestamptz,\r\n    is_active boolean\r\n);\r\n\r\n-- 1. Get List of Users for Admin\r\nCREATE OR REPLACE FUNCTION public.get_admin_users()\r\nRETURNS SETOF public.admin_user_data\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER\r\nSET search_path = public, auth\r\nAS $$\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\r\n        RAISE EXCEPTION 'Access denied.';\r\n    END IF;\r\n\r\n    RETURN QUERY\r\n    SELECT au.id, au.email::text, p.role, au.created_at, p.is_active\r\n    FROM auth.users au\r\n    LEFT JOIN public.profiles p ON au.id = p.id\r\n    ORDER BY au.created_at DESC;\r\nEND;\r\n$$;\r\n\r\n-- 2. Update User Role\r\nCREATE OR REPLACE FUNCTION public.set_user_role(target_user_id uuid, new_role text)\r\nRETURNS void\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER\r\nSET search_path = public, auth\r\nAS $$\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\r\n        RAISE EXCEPTION 'Access denied.';\r\n    END IF;\r\n\r\n    UPDATE public.profiles\r\n    SET role = new_role::public.user_role_enum\r\n    WHERE id = target_user_id;\r\nEND;\r\n$$;\r\n\r\n-- 3. Delete User Account\r\nCREATE OR REPLACE FUNCTION public.delete_user(target_user_id uuid)\r\nRETURNS void\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER\r\nSET search_path = public, auth\r\nAS $$\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\r\n        RAISE EXCEPTION 'Access denied.';\r\n    END IF;\r\n    \r\n    IF auth.uid() = target_user_id THEN\r\n        RAISE EXCEPTION 'Cannot delete yourself.';\r\n    END IF;\r\n\r\n    DELETE FROM auth.users WHERE id = target_user_id;\r\nEND;\r\n$$;\r\n\r\n-- 4. Admin Create New User\r\n-- IMPORTANT: All token/string columns MUST be set to '' (empty string), NOT NULL.\r\n-- Supabase Auth's Go scanner crashes with \"converting NULL to string is unsupported\"\r\n-- if any of these fields are NULL.\r\nCREATE OR REPLACE FUNCTION public.admin_create_user(\r\n  new_email text, \r\n  new_password text, \r\n  new_role text,\r\n  new_active boolean\r\n)\r\n RETURNS uuid\r\n LANGUAGE plpgsql\r\n SECURITY DEFINER\r\n SET search_path TO 'public', 'auth', 'extensions'\r\nAS $function$\r\nDECLARE\r\n    new_id uuid;\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\r\n        RAISE EXCEPTION 'Access denied.';\r\n    END IF;\r\n\r\n    new_id := gen_random_uuid();\r\n\r\n    INSERT INTO auth.users (\r\n        id, instance_id, aud, role, email, encrypted_password, \r\n        email_confirmed_at,         -- Auto-verify: skip email confirmation\r\n        confirmation_token,         -- Must be '' not NULL (Supabase Auth Go scanner)\r\n        recovery_token,             -- Must be '' not NULL\r\n        email_change_token_new,     -- Must be '' not NULL\r\n        email_change_token_current, -- Must be '' not NULL\r\n        reauthentication_token,     -- Must be '' not NULL\r\n        email_change,               -- Must be '' not NULL\r\n        phone_change,               -- Must be '' not NULL\r\n        phone_change_token,         -- Must be '' not NULL\r\n        raw_app_meta_data, raw_user_meta_data, created_at, updated_at\r\n    )\r\n    VALUES (\r\n        new_id, '00000000-0000-0000-0000-000000000000', 'authenticated', 'authenticated',\r\n        new_email, extensions.crypt(new_password, extensions.gen_salt('bf')),\r\n        now(),\r\n        '', '', '', '', '', '', '', '',\r\n        '{\"provider\":\"email\",\"providers\":[\"email\"]}', '{}', now(), now()\r\n    );\r\n\r\n    INSERT INTO public.profiles (id, role, is_active, created_at, updated_at)\r\n    VALUES (new_id, new_role::public.user_role_enum, new_active, now(), now())\r\n    ON CONFLICT (id) DO UPDATE SET role = EXCLUDED.role, is_active = EXCLUDED.is_active;\r\n    \r\n    RETURN new_id;\r\nEND;\r\n$function$;\r\n\r\n-- 5. Set User Active Status (Approve/Block)\r\nCREATE OR REPLACE FUNCTION public.set_user_active_status(target_user_id uuid, new_status boolean)\r\nRETURNS void\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER\r\nSET search_path = public, auth\r\nAS $$\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\r\n        RAISE EXCEPTION 'Access denied.';\r\n    END IF;\r\n\r\n    UPDATE public.profiles\r\n    SET is_active = new_status\r\n    WHERE id = target_user_id;\r\nEND;\r\n$$;\r\n4:[\"$\",\"div\",null,{\"className\":\"min-h-screen flex flex-col bg-[#fafaf9] select-none selection:bg-amber-200 selection:text-amber-900 relative overflow-hidden\",\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute inset-0 bg-[linear-gradient(to_right,#80808008_1px,transparent_1px),linear-gradient(to_bottom,#80808008_1px,transparent_1px)] bg-size-[24px_24px] pointer-events-none\"}],[\"$\",\"div\",null,{\"className\":\"absolute top-0 inset-x-0 h-screen overflow-hidden pointer-events-none flex justify-center\",\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute top-[-10%] right-[-5%] w-[50vw] h-[50vw] max-w-[600px] max-h-[600px] bg-indigo-300/20 rounded-full blur-[100px] mix-blend-multiply\"}],[\"$\",\"div\",null,{\"className\":\"absolute bottom-[0%] left-[-10%] w-[60vw] h-[60vw] max-w-[800px] max-h-[800px] bg-teal-200/20 rounded-full blur-[120px] mix-blend-multiply\"}]]}],[\"$\",\"div\",null,{\"className\":\"flex-1 flex flex-col items-center px-4 py-12 relative z-10 w-full max-w-5xl mx-auto\",\"children\":[\"$\",\"div\",null,{\"className\":\"w-full bg-white p-8 sm:p-10 rounded-3xl shadow-xl border border-stone-200 relative overflow-hidden mb-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-4 mb-6\",\"children\":[[\"$\",\"div\",null,{\"className\":\"p-4 bg-indigo-50 text-indigo-600 rounded-2xl\",\"children\":[\"$\",\"$L10\",null,{\"ref\":\"$undefined\",\"iconNode\":[[\"ellipse\",{\"cx\":\"12\",\"cy\":\"5\",\"rx\":\"9\",\"ry\":\"3\",\"key\":\"msslwz\"}],[\"path\",{\"d\":\"M3 5V19A9 3 0 0 0 21 19V5\",\"key\":\"1wlel7\"}],[\"path\",{\"d\":\"M3 12A9 3 0 0 0 21 12\",\"key\":\"mv7ke4\"}]],\"className\":\"lucide-database size-8\"}]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-bold text-stone-900 tracking-tight\",\"children\":\"Khởi tạo Cơ sở dữ liệu\"}],[\"$\",\"p\",null,{\"className\":\"text-stone-500 font-medium\",\"children\":\"Hệ thống phát hiện database của bạn chưa được thiết lập cấu trúc bảng (schema).\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 md:grid-cols-2 gap-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"space-y-6\",\"children\":[\"$\",\"div\",null,{\"className\":\"bg-stone-50 border border-stone-200 rounded-2xl p-6 h-full\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-stone-900 mb-4 flex items-center gap-2\",\"children\":[[\"$\",\"$L10\",null,{\"ref\":\"$undefined\",\"iconNode\":[[\"path\",{\"d\":\"M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z\",\"key\":\"10ikf1\"}]],\"className\":\"lucide-play size-5 text-stone-500\"}],\"Hướng dẫn thực hiện:\"]}],[\"$\",\"ol\",null,{\"className\":\"list-decimal list-inside space-y-4 text-stone-600\",\"children\":[[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[\"Bấm nút\",\" \",[\"$\",\"strong\",null,{\"className\":\"text-indigo-600\",\"children\":\"Copy Mã SQL\"}],\" ở bên dưới để sao chép toàn bộ cấu trúc cơ sở dữ liệu.\"]}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[\"Mở\",\" \",[\"$\",\"a\",null,{\"href\":\"https://supabase.com/dashboard/project/_/sql/new\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-amber-600 font-semibold hover:underline\",\"children\":\"Supabase SQL Editor\"}],\" \",\"trong dự án của bạn.\"]}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"Dán (Paste)\"}],\" mã vừa copy vào khung soạn thảo của Supabase.\"]}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[\"Bấm nút \",[\"$\",\"strong\",null,{\"children\":\"RUN\"}],\" (Chạy) ở góc phải dưới cùng màn hình Supabase.\"]}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[\"Quay lại đây và \",[\"$\",\"strong\",null,{\"children\":\"Tải lại trang\"}],\" (hoặc bấm Đăng nhập lại).\"]}]]}],[\"$\",\"div\",null,{\"className\":\"mt-8\",\"children\":[\"$\",\"$L11\",null,{\"content\":\"$12\"}]}]]}]}],\"$L13\"]}]]}]}],\"$L14\",\"$L15\"]}]\n17:I[22016,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\",\"/_next/static/chunks/10gp4~2wc-iyp.js\"],\"\"]\n16:T48e5,-- ==========================================\r\n-- GIAPHA-OS DATABASE SCHEMA\r\n-- ==========================================\r\n\r\n-- EXTENSIONS\r\nCREATE EXTENSION IF NOT EXISTS pgcrypto WITH SCHEMA extensions;\r\n\r\n-- ENUMS\r\n-- Gender types for family members\r\nDO $$ BEGIN\r\n    CREATE TYPE public.gender_enum AS ENUM ('male', 'female', 'other');\r\nEXCEPTION\r\n    WHEN duplicate_object THEN null;\r\nEND $$;\r\n\r\n-- Relationship types between family members\r\nDO $$ BEGIN\r\n    CREATE TYPE public.relationship_type_enum AS ENUM ('marriage', 'biological_child', 'adopted_child');\r\nEXCEPTION\r\n    WHEN duplicate_object THEN null;\r\nEND $$;\r\n\r\n-- System user roles\r\nDO $$ BEGIN\r\n    CREATE TYPE public.user_role_enum AS ENUM ('admin', 'editor', 'member');\r\nEXCEPTION\r\n    WHEN duplicate_object THEN null;\r\nEND $$;\r\n\r\n-- ==========================================\r\n-- UTILITY FUNCTIONS\r\n-- ==========================================\r\n\r\n-- Function to automatically update 'updated_at' timestamps\r\nCREATE OR REPLACE FUNCTION public.handle_updated_at()\r\nRETURNS TRIGGER AS $$\r\nBEGIN\r\n  NEW.updated_at = NOW();\r\n  RETURN NEW;\r\nEND;\r\n$$ LANGUAGE plpgsql;\r\n\r\n-- ==========================================\r\n-- TABLES (Data Preservation: No DROP TABLE commands)\r\n-- ==========================================\r\n\r\n-- PROFILES (Application users linked to Auth)\r\nCREATE TABLE IF NOT EXISTS public.profiles (\r\n  id UUID REFERENCES auth.users(id) ON DELETE CASCADE PRIMARY KEY,\r\n  role public.user_role_enum DEFAULT 'member' NOT NULL,\r\n  is_active BOOLEAN NOT NULL DEFAULT false,\r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW()\r\n);\r\n\r\n-- PERSONS (Core entity for family tree)\r\nCREATE TABLE IF NOT EXISTS public.persons (\r\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\r\n  full_name TEXT NOT NULL,\r\n  gender public.gender_enum NOT NULL,\r\n  \r\n  -- Date components (allows for partial dates where only year is known)\r\n  birth_year INT,\r\n  birth_month INT,\r\n  birth_day INT,\r\n  death_year INT,\r\n  death_month INT,\r\n  death_day INT,\r\n  death_lunar_year INT,\r\n  death_lunar_month INT,\r\n  death_lunar_day INT,\r\n  \r\n  is_deceased BOOLEAN NOT NULL DEFAULT FALSE,\r\n  is_in_law BOOLEAN NOT NULL DEFAULT FALSE,\r\n  birth_order INT,\r\n  generation INT,\r\n  other_names TEXT,\r\n  avatar_url TEXT,\r\n  note TEXT,\r\n  \r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW()\r\n);\r\n\r\n-- PERSON_DETAILS_PRIVATE (Sensitive data with restricted RLS)\r\nCREATE TABLE IF NOT EXISTS public.person_details_private (\r\n  person_id UUID REFERENCES public.persons(id) ON DELETE CASCADE PRIMARY KEY,\r\n  phone_number TEXT,\r\n  occupation TEXT,\r\n  current_residence TEXT,\r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW()\r\n);\r\n\r\n-- RELATIONSHIPS (Links between persons)\r\nCREATE TABLE IF NOT EXISTS public.relationships (\r\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\r\n  type public.relationship_type_enum NOT NULL,\r\n  person_a UUID REFERENCES public.persons(id) ON DELETE CASCADE NOT NULL,\r\n  person_b UUID REFERENCES public.persons(id) ON DELETE CASCADE NOT NULL,\r\n  note TEXT,\r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW(),\r\n  \r\n  -- Prevent self-relationships\r\n  CONSTRAINT no_self_relationship CHECK (person_a != person_b),\r\n  \r\n  -- Ensure unique relationships between pairs for a specific type\r\n  UNIQUE(person_a, person_b, type)\r\n);\r\n\r\n-- CUSTOM_EVENTS (User-created events)\r\nCREATE TABLE IF NOT EXISTS public.custom_events (\r\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\r\n  name TEXT NOT NULL,\r\n  content TEXT,\r\n  event_date DATE NOT NULL,\r\n  location TEXT,\r\n  created_by UUID REFERENCES public.profiles(id) DEFAULT auth.uid(),\r\n  \r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW()\r\n);\r\n\r\n-- ==========================================\r\n-- INDEXES\r\n-- ==========================================\r\n\r\n-- Relationship lookups\r\nCREATE INDEX IF NOT EXISTS idx_relationships_person_a ON public.relationships(person_a);\r\nCREATE INDEX IF NOT EXISTS idx_relationships_person_b ON public.relationships(person_b);\r\nCREATE INDEX IF NOT EXISTS idx_relationships_type ON public.relationships(type);\r\n\r\n-- Person filtering and sorting\r\nCREATE INDEX IF NOT EXISTS idx_persons_full_name ON public.persons(full_name);\r\nCREATE INDEX IF NOT EXISTS idx_persons_generation ON public.persons(generation);\r\nCREATE INDEX IF NOT EXISTS idx_persons_gender ON public.persons(gender);\r\nCREATE INDEX IF NOT EXISTS idx_persons_is_deceased ON public.persons(is_deceased);\r\nCREATE INDEX IF NOT EXISTS idx_persons_birth_year ON public.persons(birth_year);\r\n\r\n-- Profile lookups\r\nCREATE INDEX IF NOT EXISTS idx_profiles_role ON public.profiles(role);\r\nCREATE INDEX IF NOT EXISTS idx_profiles_is_active ON public.profiles(is_active);\r\n\r\n-- Custom events lookups\r\nCREATE INDEX IF NOT EXISTS idx_custom_events_date ON public.custom_events(event_date);\r\nCREATE INDEX IF NOT EXISTS idx_custom_events_created_by ON public.custom_events(created_by);\r\n\r\n-- ==========================================\r\n-- RLS POLICIES\r\n-- ==========================================\r\n\r\nALTER TABLE public.profiles ENABLE ROW LEVEL SECURITY;\r\nALTER TABLE public.persons ENABLE ROW LEVEL SECURITY;\r\nALTER TABLE public.person_details_private ENABLE ROW LEVEL SECURITY;\r\nALTER TABLE public.relationships ENABLE ROW LEVEL SECURITY;\r\n\r\n-- Helper function to check if user is admin\r\nCREATE OR REPLACE FUNCTION public.is_admin()\r\nRETURNS BOOLEAN AS $$\r\nBEGIN\r\n  RETURN EXISTS (\r\n    SELECT 1 FROM public.profiles\r\n    WHERE id = auth.uid() AND role = 'admin'\r\n  );\r\nEND;\r\n$$ LANGUAGE plpgsql SECURITY DEFINER;\r\n\r\n-- Helper function to check if user is editor\r\nCREATE OR REPLACE FUNCTION PUBLIC.IS_EDITOR()\r\nRETURNS BOOLEAN\r\nLANGUAGE PLPGSQL\r\nSECURITY DEFINER\r\nSET SEARCH_PATH = PUBLIC\r\nAS $$\r\nBEGIN\r\n  RETURN EXISTS (\r\n    SELECT 1 FROM public.profiles\r\n    WHERE id = auth.uid() AND role = 'editor'\r\n  );\r\nEND;\r\n$$;\r\nrevoke all on function public.is_editor() from public;\r\ngrant execute on function public.is_editor() to authenticated;\r\n\r\n-- PROFILES POLICIES\r\nDROP POLICY IF EXISTS \"Users can view own profile\" ON public.profiles;\r\nCREATE POLICY \"Users can view own profile\" ON public.profiles FOR SELECT USING (auth.uid() = id);\r\n\r\nDROP POLICY IF EXISTS \"Admins can view all profiles\" ON public.profiles;\r\nCREATE POLICY \"Admins can view all profiles\" ON public.profiles FOR SELECT USING (public.is_admin());\r\n\r\n-- PERSONS POLICIES\r\nDROP POLICY IF EXISTS \"Enable read access for authenticated users\" ON public.persons;\r\nCREATE POLICY \"Enable read access for authenticated users\" ON public.persons FOR SELECT TO authenticated USING (true);\r\n\r\nDROP POLICY IF EXISTS \"Admins can manage persons\" ON public.persons;\r\nDROP POLICY IF EXISTS \"Admins can insert persons\" ON public.persons;\r\nDROP POLICY IF EXISTS \"Admins can update persons\" ON public.persons;\r\nDROP POLICY IF EXISTS \"Admins can delete persons\" ON public.persons;\r\n\r\nCREATE POLICY \"Admins and Editors can insert persons\" ON public.persons FOR INSERT TO authenticated WITH CHECK (public.is_admin() OR public.is_editor());\r\nCREATE POLICY \"Admins and Editors can update persons\" ON public.persons FOR UPDATE TO authenticated USING (public.is_admin() OR public.is_editor()) WITH CHECK (public.is_admin() OR public.is_editor());\r\nCREATE POLICY \"Admins and Editors can delete persons\" ON public.persons FOR DELETE TO authenticated USING (public.is_admin() OR public.is_editor());\r\n\r\n-- PERSON_DETAILS_PRIVATE POLICIES\r\nDROP POLICY IF EXISTS \"Admins can view private details\" ON public.person_details_private;\r\nCREATE POLICY \"Admins can view private details\" ON public.person_details_private FOR SELECT TO authenticated USING (public.is_admin());\r\n\r\nDROP POLICY IF EXISTS \"Admins can manage private details\" ON public.person_details_private;\r\nCREATE POLICY \"Admins can manage private details\" ON public.person_details_private FOR ALL TO authenticated USING (public.is_admin());\r\n\r\n-- RELATIONSHIPS POLICIES\r\nDROP POLICY IF EXISTS \"Enable read access for authenticated users\" ON public.relationships;\r\nCREATE POLICY \"Enable read access for authenticated users\" ON public.relationships FOR SELECT TO authenticated USING (true);\r\n\r\nDROP POLICY IF EXISTS \"Admins can manage relationships\" ON public.relationships;\r\nDROP POLICY IF EXISTS \"Admins can insert relationships\" ON public.relationships;\r\nDROP POLICY IF EXISTS \"Admins can update relationships\" ON public.relationships;\r\nDROP POLICY IF EXISTS \"Admins can delete relationships\" ON public.relationships;\r\n\r\nCREATE POLICY \"Admins and Editors can insert relationships\" ON public.relationships FOR INSERT TO authenticated WITH CHECK (public.is_admin() OR public.is_editor());\r\nCREATE POLICY \"Admins and Editors can update relationships\" ON public.relationships FOR UPDATE TO authenticated USING (public.is_admin() OR public.is_editor()) WITH CHECK (public.is_admin() OR public.is_editor());\r\nCREATE POLICY \"Admins and Editors can delete relationships\" ON public.relationships FOR DELETE TO authenticated USING (public.is_admin() OR public.is_editor());\r\n\r\n-- CUSTOM_EVENTS POLICIES\r\nALTER TABLE public.custom_events ENABLE ROW LEVEL SECURITY;\r\n\r\nDROP POLICY IF EXISTS \"Enable read access for authenticated users\" ON public.custom_events;\r\nCREATE POLICY \"Enable read access for authenticated users\" ON public.custom_events FOR SELECT TO authenticated USING (true);\r\n\r\nDROP POLICY IF EXISTS \"Authenticated users can insert custom events\" ON public.custom_events;\r\nCREATE POLICY \"Authenticated users can insert custom events\" ON public.custom_events FOR INSERT TO authenticated WITH CHECK (auth.uid() = created_by);\r\n\r\nDROP POLICY IF EXISTS \"Users can update own custom events\" ON public.custom_events;\r\nCREATE POLICY \"Users can update own custom events\" ON public.custom_events FOR UPDATE TO authenticated USING (auth.uid() = created_by OR public.is_admin());\r\n\r\nDROP POLICY IF EXISTS \"Users can delete own custom events\" ON public.custom_events;\r\nCREATE POLICY \"Users can delete own custom events\" ON public.custom_events FOR DELETE TO authenticated USING (auth.uid() = created_by OR public.is_admin());\r\n\r\n-- ==========================================\r\n-- TRIGGERS\r\n-- ==========================================\r\n\r\n-- 1. Updated At Triggers\r\nDROP TRIGGER IF EXISTS tr_profiles_updated_at ON public.profiles;\r\nCREATE TRIGGER tr_profiles_updated_at BEFORE UPDATE ON public.profiles FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\nDROP TRIGGER IF EXISTS tr_persons_updated_at ON public.persons;\r\nCREATE TRIGGER tr_persons_updated_at BEFORE UPDATE ON public.persons FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\nDROP TRIGGER IF EXISTS tr_person_details_private_updated_at ON public.person_details_private;\r\nCREATE TRIGGER tr_person_details_private_updated_at BEFORE UPDATE ON public.person_details_private FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\nDROP TRIGGER IF EXISTS tr_relationships_updated_at ON public.relationships;\r\nCREATE TRIGGER tr_relationships_updated_at BEFORE UPDATE ON public.relationships FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\nDROP TRIGGER IF EXISTS tr_custom_events_updated_at ON public.custom_events;\r\nCREATE TRIGGER tr_custom_events_updated_at BEFORE UPDATE ON public.custom_events FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\n-- 2. Handle new user signup (Profile creation)\r\nCREATE OR REPLACE FUNCTION public.handle_new_user()\r\nRETURNS trigger \r\nLANGUAGE plpgsql\r\nSECURITY DEFINER SET search_path = public, auth\r\nAS $$\r\nDECLARE\r\n  is_first_user boolean;\r\nBEGIN\r\n  -- Check if this is the first user (count will be 1 as this is AFTER INSERT)\r\n  SELECT count(*) = 1 FROM auth.users INTO is_first_user;\r\n\r\n  INSERT INTO public.profiles (id, role, is_active)\r\n  VALUES (\r\n    new.id, \r\n    CASE WHEN is_first_user THEN 'admin'::public.user_role_enum ELSE 'member'::public.user_role_enum END,\r\n    true\r\n  );\r\n\r\n  UPDATE public.profiles \r\n  SET is_active = true \r\n  WHERE id = new.id AND is_first_user = true;\r\n\r\n  RETURN new;\r\nEND;\r\n$$;\r\n\r\n-- 3. Auto-confirm first user (Email verification)\r\nCREATE OR REPLACE FUNCTION public.handle_first_user_confirmation()\r\nRETURNS trigger\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER SET search_path = auth\r\nAS $$\r\nBEGIN\r\n  -- If no users exist yet, auto-confirm this first one\r\n  IF NOT EXISTS (SELECT 1 FROM auth.users) THEN\r\n    NEW.email_confirmed_at := NOW();\r\n    NEW.last_sign_in_at := NOW();\r\n  END IF;\r\n  RETURN NEW;\r\nEND;\r\n$$;\r\n\r\n-- Trigger for profile creation\r\nDROP TRIGGER IF EXISTS on_auth_user_created ON auth.users;\r\nCREATE TRIGGER on_auth_user_created\r\n  AFTER INSERT ON auth.users\r\n  FOR EACH ROW EXECUTE PROCEDURE public.handle_new_user();\r\n\r\n-- Trigger for auto-confirmation\r\nDROP TRIGGER IF EXISTS on_auth_user_created_confirm ON auth.users;\r\nCREATE TRIGGER on_auth_user_created_confirm\r\n  BEFORE INSERT ON auth.users\r\n  FOR EACH ROW EXECUTE PROCEDURE public.handle_first_user_confirmation();\r\n\r\n-- ==========================================\r\n-- STORAGE POLICIES\r\n-- ==========================================\r\n\r\n-- Initialize 'avatars' bucket\r\nINSERT INTO storage.buckets (id, name, public) \r\nVALUES ('avatars', 'avatars', true) \r\nON CONFLICT (id) DO UPDATE SET public = true;\r\n\r\nDROP POLICY IF EXISTS \"Avatar images are publicly accessible.\" ON storage.objects;\r\nCREATE POLICY \"Avatar images are publicly accessible.\" ON storage.objects FOR SELECT USING ( bucket_id = 'avatars' );\r\n\r\nDROP POLICY IF EXISTS \"Users can upload avatars.\" ON storage.objects;\r\nCREATE POLICY \"Users can upload avatars.\" ON storage.objects FOR INSERT WITH CHECK ( bucket_id = 'avatars' AND auth.role() = 'authenticated' );\r\n\r\nDROP POLICY IF EXISTS \"Users can update avatars.\" ON storage.objects;\r\nCREATE POLICY \"Users can update avatars.\" ON storage.objects FOR UPDATE USING ( bucket_id = 'avatars' AND auth.role() = 'authenticated' );\r\n\r\nDROP POLICY IF EXISTS \"Users can delete avatars.\" ON storage.objects;\r\nCREATE POLICY \"Users can delete avatars.\" ON storage.objects FOR DELETE USING ( bucket_id = 'avatars' AND auth.role() = 'authenticated' );\r\n\r\n-- ==========================================\r\n-- ADMIN RPC FUNCTIONS\r\n-- ==========================================\r\n\r\n-- Custom type for get_admin_users\r\nDROP TYPE IF EXISTS public.admin_user_data CASCADE;\r\nCREATE TYPE public.admin_user_data AS (\r\n    id uuid,\r\n    email text,\r\n    role public.user_role_enum,\r\n    created_at timestamptz,\r\n    is_active boolean\r\n);\r\n\r\n-- 1. Get List of Users for Admin\r\nCREATE OR REPLACE FUNCTION public.get_admin_users()\r\nRETURNS SETOF public.admin_user_data\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER\r\nSET search_path = public, auth\r\nAS $$\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\r\n        RAISE EXCEPTION 'Access denied.';\r\n    END IF;\r\n\r\n    RETURN QUERY\r\n    SELECT au.id, au.email::text, p.role, au.created_at, p.is_active\r\n    FROM auth.users au\r\n    LEFT JOIN public.profiles p ON au.id = p.id\r\n    ORDER BY au.created_at DESC;\r\nEND;\r\n$$;\r\n\r\n-- 2. Update User Role\r\nCREATE OR REPLACE FUNCTION public.set_user_role(target_user_id uuid, new_role text)\r\nRETURNS void\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER\r\nSET search_path = public, auth\r\nAS $$\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\r\n        RAISE EXCEPTION 'Access denied.';\r\n    END IF;\r\n\r\n    UPDATE public.profiles\r\n    SET role = new_role::public.user_role_enum\r\n    WHERE id = target_user_id;\r\nEND;\r\n$$;\r\n\r\n-- 3. Delete User Account\r\nCREATE OR REPLACE FUNCTION public.delete_user(target_user_id uuid)\r\nRETURNS void\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER\r\nSET search_path = public, auth\r\nAS $$\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\r\n        RAISE EXCEPTION 'Access denied.';\r\n    END IF;\r\n    \r\n    IF auth.uid() = target_user_id THEN\r\n        RAISE EXCEPTION 'Cannot delete yourself.';\r\n    END IF;\r\n\r\n    DELETE FROM auth.users WHERE id = target_user_id;\r\nEND;\r\n$$;\r\n\r\n-- 4. Admin Create New User\r\n-- IMPORTANT: All token/string columns MUST be set to '' (empty string), NOT NULL.\r\n-- Supabase Auth's Go scanner crashes with \"converting NULL to string is unsupported\"\r\n-- if any of these fields are NULL.\r\nCREATE OR REPLACE FUNCTION public.admin_create_user(\r\n  new_email text, \r\n  new_password text, \r\n  new_role text,\r\n  new_active boolean\r\n)\r\n RETURNS uuid\r\n LANGUAGE plpgsql\r\n SECURITY DEFINER\r\n SET search_path TO 'public', 'auth', 'extensions'\r\nAS $function$\r\nDECLARE\r\n    new_id uuid;\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\r\n        RAISE EXCEPTION 'Access denied.';\r\n    END IF;\r\n\r\n    new_id := gen_random_uuid();\r\n\r\n    INSERT INTO auth.users (\r\n        id, instance_id, aud, role, email, encrypted_password, \r\n        email_confirmed_at,         -- Auto-verify: skip email confirmation\r\n        confirmation_token,         -- Must be '' not NULL (Supabase Auth Go scanner)\r\n        recovery_token,             -- Must be '' not NULL\r\n        email_change_token_new,     -- Must be '' not NULL\r\n        email_change_token_current, -- Must be '' not NULL\r\n        reauthentication_token,     -- Must be '' not NULL\r\n        email_change,               -- Must be '' not NULL\r\n        phone_change,               -- Must be '' not NULL\r\n        phone_change_token,         -- Must be '' not NULL\r\n        raw_app_meta_data, raw_user_meta_data, created_at, updated_at\r\n    )\r\n    VALUES (\r\n        new_id, '00000000-0000-0000-0000-000000000000', 'authenticated', 'authenticated',\r\n        new_email, extensions.crypt(new_password, extensions.gen_salt('bf')),\r\n        now(),\r\n        '', '', '', '', '', '', '', '',\r\n        '{\"provider\":\"email\",\"providers\":[\"email\"]}', '{}', now(), now()\r\n    );\r\n\r\n    INSERT INTO public.profiles (id, role, is_active, created_at, updated_at)\r\n    VALUES (new_id, new_role::public.user_role_enum, new_active, now(), now())\r\n    ON CONFLICT (id) DO UPDATE SET role = EXCLUDED.role, is_active = EXCLUDED.is_active;\r\n    \r\n    RETURN new_id;\r\nEND;\r\n$function$;\r\n\r\n-- 5. Set User Active Status (Approve/Block)\r\nCREATE OR REPLACE FUNCTION public.set_user_active_status(target_user_id uuid, new_status boolean)\r\nRETURNS void\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER\r\nSET search_path = public, auth\r\nAS $$\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\r\n        RAISE EXCEPTION 'Access denied.';\r\n    END IF;\r\n\r\n    UPDATE public.profiles\r\n    SET is_active = new_status\r\n    WHERE id = target_user_id;\r\nEND;\r\n$$;\r\n13:[\"$\",\"div\",null,{\"className\":\"col-span-1 border border-stone-200 rounded-2xl overflow-hidden bg-[#1e1e1e] flex flex-col h-[400px]\",\"children\":[[\"$\",\"div\",null,{\"className\":\"bg-[#2d2d2d] px-4 py-2 flex items-center justify-between border-b border-stone-800\",\"children\":[\"$\",\"span\",null,{\"className\":\"text-stone-400 text-xs font-mono\",\"children\":\"docs/schema.sql\"}]}],[\"$\",\"div\",null,{\"className\":\"p-4 overflow-y-auto w-full flex-grow custom-scrollbar\",\"children\":[\"$\",\"pre\",null,{\"className\":\"text-xs sm:text-sm font-mono text-stone-300 leading-relaxed whitespace-pre\",\"children\":[\"$\",\"code\",null,{\"children\":\"$16\"}]}]}]]}]\n14:[\"$\",\"$L17\",null,{\"href\":\"/login\",\"className\":\"absolute top-6 left-6 z-20 flex items-center gap-2 text-stone-500 hover:text-stone-900 font-semibold text-sm transition-all duration-300 bg-white/60 px-5 py-2.5 rounded-full shadow-sm border border-stone-200 hover:border-stone-300 hover:shadow-md\",\"children\":[[\"$\",\"$L10\",null,{\"ref\":\"$undefined\",\"iconNode\":[[\"path\",{\"d\":\"m12 19-7-7 7-7\",\"key\":\"1l729n\"}],[\"path\",{\"d\":\"M19 12H5\",\"key\":\"x3x0zl\"}]],\"className\":\"lucide-arrow-left size-4\"}],\"Quay lại Đăng nhập\"]}]\n15:[\"$\",\"footer\",null,{\"className\":\"py-8 text-center text-sm text-stone-500 bg-transparent border-none mt-auto relative z-10 backdrop-blur-sm\",\"children\":[\"$\",\"div\",null,{\"className\":\"max-w-7xl mx-auto px-4\",\"children\":[false,[\"$\",\"p\",null,{\"className\":\"flex items-center justify-center gap-2 opacity-80 hover:opacity-100 transition-opacity\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://github.com/homielab/giapha-os\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"font-semibold text-stone-600 hover:text-amber-700 transition-colors inline-flex items-center gap-1.5\",\"children\":[[\"$\",\"svg\",null,{\"viewBox\":\"0 0 24 24\",\"width\":\"16\",\"height\":\"16\",\"stroke\":\"currentColor\",\"strokeWidth\":\"2\",\"fill\":\"none\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"children\":[\"$\",\"path\",null,{\"d\":\"M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22\"}]}],\"Gia Phả OS\"]}],\"by\",[\"$\",\"a\",null,{\"href\":\"https://homielab.com\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"font-semibold text-green-600 hover:text-amber-700 transition-colors inline-flex items-center gap-1.5\",\"children\":\"HomieLab\"}]]}]]}]}]\n","/setup/__PAGE__":"1:\"$Sreact.fragment\"\n2:I[58541,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\",\"/_next/static/chunks/10gp4~2wc-iyp.js\"],\"default\"]\n3:I[42593,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\",\"/_next/static/chunks/10gp4~2wc-iyp.js\"],\"default\"]\nb:I[22016,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\",\"/_next/static/chunks/10gp4~2wc-iyp.js\"],\"\"]\nc:I[97367,[\"/_next/static/chunks/01xlw8hd842-c.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\"],\"OutletBoundary\"]\nd:\"$Sreact.suspense\"\n4:T48e5,-- ==========================================\r\n-- GIAPHA-OS DATABASE SCHEMA\r\n-- ==========================================\r\n\r\n-- EXTENSIONS\r\nCREATE EXTENSION IF NOT EXISTS pgcrypto WITH SCHEMA extensions;\r\n\r\n-- ENUMS\r\n-- Gender types for family members\r\nDO $$ BEGIN\r\n    CREATE TYPE public.gender_enum AS ENUM ('male', 'female', 'other');\r\nEXCEPTION\r\n    WHEN duplicate_object THEN null;\r\nEND $$;\r\n\r\n-- Relationship types between family members\r\nDO $$ BEGIN\r\n    CREATE TYPE public.relationship_type_enum AS ENUM ('marriage', 'biological_child', 'adopted_child');\r\nEXCEPTION\r\n    WHEN duplicate_object THEN null;\r\nEND $$;\r\n\r\n-- System user roles\r\nDO $$ BEGIN\r\n    CREATE TYPE public.user_role_enum AS ENUM ('admin', 'editor', 'member');\r\nEXCEPTION\r\n    WHEN duplicate_object THEN null;\r\nEND $$;\r\n\r\n-- ==========================================\r\n-- UTILITY FUNCTIONS\r\n-- ==========================================\r\n\r\n-- Function to automatically update 'updated_at' timestamps\r\nCREATE OR REPLACE FUNCTION public.handle_updated_at()\r\nRETURNS TRIGGER AS $$\r\nBEGIN\r\n  NEW.updated_at = NOW();\r\n  RETURN NEW;\r\nEND;\r\n$$ LANGUAGE plpgsql;\r\n\r\n-- ==========================================\r\n-- TABLES (Data Preservation: No DROP TABLE commands)\r\n-- ==========================================\r\n\r\n-- PROFILES (Application users linked to Auth)\r\nCREATE TABLE IF NOT EXISTS public.profiles (\r\n  id UUID REFERENCES auth.users(id) ON DELETE CASCADE PRIMARY KEY,\r\n  role public.user_role_enum DEFAULT 'member' NOT NULL,\r\n  is_active BOOLEAN NOT NULL DEFAULT false,\r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW()\r\n);\r\n\r\n-- PERSONS (Core entity for family tree)\r\nCREATE TABLE IF NOT EXISTS public.persons (\r\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\r\n  full_name TEXT NOT NULL,\r\n  gender public.gender_enum NOT NULL,\r\n  \r\n  -- Date components (allows for partial dates where only year is known)\r\n  birth_year INT,\r\n  birth_month INT,\r\n  birth_day INT,\r\n  death_year INT,\r\n  death_month INT,\r\n  death_day INT,\r\n  death_lunar_year INT,\r\n  death_lunar_month INT,\r\n  death_lunar_day INT,\r\n  \r\n  is_deceased BOOLEAN NOT NULL DEFAULT FALSE,\r\n  is_in_law BOOLEAN NOT NULL DEFAULT FALSE,\r\n  birth_order INT,\r\n  generation INT,\r\n  other_names TEXT,\r\n  avatar_url TEXT,\r\n  note TEXT,\r\n  \r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW()\r\n);\r\n\r\n-- PERSON_DETAILS_PRIVATE (Sensitive data with restricted RLS)\r\nCREATE TABLE IF NOT EXISTS public.person_details_private (\r\n  person_id UUID REFERENCES public.persons(id) ON DELETE CASCADE PRIMARY KEY,\r\n  phone_number TEXT,\r\n  occupation TEXT,\r\n  current_residence TEXT,\r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW()\r\n);\r\n\r\n-- RELATIONSHIPS (Links between persons)\r\nCREATE TABLE IF NOT EXISTS public.relationships (\r\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\r\n  type public.relationship_type_enum NOT NULL,\r\n  person_a UUID REFERENCES public.persons(id) ON DELETE CASCADE NOT NULL,\r\n  person_b UUID REFERENCES public.persons(id) ON DELETE CASCADE NOT NULL,\r\n  note TEXT,\r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW(),\r\n  \r\n  -- Prevent self-relationships\r\n  CONSTRAINT no_self_relationship CHECK (person_a != person_b),\r\n  \r\n  -- Ensure unique relationships between pairs for a specific type\r\n  UNIQUE(person_a, person_b, type)\r\n);\r\n\r\n-- CUSTOM_EVENTS (User-created events)\r\nCREATE TABLE IF NOT EXISTS public.custom_events (\r\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\r\n  name TEXT NOT NULL,\r\n  content TEXT,\r\n  event_date DATE NOT NULL,\r\n  location TEXT,\r\n  created_by UUID REFERENCES public.profiles(id) DEFAULT auth.uid(),\r\n  \r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW()\r\n);\r\n\r\n-- ==========================================\r\n-- INDEXES\r\n-- ==========================================\r\n\r\n-- Relationship lookups\r\nCREATE INDEX IF NOT EXISTS idx_relationships_person_a ON public.relationships(person_a);\r\nCREATE INDEX IF NOT EXISTS idx_relationships_person_b ON public.relationships(person_b);\r\nCREATE INDEX IF NOT EXISTS idx_relationships_type ON public.relationships(type);\r\n\r\n-- Person filtering and sorting\r\nCREATE INDEX IF NOT EXISTS idx_persons_full_name ON public.persons(full_name);\r\nCREATE INDEX IF NOT EXISTS idx_persons_generation ON public.persons(generation);\r\nCREATE INDEX IF NOT EXISTS idx_persons_gender ON public.persons(gender);\r\nCREATE INDEX IF NOT EXISTS idx_persons_is_deceased ON public.persons(is_deceased);\r\nCREATE INDEX IF NOT EXISTS idx_persons_birth_year ON public.persons(birth_year);\r\n\r\n-- Profile lookups\r\nCREATE INDEX IF NOT EXISTS idx_profiles_role ON public.profiles(role);\r\nCREATE INDEX IF NOT EXISTS idx_profiles_is_active ON public.profiles(is_active);\r\n\r\n-- Custom events lookups\r\nCREATE INDEX IF NOT EXISTS idx_custom_events_date ON public.custom_events(event_date);\r\nCREATE INDEX IF NOT EXISTS idx_custom_events_created_by ON public.custom_events(created_by);\r\n\r\n-- ==========================================\r\n-- RLS POLICIES\r\n-- ==========================================\r\n\r\nALTER TABLE public.profiles ENABLE ROW LEVEL SECURITY;\r\nALTER TABLE public.persons ENABLE ROW LEVEL SECURITY;\r\nALTER TABLE public.person_details_private ENABLE ROW LEVEL SECURITY;\r\nALTER TABLE public.relationships ENABLE ROW LEVEL SECURITY;\r\n\r\n-- Helper function to check if user is admin\r\nCREATE OR REPLACE FUNCTION public.is_admin()\r\nRETURNS BOOLEAN AS $$\r\nBEGIN\r\n  RETURN EXISTS (\r\n    SELECT 1 FROM public.profiles\r\n    WHERE id = auth.uid() AND role = 'admin'\r\n  );\r\nEND;\r\n$$ LANGUAGE plpgsql SECURITY DEFINER;\r\n\r\n-- Helper function to check if user is editor\r\nCREATE OR REPLACE FUNCTION PUBLIC.IS_EDITOR()\r\nRETURNS BOOLEAN\r\nLANGUAGE PLPGSQL\r\nSECURITY DEFINER\r\nSET SEARCH_PATH = PUBLIC\r\nAS $$\r\nBEGIN\r\n  RETURN EXISTS (\r\n    SELECT 1 FROM public.profiles\r\n    WHERE id = auth.uid() AND role = 'editor'\r\n  );\r\nEND;\r\n$$;\r\nrevoke all on function public.is_editor() from public;\r\ngrant execute on function public.is_editor() to authenticated;\r\n\r\n-- PROFILES POLICIES\r\nDROP POLICY IF EXISTS \"Users can view own profile\" ON public.profiles;\r\nCREATE POLICY \"Users can view own profile\" ON public.profiles FOR SELECT USING (auth.uid() = id);\r\n\r\nDROP POLICY IF EXISTS \"Admins can view all profiles\" ON public.profiles;\r\nCREATE POLICY \"Admins can view all profiles\" ON public.profiles FOR SELECT USING (public.is_admin());\r\n\r\n-- PERSONS POLICIES\r\nDROP POLICY IF EXISTS \"Enable read access for authenticated users\" ON public.persons;\r\nCREATE POLICY \"Enable read access for authenticated users\" ON public.persons FOR SELECT TO authenticated USING (true);\r\n\r\nDROP POLICY IF EXISTS \"Admins can manage persons\" ON public.persons;\r\nDROP POLICY IF EXISTS \"Admins can insert persons\" ON public.persons;\r\nDROP POLICY IF EXISTS \"Admins can update persons\" ON public.persons;\r\nDROP POLICY IF EXISTS \"Admins can delete persons\" ON public.persons;\r\n\r\nCREATE POLICY \"Admins and Editors can insert persons\" ON public.persons FOR INSERT TO authenticated WITH CHECK (public.is_admin() OR public.is_editor());\r\nCREATE POLICY \"Admins and Editors can update persons\" ON public.persons FOR UPDATE TO authenticated USING (public.is_admin() OR public.is_editor()) WITH CHECK (public.is_admin() OR public.is_editor());\r\nCREATE POLICY \"Admins and Editors can delete persons\" ON public.persons FOR DELETE TO authenticated USING (public.is_admin() OR public.is_editor());\r\n\r\n-- PERSON_DETAILS_PRIVATE POLICIES\r\nDROP POLICY IF EXISTS \"Admins can view private details\" ON public.person_details_private;\r\nCREATE POLICY \"Admins can view private details\" ON public.person_details_private FOR SELECT TO authenticated USING (public.is_admin());\r\n\r\nDROP POLICY IF EXISTS \"Admins can manage private details\" ON public.person_details_private;\r\nCREATE POLICY \"Admins can manage private details\" ON public.person_details_private FOR ALL TO authenticated USING (public.is_admin());\r\n\r\n-- RELATIONSHIPS POLICIES\r\nDROP POLICY IF EXISTS \"Enable read access for authenticated users\" ON public.relationships;\r\nCREATE POLICY \"Enable read access for authenticated users\" ON public.relationships FOR SELECT TO authenticated USING (true);\r\n\r\nDROP POLICY IF EXISTS \"Admins can manage relationships\" ON public.relationships;\r\nDROP POLICY IF EXISTS \"Admins can insert relationships\" ON public.relationships;\r\nDROP POLICY IF EXISTS \"Admins can update relationships\" ON public.relationships;\r\nDROP POLICY IF EXISTS \"Admins can delete relationships\" ON public.relationships;\r\n\r\nCREATE POLICY \"Admins and Editors can insert relationships\" ON public.relationships FOR INSERT TO authenticated WITH CHECK (public.is_admin() OR public.is_editor());\r\nCREATE POLICY \"Admins and Editors can update relationships\" ON public.relationships FOR UPDATE TO authenticated USING (public.is_admin() OR public.is_editor()) WITH CHECK (public.is_admin() OR public.is_editor());\r\nCREATE POLICY \"Admins and Editors can delete relationships\" ON public.relationships FOR DELETE TO authenticated USING (public.is_admin() OR public.is_editor());\r\n\r\n-- CUSTOM_EVENTS POLICIES\r\nALTER TABLE public.custom_events ENABLE ROW LEVEL SECURITY;\r\n\r\nDROP POLICY IF EXISTS \"Enable read access for authenticated users\" ON public.custom_events;\r\nCREATE POLICY \"Enable read access for authenticated users\" ON public.custom_events FOR SELECT TO authenticated USING (true);\r\n\r\nDROP POLICY IF EXISTS \"Authenticated users can insert custom events\" ON public.custom_events;\r\nCREATE POLICY \"Authenticated users can insert custom events\" ON public.custom_events FOR INSERT TO authenticated WITH CHECK (auth.uid() = created_by);\r\n\r\nDROP POLICY IF EXISTS \"Users can update own custom events\" ON public.custom_events;\r\nCREATE POLICY \"Users can update own custom events\" ON public.custom_events FOR UPDATE TO authenticated USING (auth.uid() = created_by OR public.is_admin());\r\n\r\nDROP POLICY IF EXISTS \"Users can delete own custom events\" ON public.custom_events;\r\nCREATE POLICY \"Users can delete own custom events\" ON public.custom_events FOR DELETE TO authenticated USING (auth.uid() = created_by OR public.is_admin());\r\n\r\n-- ==========================================\r\n-- TRIGGERS\r\n-- ==========================================\r\n\r\n-- 1. Updated At Triggers\r\nDROP TRIGGER IF EXISTS tr_profiles_updated_at ON public.profiles;\r\nCREATE TRIGGER tr_profiles_updated_at BEFORE UPDATE ON public.profiles FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\nDROP TRIGGER IF EXISTS tr_persons_updated_at ON public.persons;\r\nCREATE TRIGGER tr_persons_updated_at BEFORE UPDATE ON public.persons FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\nDROP TRIGGER IF EXISTS tr_person_details_private_updated_at ON public.person_details_private;\r\nCREATE TRIGGER tr_person_details_private_updated_at BEFORE UPDATE ON public.person_details_private FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\nDROP TRIGGER IF EXISTS tr_relationships_updated_at ON public.relationships;\r\nCREATE TRIGGER tr_relationships_updated_at BEFORE UPDATE ON public.relationships FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\nDROP TRIGGER IF EXISTS tr_custom_events_updated_at ON public.custom_events;\r\nCREATE TRIGGER tr_custom_events_updated_at BEFORE UPDATE ON public.custom_events FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\n-- 2. Handle new user signup (Profile creation)\r\nCREATE OR REPLACE FUNCTION public.handle_new_user()\r\nRETURNS trigger \r\nLANGUAGE plpgsql\r\nSECURITY DEFINER SET search_path = public, auth\r\nAS $$\r\nDECLARE\r\n  is_first_user boolean;\r\nBEGIN\r\n  -- Check if this is the first user (count will be 1 as this is AFTER INSERT)\r\n  SELECT count(*) = 1 FROM auth.users INTO is_first_user;\r\n\r\n  INSERT INTO public.profiles (id, role, is_active)\r\n  VALUES (\r\n    new.id, \r\n    CASE WHEN is_first_user THEN 'admin'::public.user_role_enum ELSE 'member'::public.user_role_enum END,\r\n    true\r\n  );\r\n\r\n  UPDATE public.profiles \r\n  SET is_active = true \r\n  WHERE id = new.id AND is_first_user = true;\r\n\r\n  RETURN new;\r\nEND;\r\n$$;\r\n\r\n-- 3. Auto-confirm first user (Email verification)\r\nCREATE OR REPLACE FUNCTION public.handle_first_user_confirmation()\r\nRETURNS trigger\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER SET search_path = auth\r\nAS $$\r\nBEGIN\r\n  -- If no users exist yet, auto-confirm this first one\r\n  IF NOT EXISTS (SELECT 1 FROM auth.users) THEN\r\n    NEW.email_confirmed_at := NOW();\r\n    NEW.last_sign_in_at := NOW();\r\n  END IF;\r\n  RETURN NEW;\r\nEND;\r\n$$;\r\n\r\n-- Trigger for profile creation\r\nDROP TRIGGER IF EXISTS on_auth_user_created ON auth.users;\r\nCREATE TRIGGER on_auth_user_created\r\n  AFTER INSERT ON auth.users\r\n  FOR EACH ROW EXECUTE PROCEDURE public.handle_new_user();\r\n\r\n-- Trigger for auto-confirmation\r\nDROP TRIGGER IF EXISTS on_auth_user_created_confirm ON auth.users;\r\nCREATE TRIGGER on_auth_user_created_confirm\r\n  BEFORE INSERT ON auth.users\r\n  FOR EACH ROW EXECUTE PROCEDURE public.handle_first_user_confirmation();\r\n\r\n-- ==========================================\r\n-- STORAGE POLICIES\r\n-- ==========================================\r\n\r\n-- Initialize 'avatars' bucket\r\nINSERT INTO storage.buckets (id, name, public) \r\nVALUES ('avatars', 'avatars', true) \r\nON CONFLICT (id) DO UPDATE SET public = true;\r\n\r\nDROP POLICY IF EXISTS \"Avatar images are publicly accessible.\" ON storage.objects;\r\nCREATE POLICY \"Avatar images are publicly accessible.\" ON storage.objects FOR SELECT USING ( bucket_id = 'avatars' );\r\n\r\nDROP POLICY IF EXISTS \"Users can upload avatars.\" ON storage.objects;\r\nCREATE POLICY \"Users can upload avatars.\" ON storage.objects FOR INSERT WITH CHECK ( bucket_id = 'avatars' AND auth.role() = 'authenticated' );\r\n\r\nDROP POLICY IF EXISTS \"Users can update avatars.\" ON storage.objects;\r\nCREATE POLICY \"Users can update avatars.\" ON storage.objects FOR UPDATE USING ( bucket_id = 'avatars' AND auth.role() = 'authenticated' );\r\n\r\nDROP POLICY IF EXISTS \"Users can delete avatars.\" ON storage.objects;\r\nCREATE POLICY \"Users can delete avatars.\" ON storage.objects FOR DELETE USING ( bucket_id = 'avatars' AND auth.role() = 'authenticated' );\r\n\r\n-- ==========================================\r\n-- ADMIN RPC FUNCTIONS\r\n-- ==========================================\r\n\r\n-- Custom type for get_admin_users\r\nDROP TYPE IF EXISTS public.admin_user_data CASCADE;\r\nCREATE TYPE public.admin_user_data AS (\r\n    id uuid,\r\n    email text,\r\n    role public.user_role_enum,\r\n    created_at timestamptz,\r\n    is_active boolean\r\n);\r\n\r\n-- 1. Get List of Users for Admin\r\nCREATE OR REPLACE FUNCTION public.get_admin_users()\r\nRETURNS SETOF public.admin_user_data\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER\r\nSET search_path = public, auth\r\nAS $$\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\r\n        RAISE EXCEPTION 'Access denied.';\r\n    END IF;\r\n\r\n    RETURN QUERY\r\n    SELECT au.id, au.email::text, p.role, au.created_at, p.is_active\r\n    FROM auth.users au\r\n    LEFT JOIN public.profiles p ON au.id = p.id\r\n    ORDER BY au.created_at DESC;\r\nEND;\r\n$$;\r\n\r\n-- 2. Update User Role\r\nCREATE OR REPLACE FUNCTION public.set_user_role(target_user_id uuid, new_role text)\r\nRETURNS void\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER\r\nSET search_path = public, auth\r\nAS $$\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\r\n        RAISE EXCEPTION 'Access denied.';\r\n    END IF;\r\n\r\n    UPDATE public.profiles\r\n    SET role = new_role::public.user_role_enum\r\n    WHERE id = target_user_id;\r\nEND;\r\n$$;\r\n\r\n-- 3. Delete User Account\r\nCREATE OR REPLACE FUNCTION public.delete_user(target_user_id uuid)\r\nRETURNS void\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER\r\nSET search_path = public, auth\r\nAS $$\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\r\n        RAISE EXCEPTION 'Access denied.';\r\n    END IF;\r\n    \r\n    IF auth.uid() = target_user_id THEN\r\n        RAISE EXCEPTION 'Cannot delete yourself.';\r\n    END IF;\r\n\r\n    DELETE FROM auth.users WHERE id = target_user_id;\r\nEND;\r\n$$;\r\n\r\n-- 4. Admin Create New User\r\n-- IMPORTANT: All token/string columns MUST be set to '' (empty string), NOT NULL.\r\n-- Supabase Auth's Go scanner crashes with \"converting NULL to string is unsupported\"\r\n-- if any of these fields are NULL.\r\nCREATE OR REPLACE FUNCTION public.admin_create_user(\r\n  new_email text, \r\n  new_password text, \r\n  new_role text,\r\n  new_active boolean\r\n)\r\n RETURNS uuid\r\n LANGUAGE plpgsql\r\n SECURITY DEFINER\r\n SET search_path TO 'public', 'auth', 'extensions'\r\nAS $function$\r\nDECLARE\r\n    new_id uuid;\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\r\n        RAISE EXCEPTION 'Access denied.';\r\n    END IF;\r\n\r\n    new_id := gen_random_uuid();\r\n\r\n    INSERT INTO auth.users (\r\n        id, instance_id, aud, role, email, encrypted_password, \r\n        email_confirmed_at,         -- Auto-verify: skip email confirmation\r\n        confirmation_token,         -- Must be '' not NULL (Supabase Auth Go scanner)\r\n        recovery_token,             -- Must be '' not NULL\r\n        email_change_token_new,     -- Must be '' not NULL\r\n        email_change_token_current, -- Must be '' not NULL\r\n        reauthentication_token,     -- Must be '' not NULL\r\n        email_change,               -- Must be '' not NULL\r\n        phone_change,               -- Must be '' not NULL\r\n        phone_change_token,         -- Must be '' not NULL\r\n        raw_app_meta_data, raw_user_meta_data, created_at, updated_at\r\n    )\r\n    VALUES (\r\n        new_id, '00000000-0000-0000-0000-000000000000', 'authenticated', 'authenticated',\r\n        new_email, extensions.crypt(new_password, extensions.gen_salt('bf')),\r\n        now(),\r\n        '', '', '', '', '', '', '', '',\r\n        '{\"provider\":\"email\",\"providers\":[\"email\"]}', '{}', now(), now()\r\n    );\r\n\r\n    INSERT INTO public.profiles (id, role, is_active, created_at, updated_at)\r\n    VALUES (new_id, new_role::public.user_role_enum, new_active, now(), now())\r\n    ON CONFLICT (id) DO UPDATE SET role = EXCLUDED.role, is_active = EXCLUDED.is_active;\r\n    \r\n    RETURN new_id;\r\nEND;\r\n$function$;\r\n\r\n-- 5. Set User Active Status (Approve/Block)\r\nCREATE OR REPLACE FUNCTION public.set_user_active_status(target_user_id uuid, new_status boolean)\r\nRETURNS void\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER\r\nSET search_path = public, auth\r\nAS $$\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\r\n        RAISE EXCEPTION 'Access denied.';\r\n    END IF;\r\n\r\n    UPDATE public.profiles\r\n    SET is_active = new_status\r\n    WHERE id = target_user_id;\r\nEND;\r\n$$;\r\n0:{\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"min-h-screen flex flex-col bg-[#fafaf9] select-none selection:bg-amber-200 selection:text-amber-900 relative overflow-hidden\",\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute inset-0 bg-[linear-gradient(to_right,#80808008_1px,transparent_1px),linear-gradient(to_bottom,#80808008_1px,transparent_1px)] bg-size-[24px_24px] pointer-events-none\"}],[\"$\",\"div\",null,{\"className\":\"absolute top-0 inset-x-0 h-screen overflow-hidden pointer-events-none flex justify-center\",\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute top-[-10%] right-[-5%] w-[50vw] h-[50vw] max-w-[600px] max-h-[600px] bg-indigo-300/20 rounded-full blur-[100px] mix-blend-multiply\"}],[\"$\",\"div\",null,{\"className\":\"absolute bottom-[0%] left-[-10%] w-[60vw] h-[60vw] max-w-[800px] max-h-[800px] bg-teal-200/20 rounded-full blur-[120px] mix-blend-multiply\"}]]}],[\"$\",\"div\",null,{\"className\":\"flex-1 flex flex-col items-center px-4 py-12 relative z-10 w-full max-w-5xl mx-auto\",\"children\":[\"$\",\"div\",null,{\"className\":\"w-full bg-white p-8 sm:p-10 rounded-3xl shadow-xl border border-stone-200 relative overflow-hidden mb-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-4 mb-6\",\"children\":[[\"$\",\"div\",null,{\"className\":\"p-4 bg-indigo-50 text-indigo-600 rounded-2xl\",\"children\":[\"$\",\"$L2\",null,{\"iconNode\":[[\"ellipse\",{\"cx\":\"12\",\"cy\":\"5\",\"rx\":\"9\",\"ry\":\"3\",\"key\":\"msslwz\"}],[\"path\",{\"d\":\"M3 5V19A9 3 0 0 0 21 19V5\",\"key\":\"1wlel7\"}],[\"path\",{\"d\":\"M3 12A9 3 0 0 0 21 12\",\"key\":\"mv7ke4\"}]],\"className\":\"lucide-database size-8\"}]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-bold text-stone-900 tracking-tight\",\"children\":\"Khởi tạo Cơ sở dữ liệu\"}],[\"$\",\"p\",null,{\"className\":\"text-stone-500 font-medium\",\"children\":\"Hệ thống phát hiện database của bạn chưa được thiết lập cấu trúc bảng (schema).\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 md:grid-cols-2 gap-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"space-y-6\",\"children\":[\"$\",\"div\",null,{\"className\":\"bg-stone-50 border border-stone-200 rounded-2xl p-6 h-full\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-stone-900 mb-4 flex items-center gap-2\",\"children\":[[\"$\",\"$L2\",null,{\"iconNode\":[[\"path\",{\"d\":\"M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z\",\"key\":\"10ikf1\"}]],\"className\":\"lucide-play size-5 text-stone-500\"}],\"Hướng dẫn thực hiện:\"]}],[\"$\",\"ol\",null,{\"className\":\"list-decimal list-inside space-y-4 text-stone-600\",\"children\":[[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[\"Bấm nút\",\" \",[\"$\",\"strong\",null,{\"className\":\"text-indigo-600\",\"children\":\"Copy Mã SQL\"}],\" ở bên dưới để sao chép toàn bộ cấu trúc cơ sở dữ liệu.\"]}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[\"Mở\",\" \",[\"$\",\"a\",null,{\"href\":\"https://supabase.com/dashboard/project/_/sql/new\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-amber-600 font-semibold hover:underline\",\"children\":\"Supabase SQL Editor\"}],\" \",\"trong dự án của bạn.\"]}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"Dán (Paste)\"}],\" mã vừa copy vào khung soạn thảo của Supabase.\"]}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[\"Bấm nút \",[\"$\",\"strong\",null,{\"children\":\"RUN\"}],\" (Chạy) ở góc phải dưới cùng màn hình Supabase.\"]}],[\"$\",\"li\",null,{\"className\":\"leading-relaxed\",\"children\":[\"Quay lại đây và \",[\"$\",\"strong\",null,{\"children\":\"Tải lại trang\"}],\" (hoặc bấm Đăng nhập lại).\"]}]]}],[\"$\",\"div\",null,{\"className\":\"mt-8\",\"children\":[\"$\",\"$L3\",null,{\"content\":\"$4\"}]}]]}]}],\"$L5\"]}]]}]}],\"$L6\",\"$L7\"]}],[\"$L8\"],\"$L9\"]}],\"isPartial\":false,\"staleTime\":300,\"varyParams\":null,\"buildId\":\"WOoep__bZIeFRofyAsxc8\"}\na:T48e5,-- ==========================================\r\n-- GIAPHA-OS DATABASE SCHEMA\r\n-- ==========================================\r\n\r\n-- EXTENSIONS\r\nCREATE EXTENSION IF NOT EXISTS pgcrypto WITH SCHEMA extensions;\r\n\r\n-- ENUMS\r\n-- Gender types for family members\r\nDO $$ BEGIN\r\n    CREATE TYPE public.gender_enum AS ENUM ('male', 'female', 'other');\r\nEXCEPTION\r\n    WHEN duplicate_object THEN null;\r\nEND $$;\r\n\r\n-- Relationship types between family members\r\nDO $$ BEGIN\r\n    CREATE TYPE public.relationship_type_enum AS ENUM ('marriage', 'biological_child', 'adopted_child');\r\nEXCEPTION\r\n    WHEN duplicate_object THEN null;\r\nEND $$;\r\n\r\n-- System user roles\r\nDO $$ BEGIN\r\n    CREATE TYPE public.user_role_enum AS ENUM ('admin', 'editor', 'member');\r\nEXCEPTION\r\n    WHEN duplicate_object THEN null;\r\nEND $$;\r\n\r\n-- ==========================================\r\n-- UTILITY FUNCTIONS\r\n-- ==========================================\r\n\r\n-- Function to automatically update 'updated_at' timestamps\r\nCREATE OR REPLACE FUNCTION public.handle_updated_at()\r\nRETURNS TRIGGER AS $$\r\nBEGIN\r\n  NEW.updated_at = NOW();\r\n  RETURN NEW;\r\nEND;\r\n$$ LANGUAGE plpgsql;\r\n\r\n-- ==========================================\r\n-- TABLES (Data Preservation: No DROP TABLE commands)\r\n-- ==========================================\r\n\r\n-- PROFILES (Application users linked to Auth)\r\nCREATE TABLE IF NOT EXISTS public.profiles (\r\n  id UUID REFERENCES auth.users(id) ON DELETE CASCADE PRIMARY KEY,\r\n  role public.user_role_enum DEFAULT 'member' NOT NULL,\r\n  is_active BOOLEAN NOT NULL DEFAULT false,\r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW()\r\n);\r\n\r\n-- PERSONS (Core entity for family tree)\r\nCREATE TABLE IF NOT EXISTS public.persons (\r\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\r\n  full_name TEXT NOT NULL,\r\n  gender public.gender_enum NOT NULL,\r\n  \r\n  -- Date components (allows for partial dates where only year is known)\r\n  birth_year INT,\r\n  birth_month INT,\r\n  birth_day INT,\r\n  death_year INT,\r\n  death_month INT,\r\n  death_day INT,\r\n  death_lunar_year INT,\r\n  death_lunar_month INT,\r\n  death_lunar_day INT,\r\n  \r\n  is_deceased BOOLEAN NOT NULL DEFAULT FALSE,\r\n  is_in_law BOOLEAN NOT NULL DEFAULT FALSE,\r\n  birth_order INT,\r\n  generation INT,\r\n  other_names TEXT,\r\n  avatar_url TEXT,\r\n  note TEXT,\r\n  \r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW()\r\n);\r\n\r\n-- PERSON_DETAILS_PRIVATE (Sensitive data with restricted RLS)\r\nCREATE TABLE IF NOT EXISTS public.person_details_private (\r\n  person_id UUID REFERENCES public.persons(id) ON DELETE CASCADE PRIMARY KEY,\r\n  phone_number TEXT,\r\n  occupation TEXT,\r\n  current_residence TEXT,\r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW()\r\n);\r\n\r\n-- RELATIONSHIPS (Links between persons)\r\nCREATE TABLE IF NOT EXISTS public.relationships (\r\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\r\n  type public.relationship_type_enum NOT NULL,\r\n  person_a UUID REFERENCES public.persons(id) ON DELETE CASCADE NOT NULL,\r\n  person_b UUID REFERENCES public.persons(id) ON DELETE CASCADE NOT NULL,\r\n  note TEXT,\r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW(),\r\n  \r\n  -- Prevent self-relationships\r\n  CONSTRAINT no_self_relationship CHECK (person_a != person_b),\r\n  \r\n  -- Ensure unique relationships between pairs for a specific type\r\n  UNIQUE(person_a, person_b, type)\r\n);\r\n\r\n-- CUSTOM_EVENTS (User-created events)\r\nCREATE TABLE IF NOT EXISTS public.custom_events (\r\n  id UUID DEFAULT gen_random_uuid() PRIMARY KEY,\r\n  name TEXT NOT NULL,\r\n  content TEXT,\r\n  event_date DATE NOT NULL,\r\n  location TEXT,\r\n  created_by UUID REFERENCES public.profiles(id) DEFAULT auth.uid(),\r\n  \r\n  created_at TIMESTAMPTZ DEFAULT NOW(),\r\n  updated_at TIMESTAMPTZ DEFAULT NOW()\r\n);\r\n\r\n-- ==========================================\r\n-- INDEXES\r\n-- ==========================================\r\n\r\n-- Relationship lookups\r\nCREATE INDEX IF NOT EXISTS idx_relationships_person_a ON public.relationships(person_a);\r\nCREATE INDEX IF NOT EXISTS idx_relationships_person_b ON public.relationships(person_b);\r\nCREATE INDEX IF NOT EXISTS idx_relationships_type ON public.relationships(type);\r\n\r\n-- Person filtering and sorting\r\nCREATE INDEX IF NOT EXISTS idx_persons_full_name ON public.persons(full_name);\r\nCREATE INDEX IF NOT EXISTS idx_persons_generation ON public.persons(generation);\r\nCREATE INDEX IF NOT EXISTS idx_persons_gender ON public.persons(gender);\r\nCREATE INDEX IF NOT EXISTS idx_persons_is_deceased ON public.persons(is_deceased);\r\nCREATE INDEX IF NOT EXISTS idx_persons_birth_year ON public.persons(birth_year);\r\n\r\n-- Profile lookups\r\nCREATE INDEX IF NOT EXISTS idx_profiles_role ON public.profiles(role);\r\nCREATE INDEX IF NOT EXISTS idx_profiles_is_active ON public.profiles(is_active);\r\n\r\n-- Custom events lookups\r\nCREATE INDEX IF NOT EXISTS idx_custom_events_date ON public.custom_events(event_date);\r\nCREATE INDEX IF NOT EXISTS idx_custom_events_created_by ON public.custom_events(created_by);\r\n\r\n-- ==========================================\r\n-- RLS POLICIES\r\n-- ==========================================\r\n\r\nALTER TABLE public.profiles ENABLE ROW LEVEL SECURITY;\r\nALTER TABLE public.persons ENABLE ROW LEVEL SECURITY;\r\nALTER TABLE public.person_details_private ENABLE ROW LEVEL SECURITY;\r\nALTER TABLE public.relationships ENABLE ROW LEVEL SECURITY;\r\n\r\n-- Helper function to check if user is admin\r\nCREATE OR REPLACE FUNCTION public.is_admin()\r\nRETURNS BOOLEAN AS $$\r\nBEGIN\r\n  RETURN EXISTS (\r\n    SELECT 1 FROM public.profiles\r\n    WHERE id = auth.uid() AND role = 'admin'\r\n  );\r\nEND;\r\n$$ LANGUAGE plpgsql SECURITY DEFINER;\r\n\r\n-- Helper function to check if user is editor\r\nCREATE OR REPLACE FUNCTION PUBLIC.IS_EDITOR()\r\nRETURNS BOOLEAN\r\nLANGUAGE PLPGSQL\r\nSECURITY DEFINER\r\nSET SEARCH_PATH = PUBLIC\r\nAS $$\r\nBEGIN\r\n  RETURN EXISTS (\r\n    SELECT 1 FROM public.profiles\r\n    WHERE id = auth.uid() AND role = 'editor'\r\n  );\r\nEND;\r\n$$;\r\nrevoke all on function public.is_editor() from public;\r\ngrant execute on function public.is_editor() to authenticated;\r\n\r\n-- PROFILES POLICIES\r\nDROP POLICY IF EXISTS \"Users can view own profile\" ON public.profiles;\r\nCREATE POLICY \"Users can view own profile\" ON public.profiles FOR SELECT USING (auth.uid() = id);\r\n\r\nDROP POLICY IF EXISTS \"Admins can view all profiles\" ON public.profiles;\r\nCREATE POLICY \"Admins can view all profiles\" ON public.profiles FOR SELECT USING (public.is_admin());\r\n\r\n-- PERSONS POLICIES\r\nDROP POLICY IF EXISTS \"Enable read access for authenticated users\" ON public.persons;\r\nCREATE POLICY \"Enable read access for authenticated users\" ON public.persons FOR SELECT TO authenticated USING (true);\r\n\r\nDROP POLICY IF EXISTS \"Admins can manage persons\" ON public.persons;\r\nDROP POLICY IF EXISTS \"Admins can insert persons\" ON public.persons;\r\nDROP POLICY IF EXISTS \"Admins can update persons\" ON public.persons;\r\nDROP POLICY IF EXISTS \"Admins can delete persons\" ON public.persons;\r\n\r\nCREATE POLICY \"Admins and Editors can insert persons\" ON public.persons FOR INSERT TO authenticated WITH CHECK (public.is_admin() OR public.is_editor());\r\nCREATE POLICY \"Admins and Editors can update persons\" ON public.persons FOR UPDATE TO authenticated USING (public.is_admin() OR public.is_editor()) WITH CHECK (public.is_admin() OR public.is_editor());\r\nCREATE POLICY \"Admins and Editors can delete persons\" ON public.persons FOR DELETE TO authenticated USING (public.is_admin() OR public.is_editor());\r\n\r\n-- PERSON_DETAILS_PRIVATE POLICIES\r\nDROP POLICY IF EXISTS \"Admins can view private details\" ON public.person_details_private;\r\nCREATE POLICY \"Admins can view private details\" ON public.person_details_private FOR SELECT TO authenticated USING (public.is_admin());\r\n\r\nDROP POLICY IF EXISTS \"Admins can manage private details\" ON public.person_details_private;\r\nCREATE POLICY \"Admins can manage private details\" ON public.person_details_private FOR ALL TO authenticated USING (public.is_admin());\r\n\r\n-- RELATIONSHIPS POLICIES\r\nDROP POLICY IF EXISTS \"Enable read access for authenticated users\" ON public.relationships;\r\nCREATE POLICY \"Enable read access for authenticated users\" ON public.relationships FOR SELECT TO authenticated USING (true);\r\n\r\nDROP POLICY IF EXISTS \"Admins can manage relationships\" ON public.relationships;\r\nDROP POLICY IF EXISTS \"Admins can insert relationships\" ON public.relationships;\r\nDROP POLICY IF EXISTS \"Admins can update relationships\" ON public.relationships;\r\nDROP POLICY IF EXISTS \"Admins can delete relationships\" ON public.relationships;\r\n\r\nCREATE POLICY \"Admins and Editors can insert relationships\" ON public.relationships FOR INSERT TO authenticated WITH CHECK (public.is_admin() OR public.is_editor());\r\nCREATE POLICY \"Admins and Editors can update relationships\" ON public.relationships FOR UPDATE TO authenticated USING (public.is_admin() OR public.is_editor()) WITH CHECK (public.is_admin() OR public.is_editor());\r\nCREATE POLICY \"Admins and Editors can delete relationships\" ON public.relationships FOR DELETE TO authenticated USING (public.is_admin() OR public.is_editor());\r\n\r\n-- CUSTOM_EVENTS POLICIES\r\nALTER TABLE public.custom_events ENABLE ROW LEVEL SECURITY;\r\n\r\nDROP POLICY IF EXISTS \"Enable read access for authenticated users\" ON public.custom_events;\r\nCREATE POLICY \"Enable read access for authenticated users\" ON public.custom_events FOR SELECT TO authenticated USING (true);\r\n\r\nDROP POLICY IF EXISTS \"Authenticated users can insert custom events\" ON public.custom_events;\r\nCREATE POLICY \"Authenticated users can insert custom events\" ON public.custom_events FOR INSERT TO authenticated WITH CHECK (auth.uid() = created_by);\r\n\r\nDROP POLICY IF EXISTS \"Users can update own custom events\" ON public.custom_events;\r\nCREATE POLICY \"Users can update own custom events\" ON public.custom_events FOR UPDATE TO authenticated USING (auth.uid() = created_by OR public.is_admin());\r\n\r\nDROP POLICY IF EXISTS \"Users can delete own custom events\" ON public.custom_events;\r\nCREATE POLICY \"Users can delete own custom events\" ON public.custom_events FOR DELETE TO authenticated USING (auth.uid() = created_by OR public.is_admin());\r\n\r\n-- ==========================================\r\n-- TRIGGERS\r\n-- ==========================================\r\n\r\n-- 1. Updated At Triggers\r\nDROP TRIGGER IF EXISTS tr_profiles_updated_at ON public.profiles;\r\nCREATE TRIGGER tr_profiles_updated_at BEFORE UPDATE ON public.profiles FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\nDROP TRIGGER IF EXISTS tr_persons_updated_at ON public.persons;\r\nCREATE TRIGGER tr_persons_updated_at BEFORE UPDATE ON public.persons FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\nDROP TRIGGER IF EXISTS tr_person_details_private_updated_at ON public.person_details_private;\r\nCREATE TRIGGER tr_person_details_private_updated_at BEFORE UPDATE ON public.person_details_private FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\nDROP TRIGGER IF EXISTS tr_relationships_updated_at ON public.relationships;\r\nCREATE TRIGGER tr_relationships_updated_at BEFORE UPDATE ON public.relationships FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\nDROP TRIGGER IF EXISTS tr_custom_events_updated_at ON public.custom_events;\r\nCREATE TRIGGER tr_custom_events_updated_at BEFORE UPDATE ON public.custom_events FOR EACH ROW EXECUTE PROCEDURE public.handle_updated_at();\r\n\r\n-- 2. Handle new user signup (Profile creation)\r\nCREATE OR REPLACE FUNCTION public.handle_new_user()\r\nRETURNS trigger \r\nLANGUAGE plpgsql\r\nSECURITY DEFINER SET search_path = public, auth\r\nAS $$\r\nDECLARE\r\n  is_first_user boolean;\r\nBEGIN\r\n  -- Check if this is the first user (count will be 1 as this is AFTER INSERT)\r\n  SELECT count(*) = 1 FROM auth.users INTO is_first_user;\r\n\r\n  INSERT INTO public.profiles (id, role, is_active)\r\n  VALUES (\r\n    new.id, \r\n    CASE WHEN is_first_user THEN 'admin'::public.user_role_enum ELSE 'member'::public.user_role_enum END,\r\n    true\r\n  );\r\n\r\n  UPDATE public.profiles \r\n  SET is_active = true \r\n  WHERE id = new.id AND is_first_user = true;\r\n\r\n  RETURN new;\r\nEND;\r\n$$;\r\n\r\n-- 3. Auto-confirm first user (Email verification)\r\nCREATE OR REPLACE FUNCTION public.handle_first_user_confirmation()\r\nRETURNS trigger\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER SET search_path = auth\r\nAS $$\r\nBEGIN\r\n  -- If no users exist yet, auto-confirm this first one\r\n  IF NOT EXISTS (SELECT 1 FROM auth.users) THEN\r\n    NEW.email_confirmed_at := NOW();\r\n    NEW.last_sign_in_at := NOW();\r\n  END IF;\r\n  RETURN NEW;\r\nEND;\r\n$$;\r\n\r\n-- Trigger for profile creation\r\nDROP TRIGGER IF EXISTS on_auth_user_created ON auth.users;\r\nCREATE TRIGGER on_auth_user_created\r\n  AFTER INSERT ON auth.users\r\n  FOR EACH ROW EXECUTE PROCEDURE public.handle_new_user();\r\n\r\n-- Trigger for auto-confirmation\r\nDROP TRIGGER IF EXISTS on_auth_user_created_confirm ON auth.users;\r\nCREATE TRIGGER on_auth_user_created_confirm\r\n  BEFORE INSERT ON auth.users\r\n  FOR EACH ROW EXECUTE PROCEDURE public.handle_first_user_confirmation();\r\n\r\n-- ==========================================\r\n-- STORAGE POLICIES\r\n-- ==========================================\r\n\r\n-- Initialize 'avatars' bucket\r\nINSERT INTO storage.buckets (id, name, public) \r\nVALUES ('avatars', 'avatars', true) \r\nON CONFLICT (id) DO UPDATE SET public = true;\r\n\r\nDROP POLICY IF EXISTS \"Avatar images are publicly accessible.\" ON storage.objects;\r\nCREATE POLICY \"Avatar images are publicly accessible.\" ON storage.objects FOR SELECT USING ( bucket_id = 'avatars' );\r\n\r\nDROP POLICY IF EXISTS \"Users can upload avatars.\" ON storage.objects;\r\nCREATE POLICY \"Users can upload avatars.\" ON storage.objects FOR INSERT WITH CHECK ( bucket_id = 'avatars' AND auth.role() = 'authenticated' );\r\n\r\nDROP POLICY IF EXISTS \"Users can update avatars.\" ON storage.objects;\r\nCREATE POLICY \"Users can update avatars.\" ON storage.objects FOR UPDATE USING ( bucket_id = 'avatars' AND auth.role() = 'authenticated' );\r\n\r\nDROP POLICY IF EXISTS \"Users can delete avatars.\" ON storage.objects;\r\nCREATE POLICY \"Users can delete avatars.\" ON storage.objects FOR DELETE USING ( bucket_id = 'avatars' AND auth.role() = 'authenticated' );\r\n\r\n-- ==========================================\r\n-- ADMIN RPC FUNCTIONS\r\n-- ==========================================\r\n\r\n-- Custom type for get_admin_users\r\nDROP TYPE IF EXISTS public.admin_user_data CASCADE;\r\nCREATE TYPE public.admin_user_data AS (\r\n    id uuid,\r\n    email text,\r\n    role public.user_role_enum,\r\n    created_at timestamptz,\r\n    is_active boolean\r\n);\r\n\r\n-- 1. Get List of Users for Admin\r\nCREATE OR REPLACE FUNCTION public.get_admin_users()\r\nRETURNS SETOF public.admin_user_data\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER\r\nSET search_path = public, auth\r\nAS $$\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\r\n        RAISE EXCEPTION 'Access denied.';\r\n    END IF;\r\n\r\n    RETURN QUERY\r\n    SELECT au.id, au.email::text, p.role, au.created_at, p.is_active\r\n    FROM auth.users au\r\n    LEFT JOIN public.profiles p ON au.id = p.id\r\n    ORDER BY au.created_at DESC;\r\nEND;\r\n$$;\r\n\r\n-- 2. Update User Role\r\nCREATE OR REPLACE FUNCTION public.set_user_role(target_user_id uuid, new_role text)\r\nRETURNS void\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER\r\nSET search_path = public, auth\r\nAS $$\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\r\n        RAISE EXCEPTION 'Access denied.';\r\n    END IF;\r\n\r\n    UPDATE public.profiles\r\n    SET role = new_role::public.user_role_enum\r\n    WHERE id = target_user_id;\r\nEND;\r\n$$;\r\n\r\n-- 3. Delete User Account\r\nCREATE OR REPLACE FUNCTION public.delete_user(target_user_id uuid)\r\nRETURNS void\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER\r\nSET search_path = public, auth\r\nAS $$\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\r\n        RAISE EXCEPTION 'Access denied.';\r\n    END IF;\r\n    \r\n    IF auth.uid() = target_user_id THEN\r\n        RAISE EXCEPTION 'Cannot delete yourself.';\r\n    END IF;\r\n\r\n    DELETE FROM auth.users WHERE id = target_user_id;\r\nEND;\r\n$$;\r\n\r\n-- 4. Admin Create New User\r\n-- IMPORTANT: All token/string columns MUST be set to '' (empty string), NOT NULL.\r\n-- Supabase Auth's Go scanner crashes with \"converting NULL to string is unsupported\"\r\n-- if any of these fields are NULL.\r\nCREATE OR REPLACE FUNCTION public.admin_create_user(\r\n  new_email text, \r\n  new_password text, \r\n  new_role text,\r\n  new_active boolean\r\n)\r\n RETURNS uuid\r\n LANGUAGE plpgsql\r\n SECURITY DEFINER\r\n SET search_path TO 'public', 'auth', 'extensions'\r\nAS $function$\r\nDECLARE\r\n    new_id uuid;\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\r\n        RAISE EXCEPTION 'Access denied.';\r\n    END IF;\r\n\r\n    new_id := gen_random_uuid();\r\n\r\n    INSERT INTO auth.users (\r\n        id, instance_id, aud, role, email, encrypted_password, \r\n        email_confirmed_at,         -- Auto-verify: skip email confirmation\r\n        confirmation_token,         -- Must be '' not NULL (Supabase Auth Go scanner)\r\n        recovery_token,             -- Must be '' not NULL\r\n        email_change_token_new,     -- Must be '' not NULL\r\n        email_change_token_current, -- Must be '' not NULL\r\n        reauthentication_token,     -- Must be '' not NULL\r\n        email_change,               -- Must be '' not NULL\r\n        phone_change,               -- Must be '' not NULL\r\n        phone_change_token,         -- Must be '' not NULL\r\n        raw_app_meta_data, raw_user_meta_data, created_at, updated_at\r\n    )\r\n    VALUES (\r\n        new_id, '00000000-0000-0000-0000-000000000000', 'authenticated', 'authenticated',\r\n        new_email, extensions.crypt(new_password, extensions.gen_salt('bf')),\r\n        now(),\r\n        '', '', '', '', '', '', '', '',\r\n        '{\"provider\":\"email\",\"providers\":[\"email\"]}', '{}', now(), now()\r\n    );\r\n\r\n    INSERT INTO public.profiles (id, role, is_active, created_at, updated_at)\r\n    VALUES (new_id, new_role::public.user_role_enum, new_active, now(), now())\r\n    ON CONFLICT (id) DO UPDATE SET role = EXCLUDED.role, is_active = EXCLUDED.is_active;\r\n    \r\n    RETURN new_id;\r\nEND;\r\n$function$;\r\n\r\n-- 5. Set User Active Status (Approve/Block)\r\nCREATE OR REPLACE FUNCTION public.set_user_active_status(target_user_id uuid, new_status boolean)\r\nRETURNS void\r\nLANGUAGE plpgsql\r\nSECURITY DEFINER\r\nSET search_path = public, auth\r\nAS $$\r\nBEGIN\r\n    IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = auth.uid() AND role = 'admin') THEN\r\n        RAISE EXCEPTION 'Access denied.';\r\n    END IF;\r\n\r\n    UPDATE public.profiles\r\n    SET is_active = new_status\r\n    WHERE id = target_user_id;\r\nEND;\r\n$$;\r\n5:[\"$\",\"div\",null,{\"className\":\"col-span-1 border border-stone-200 rounded-2xl overflow-hidden bg-[#1e1e1e] flex flex-col h-[400px]\",\"children\":[[\"$\",\"div\",null,{\"className\":\"bg-[#2d2d2d] px-4 py-2 flex items-center justify-between border-b border-stone-800\",\"children\":[\"$\",\"span\",null,{\"className\":\"text-stone-400 text-xs font-mono\",\"children\":\"docs/schema.sql\"}]}],[\"$\",\"div\",null,{\"className\":\"p-4 overflow-y-auto w-full flex-grow custom-scrollbar\",\"children\":[\"$\",\"pre\",null,{\"className\":\"text-xs sm:text-sm font-mono text-stone-300 leading-relaxed whitespace-pre\",\"children\":[\"$\",\"code\",null,{\"children\":\"$a\"}]}]}]]}]\n6:[\"$\",\"$Lb\",null,{\"href\":\"/login\",\"className\":\"absolute top-6 left-6 z-20 flex items-center gap-2 text-stone-500 hover:text-stone-900 font-semibold text-sm transition-all duration-300 bg-white/60 px-5 py-2.5 rounded-full shadow-sm border border-stone-200 hover:border-stone-300 hover:shadow-md\",\"children\":[[\"$\",\"$L2\",null,{\"iconNode\":[[\"path\",{\"d\":\"m12 19-7-7 7-7\",\"key\":\"1l729n\"}],[\"path\",{\"d\":\"M19 12H5\",\"key\":\"x3x0zl\"}]],\"className\":\"lucide-arrow-left size-4\"}],\"Quay lại Đăng nhập\"]}]\n7:[\"$\",\"footer\",null,{\"className\":\"py-8 text-center text-sm text-stone-500 bg-transparent border-none mt-auto relative z-10 backdrop-blur-sm\",\"children\":[\"$\",\"div\",null,{\"className\":\"max-w-7xl mx-auto px-4\",\"children\":[false,[\"$\",\"p\",null,{\"className\":\"flex items-center justify-center gap-2 opacity-80 hover:opacity-100 transition-opacity\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://github.com/homielab/giapha-os\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"font-semibold text-stone-600 hover:text-amber-700 transition-colors inline-flex items-center gap-1.5\",\"children\":[[\"$\",\"svg\",null,{\"viewBox\":\"0 0 24 24\",\"width\":\"16\",\"height\":\"16\",\"stroke\":\"currentColor\",\"strokeWidth\":\"2\",\"fill\":\"none\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"children\":[\"$\",\"path\",null,{\"d\":\"M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22\"}]}],\"Gia Phả OS\"]}],\"by\",[\"$\",\"a\",null,{\"href\":\"https://homielab.com\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"font-semibold text-green-600 hover:text-amber-700 transition-colors inline-flex items-center gap-1.5\",\"children\":\"HomieLab\"}]]}]]}]}]\n8:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/10gp4~2wc-iyp.js\",\"async\":true}]\n9:[\"$\",\"$Lc\",null,{\"children\":[\"$\",\"$d\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@e\"}]}]\ne:null\n","/setup":"1:\"$Sr